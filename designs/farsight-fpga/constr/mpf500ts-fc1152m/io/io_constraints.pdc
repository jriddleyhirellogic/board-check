#-------------------------------------------------------------------------------
# Source utility resources
#-------------------------------------------------------------------------------
set base_dir         [file normalize [file dirname [info script]]]
set pins_file_addr   [file normalize [file join $base_dir "./../../common/pins.tcl"]]
set constr_util_addr [file normalize [file join $base_dir "./../../common/apply_pin_constr.tcl"]]

source $pins_file_addr
source $constr_util_addr

#-------------------------------------------------------------------------------
# IOBANK voltage level settings
#-------------------------------------------------------------------------------
set_iobank -bank_name Bank0 -vcci 1.20 -fixed "false" -auto_calib true -auto_calib_ramp_time 50 -update_iostd false
set_iobank -bank_name Bank1 -vcci 1.80 -fixed "false" -auto_calib true -auto_calib_ramp_time 50 -update_iostd false
set_iobank -bank_name Bank2 -vcci 3.30 -fixed "true"  -auto_calib true -auto_calib_ramp_time 50 -update_iostd false
set_iobank -bank_name Bank3 -vcci 3.30 -fixed "true"
set_iobank -bank_name Bank4 -vcci 3.30 -fixed "true"  -auto_calib true -auto_calib_ramp_time 50 -update_iostd false
set_iobank -bank_name Bank5 -vcci 3.30 -fixed "true"  -auto_calib true -auto_calib_ramp_time 50 -update_iostd false
set_iobank -bank_name Bank6 -vcci 1.20 -fixed "false" -auto_calib true -auto_calib_ramp_time 50 -update_iostd false
set_iobank -bank_name Bank7 -vcci 1.20 -fixed "false" -auto_calib true -auto_calib_ramp_time 50 -update_iostd false

