  49:../src/CameraStates/camera_transfer_state.c **** State_t Camera_Transfer_State( Camera_Context_t *context, Event_t *event )
  50:../src/CameraStates/camera_transfer_state.c **** {
  51:../src/CameraStates/camera_transfer_state.c ****     State_t next_state = (State_t)Camera_Transfer_State;
  52:../src/CameraStates/camera_transfer_state.c ****     Camera_Instance_t *camera_instance = context->instance;
  53:../src/CameraStates/camera_transfer_state.c ****     Error_Code_t err = NO_ERROR;
  54:../src/CameraStates/camera_transfer_state.c ****     uint32_t u32_Mux;
  55:../src/CameraStates/camera_transfer_state.c ****     uint16_t u16_Index;
  56:../src/CameraStates/camera_transfer_state.c ****     Event_t done_event;
  57:../src/CameraStates/camera_transfer_state.c **** 
  58:../src/CameraStates/camera_transfer_state.c ****     switch( event->no_data.sig )
  59:../src/CameraStates/camera_transfer_state.c ****     {
  60:../src/CameraStates/camera_transfer_state.c ****     case ENTRANCE:
  61:../src/CameraStates/camera_transfer_state.c ****         // Reset the UDP DMA control for both buffers
  62:../src/CameraStates/camera_transfer_state.c ****         reset_udp_dmactrl(UDP_DMACTRL_DDR4_8GB_BASE_ADDR);
  63:../src/CameraStates/camera_transfer_state.c ****         reset_udp_dmactrl(UDP_DMACTRL_DDR4_16GB_BASE_ADDR);
  64:../src/CameraStates/camera_transfer_state.c ****         
  65:../src/CameraStates/camera_transfer_state.c ****         context->eState = CAMERA_TRANSFER_STATE;
  66:../src/CameraStates/camera_transfer_state.c ****         u16_Start_Index = u16_Current_Index = event->xfer_frames.u16_index;
  67:../src/CameraStates/camera_transfer_state.c ****         u16_N_Frames = event->xfer_frames.u16_num;
  68:../src/CameraStates/camera_transfer_state.c **** 
  69:../src/CameraStates/camera_transfer_state.c ****         v_Enable_UDP_IRQ(1);
  70:../src/CameraStates/camera_transfer_state.c ****         v_Transfer_Frame(u16_Current_Index );
  71:../src/CameraStates/camera_transfer_state.c ****         v_Start_Camera_Timer( UDP_TRANSFER_TIMEOUT );
  72:../src/CameraStates/camera_transfer_state.c ****         break;
  73:../src/CameraStates/camera_transfer_state.c **** 
  74:../src/CameraStates/camera_transfer_state.c ****     case EXIT:
  75:../src/CameraStates/camera_transfer_state.c ****         v_Stop_Camera_Timer();
  76:../src/CameraStates/camera_transfer_state.c ****         v_Enable_UDP_IRQ(0);
  77:../src/CameraStates/camera_transfer_state.c ****         break;
  78:../src/CameraStates/camera_transfer_state.c **** 
  79:../src/CameraStates/camera_transfer_state.c ****     case UDP_TRANSFER_COMPLETE:
  80:../src/CameraStates/camera_transfer_state.c ****         ++u16_Current_Index;
  81:../src/CameraStates/camera_transfer_state.c ****         vTaskDelay(100);  // @todo this is so the flight computer can keep up. Revisit.
  82:../src/CameraStates/camera_transfer_state.c ****         if(u16_Current_Index < (u16_Start_Index + u16_N_Frames ))
  83:../src/CameraStates/camera_transfer_state.c ****         {
  84:../src/CameraStates/camera_transfer_state.c ****             v_Transfer_Frame(u16_Current_Index );
  85:../src/CameraStates/camera_transfer_state.c ****             v_Start_Camera_Timer( UDP_TRANSFER_TIMEOUT );
  86:../src/CameraStates/camera_transfer_state.c ****         }
  87:../src/CameraStates/camera_transfer_state.c ****         else
  88:../src/CameraStates/camera_transfer_state.c ****             next_state = (State_t)context->saved_state; // return to whence we came
  89:../src/CameraStates/camera_transfer_state.c ****         break;
  90:../src/CameraStates/camera_transfer_state.c **** 
  91:../src/CameraStates/camera_transfer_state.c ****     case CAMERA_TIMER_EXPIRED: // Transfer hung for some reason
  92:../src/CameraStates/camera_transfer_state.c ****         next_state = (State_t)Camera_Fault_State;
  93:../src/CameraStates/camera_transfer_state.c ****         break;
  94:../src/CameraStates/camera_transfer_state.c **** 
  95:../src/CameraStates/camera_transfer_state.c ****     default:
  96:../src/CameraStates/camera_transfer_state.c ****         break;
  97:../src/CameraStates/camera_transfer_state.c ****     }
  98:../src/CameraStates/camera_transfer_state.c **** 
  99:../src/CameraStates/camera_transfer_state.c ****     return next_state;
 100:../src/CameraStates/camera_transfer_state.c **** }
