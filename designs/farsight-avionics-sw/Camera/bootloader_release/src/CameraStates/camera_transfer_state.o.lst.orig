  30:../src/CameraStates/camera_transfer_state.c **** /**
  31:../src/CameraStates/camera_transfer_state.c ****  * @fn State_t Camera_Transfer_State(Camera_Context_t*, Event_t*)
  32:../src/CameraStates/camera_transfer_state.c ****  * @brief For transferring frames through udp
  33:../src/CameraStates/camera_transfer_state.c ****  * This is due to the fact that you can't take pictures and transfer at the same time.
  34:../src/CameraStates/camera_transfer_state.c ****  * @param context Context info for state
  35:../src/CameraStates/camera_transfer_state.c ****  * @param event
  36:../src/CameraStates/camera_transfer_state.c ****  * @return Next state
  37:../src/CameraStates/camera_transfer_state.c ****  */
