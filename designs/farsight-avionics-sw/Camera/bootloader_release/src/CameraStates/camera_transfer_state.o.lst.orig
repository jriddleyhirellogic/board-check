  40:../src/CameraStates/camera_transfer_state.c **** static uint16_t u16_N_Frames;
  41:../src/CameraStates/camera_transfer_state.c **** static uint16_t u16_Current_Index;
  42:../src/CameraStates/camera_transfer_state.c **** static uint8_t  u8_xfer_type;
  43:../src/CameraStates/camera_transfer_state.c **** 
  44:../src/CameraStates/camera_transfer_state.c **** #define UDP_TRANSFER_TIMEOUT 500
  45:../src/CameraStates/camera_transfer_state.c **** 
