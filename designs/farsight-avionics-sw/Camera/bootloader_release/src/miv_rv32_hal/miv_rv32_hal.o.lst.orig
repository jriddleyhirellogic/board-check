  86:../src/miv_rv32_hal/miv_rv32_hal.h **** #define MTIMECMPH                       (*(uint32_t*)0x44004004UL)
  87:../src/miv_rv32_hal/miv_rv32_hal.h **** #define MTIME                           (*(uint32_t*)0x4400BFF8UL)
  88:../src/miv_rv32_hal/miv_rv32_hal.h **** #define MTIMEH                          (*(uint32_t*)0x4400BFFCUL)
