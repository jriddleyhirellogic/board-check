  48:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Return value from External IRQ handler. This will be used to disable the
  49:../src/miv_rv32_hal/miv_rv32_hal.h ****  * External interrupt.
  50:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
  51:../src/miv_rv32_hal/miv_rv32_hal.h **** #define EXT_IRQ_KEEP_ENABLED                0U
  52:../src/miv_rv32_hal/miv_rv32_hal.h **** #define EXT_IRQ_DISABLE                     1U
  53:../src/miv_rv32_hal/miv_rv32_hal.h **** 
  54:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
  55:../src/miv_rv32_hal/miv_rv32_hal.h ****  * System tick handler. This handler function gets called when the Machine
  56:../src/miv_rv32_hal/miv_rv32_hal.h ****  * timer interrupt asserts. An implementation of this function should be
  57:../src/miv_rv32_hal/miv_rv32_hal.h ****  * provided by the application to implement the application specific machine
  58:../src/miv_rv32_hal/miv_rv32_hal.h ****  * timer interrupt handling. If application does not provide such implementation
  59:../src/miv_rv32_hal/miv_rv32_hal.h ****  * the weakly linked handler stub function implemented in riscv_hal_stubs.c gets
  60:../src/miv_rv32_hal/miv_rv32_hal.h ****  * linked.
  61:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
  62:../src/miv_rv32_hal/miv_rv32_hal.h **** void SysTick_Handler(void);
  63:../src/miv_rv32_hal/miv_rv32_hal.h **** 
  64:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
  65:../src/miv_rv32_hal/miv_rv32_hal.h ****  * System timer tick configuration.
  66:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Configures the machine timer to generate a system tick interrupt at regular
  67:../src/miv_rv32_hal/miv_rv32_hal.h ****  * intervals.
  68:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Takes the number of system clock ticks between interrupts.
  69:../src/miv_rv32_hal/miv_rv32_hal.h ****  *
  70:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Though this function can take any valid ticks value as parameter, we expect
  71:../src/miv_rv32_hal/miv_rv32_hal.h ****  * that, for all practical purposes, a small tick value (to generate periodic 
  72:../src/miv_rv32_hal/miv_rv32_hal.h ****  * interrupts every few miliseconds) will be passed. If you need to generate
  73:../src/miv_rv32_hal/miv_rv32_hal.h ****  * periodic events in the range of seconds or more, you may use the SysTick_Handler()
  74:../src/miv_rv32_hal/miv_rv32_hal.h ****  * to further count the number of interrupts and hence the larger time intervals.
  75:../src/miv_rv32_hal/miv_rv32_hal.h ****  *
  76:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Returns 0 if successful.
  77:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Returns 1 if the interrupt interval cannot be achieved.
  78:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
  79:../src/miv_rv32_hal/miv_rv32_hal.h **** uint32_t MRV_systick_config(uint64_t ticks);
  80:../src/miv_rv32_hal/miv_rv32_hal.h **** 
  81:../src/miv_rv32_hal/miv_rv32_hal.h **** #define MTIME_DELTA                     5
