  92:../src/miv_rv32_hal/miv_rv32_hal.h **** 
  93:../src/miv_rv32_hal/miv_rv32_hal.h **** #else
  94:../src/miv_rv32_hal/miv_rv32_hal.h **** 
  95:../src/miv_rv32_hal/miv_rv32_hal.h **** /* To maintain backward compatibility with FreeRTOS config code */
  96:../src/miv_rv32_hal/miv_rv32_hal.h **** #define PRCI_BASE                       0x02000000UL
