 207:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 208:../src/miv_rv32_hal/miv_rv32_hal.h ****     Enable OPSRV interrupt. Parameter takes logical OR of following values
 209:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_TCM_ECC_CE_IRQ                    0x01u
 210:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_TCM_ECC_UCE_IRQ                   0x02u
 211:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_AXI_WR_RESP_IRQ                   0x10u
 212:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 213:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_opsrv_enable_irq(uint32_t irq_mask)
 214:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 215:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->irq_en = irq_mask;
 216:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 217:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 218:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 219:../src/miv_rv32_hal/miv_rv32_hal.h ****     Disable OPSRV interrupt. Parameter takes logical OR of following values
 220:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_TCM_ECC_CE_IRQ                    0x01u
 221:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_TCM_ECC_UCE_IRQ                   0x02u
 222:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_AXI_WR_RESP_IRQ                   0x10u
 223:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 224:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_opsrv_disable_irq(uint32_t irq_mask)
 225:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 226:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->irq_en &= ~irq_mask;
 227:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 228:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 229:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 230:../src/miv_rv32_hal/miv_rv32_hal.h ****     Clear OPSRV interrupt. Parameter takes logical OR of following values
 231:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_TCM_ECC_CE_IRQ                    0x01u
 232:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_TCM_ECC_UCE_IRQ                   0x02u
 233:../src/miv_rv32_hal/miv_rv32_hal.h ****     #define OPSRV_AXI_WR_RESP_IRQ                   0x10u
 234:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 235:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_opsrv_clear_irq(uint32_t irq_mask)
 236:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 237:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->irq_pend |= irq_mask;
 238:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 239:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 240:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 241:../src/miv_rv32_hal/miv_rv32_hal.h ****  * The function MRV32_is_gpr_ded() returns the core_gpr_ded_reset_reg bit value.
 242:../src/miv_rv32_hal/miv_rv32_hal.h ****  * When ECC is enabled, the core_gpr_ded_reset_reg is set when the core was
 243:../src/miv_rv32_hal/miv_rv32_hal.h ****  * reset due to GPR DED error.
 244:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 245:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline uint32_t MRV32_is_gpr_ded(void)
 246:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 247:../src/miv_rv32_hal/miv_rv32_hal.h ****     return((OPSRV->soft_reg & 0x04u) >> 0x02u);
 248:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 249:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 250:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 251:../src/miv_rv32_hal/miv_rv32_hal.h ****  * The function MRV32_clear_gpr_ded() can be used to clear the
 252:../src/miv_rv32_hal/miv_rv32_hal.h ****  * core_gpr_ded_reset_reg bit. When ECC is enabled, the core_gpr_ded_reset_reg
 253:../src/miv_rv32_hal/miv_rv32_hal.h ****  * is set when the core was previously reset due to GPR DED error.
 254:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 255:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_clear_gpr_ded(void)
 256:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 257:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->soft_reg &= ~0x04u;
 258:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 259:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 260:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 261:../src/miv_rv32_hal/miv_rv32_hal.h ****   When ECC is enabled for the GPRs and if that data has a single bit error then
 262:../src/miv_rv32_hal/miv_rv32_hal.h ****   the data coming out of the ECC block will be corrected and will not have the
 263:../src/miv_rv32_hal/miv_rv32_hal.h ****   error but the data source will still have the error.
 264:../src/miv_rv32_hal/miv_rv32_hal.h ****   The ECC block does not write back corrected data to memory.
 265:../src/miv_rv32_hal/miv_rv32_hal.h ****   Therefore, if data has a single bit error, then the corrected data should be 
 266:../src/miv_rv32_hal/miv_rv32_hal.h ****   written back to prevent the single bit error from becoming a double bit error.
 267:../src/miv_rv32_hal/miv_rv32_hal.h ****   The MRV32_clear_gpr_ecc_errors() can be used for that.
 268:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 269:../src/miv_rv32_hal/miv_rv32_hal.h ****   Clear the pending interrupt bit after this using MRV32_mgeci_clear_irq()
 270:../src/miv_rv32_hal/miv_rv32_hal.h ****   function to complete the ECC error handling.
 271:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 272:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_clear_gpr_ecc_errors(void)
 273:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 274:../src/miv_rv32_hal/miv_rv32_hal.h ****     uint32_t temp;
 275:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 276:../src/miv_rv32_hal/miv_rv32_hal.h ****     __asm__ __volatile__ (
 277:../src/miv_rv32_hal/miv_rv32_hal.h ****             "sw x31, %0"
 278:../src/miv_rv32_hal/miv_rv32_hal.h ****             :"=m" (temp));
 279:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 280:../src/miv_rv32_hal/miv_rv32_hal.h ****     __asm__ volatile (
 281:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x1;"
 282:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x1, x31;"
 283:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 284:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x2;"
 285:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x2, x31;"
 286:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 287:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x3;"
 288:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x3, x31;"
 289:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 290:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x4;"
 291:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x4, x31;"
 292:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 293:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x5;"
 294:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x5, x31;"
 295:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 296:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x6;"
 297:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x6, x31;"
 298:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 299:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x7;"
 300:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x7, x31;"
 301:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 302:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x8;"
 303:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x8, x31;"
 304:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 305:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x9;"
 306:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x9, x31;"
 307:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 308:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x31, x10;"
 309:../src/miv_rv32_hal/miv_rv32_hal.h ****             "mv x10, x31;"
 310:../src/miv_rv32_hal/miv_rv32_hal.h **** 
