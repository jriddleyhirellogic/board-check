 377:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 378:../src/miv_rv32_hal/miv_rv32_hal.h ****  * The function MRV32_enable_parity_check() is used to enable parity check on
 379:../src/miv_rv32_hal/miv_rv32_hal.h ****  * the TCM and it's interface transactions. This feature is not available on
 380:../src/miv_rv32_hal/miv_rv32_hal.h ****  * MIV_RV32 v3.0.100 soft processor core.
 381:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 382:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_enable_parity_check(void)
 383:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 384:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->cfg |= 0x01u;
 385:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 386:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 387:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 388:../src/miv_rv32_hal/miv_rv32_hal.h ****  * The function MRV32_disable_parity_check() is used to disable parity check on
 389:../src/miv_rv32_hal/miv_rv32_hal.h ****  * the TCM and it's interface transactions.
 390:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 391:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_disable_parity_check(void)
 392:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 393:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->cfg &= ~0x01u;
 394:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 395:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 396:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 397:../src/miv_rv32_hal/miv_rv32_hal.h ****  * The function MRV32_cpu_soft_reset() is used to cause a soft cpu reset on
 398:../src/miv_rv32_hal/miv_rv32_hal.h ****  * the MIV_RV32 soft processor core.
 399:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 400:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_cpu_soft_reset(void)
 401:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 402:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->soft_reg &= ~0x01u;
 403:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 404:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 405:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 406:../src/miv_rv32_hal/miv_rv32_hal.h ****     Clear GPR ECC Uncorrectable interrupt. MGEUI interrupt is available only when
 407:../src/miv_rv32_hal/miv_rv32_hal.h ****     ECC is enabled in MIV_RV32 IP configurator.
 408:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 409:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_mgeui_clear_irq(uint32_t irq_mask)
 410:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 411:../src/miv_rv32_hal/miv_rv32_hal.h ****     clear_csr(mip, MRV32_MGEUIE_IRQn);
 412:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 413:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 414:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 415:../src/miv_rv32_hal/miv_rv32_hal.h ****     Clear GPR ECC correctable interrupt. MGECI interrupt is available only when
 416:../src/miv_rv32_hal/miv_rv32_hal.h ****     ECC is enabled in MIV_RV32 IP configurator.
 417:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 418:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV32_mgeci_clear_irq(uint32_t irq_mask)
 419:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 420:../src/miv_rv32_hal/miv_rv32_hal.h ****     clear_csr(mip, MRV32_MGECIE_IRQn);
 421:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 422:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 423:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 424:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Enable interrupts.
 425:../src/miv_rv32_hal/miv_rv32_hal.h ****  This function takes a mask value as input. For each set bit in the mask value,
 426:../src/miv_rv32_hal/miv_rv32_hal.h ****  corresponding interrupt bit in the MIE register is enabled.
 427:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 428:../src/miv_rv32_hal/miv_rv32_hal.h ****  MRV_enable_local_irq(MRV32_SOFT_IRQn  |
 429:../src/miv_rv32_hal/miv_rv32_hal.h ****                       MRV32_TIMER_IRQn |
 430:../src/miv_rv32_hal/miv_rv32_hal.h ****                       MRV32_EXT_IRQn   |
 431:../src/miv_rv32_hal/miv_rv32_hal.h ****                       MRV32_MSYS_EIE0_IRQn |
 432:../src/miv_rv32_hal/miv_rv32_hal.h ****                       MRV32_MSYS_OPSRV_IRQn);
 433:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 434:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV_enable_local_irq(uint32_t mask)
 435:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 436:../src/miv_rv32_hal/miv_rv32_hal.h ****     set_csr(mie, mask);
 437:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 438:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 439:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 440:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Disable interrupts.
 441:../src/miv_rv32_hal/miv_rv32_hal.h ****  This function takes a mask value as input. For each set bit in the mask value,
 442:../src/miv_rv32_hal/miv_rv32_hal.h ****  corresponding interrupt bit in the MIE register is disabled.
 443:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 444:../src/miv_rv32_hal/miv_rv32_hal.h ****   MRV_disable_local_irq(MRV32_SOFT_IRQn  |
 445:../src/miv_rv32_hal/miv_rv32_hal.h ****                         MRV32_TIMER_IRQn |
 446:../src/miv_rv32_hal/miv_rv32_hal.h ****                         MRV32_EXT_IRQn   |
 447:../src/miv_rv32_hal/miv_rv32_hal.h ****                         MRV32_MSYS_EIE0_IRQn |
 448:../src/miv_rv32_hal/miv_rv32_hal.h ****                         MRV32_MSYS_OPSRV_IRQn);
 449:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 450:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV_disable_local_irq(uint32_t mask)
 451:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 452:../src/miv_rv32_hal/miv_rv32_hal.h ****     clear_csr(mie, mask);
 453:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 454:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 455:../src/miv_rv32_hal/miv_rv32_hal.h **** #endif /* MIV_LEGACY_RV32 */
 456:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 457:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 458:../src/miv_rv32_hal/miv_rv32_hal.h ****  * The function MRV_raise_soft_irq() raises a synchronous software interrupt
 459:../src/miv_rv32_hal/miv_rv32_hal.h ****  * by writing into the MSIP register.
 460:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 461:../src/miv_rv32_hal/miv_rv32_hal.h **** static inline void MRV_raise_soft_irq(void)
 462:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 463:../src/miv_rv32_hal/miv_rv32_hal.h ****     set_csr(mie, MIP_MSIP);       /* Enable software interrupt bit */
 464:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 465:../src/miv_rv32_hal/miv_rv32_hal.h **** #ifdef MIV_LEGACY_RV32
 466:../src/miv_rv32_hal/miv_rv32_hal.h ****     /* You need to make sure that the global interrupt is enabled */
 467:../src/miv_rv32_hal/miv_rv32_hal.h ****     MSIP = 0x01;   /* raise soft interrupt */
 468:../src/miv_rv32_hal/miv_rv32_hal.h **** #else
 469:../src/miv_rv32_hal/miv_rv32_hal.h ****     /* Raise soft IRQ on MIV_RV32 processor */
 470:../src/miv_rv32_hal/miv_rv32_hal.h ****     OPSRV->soft_reg |= (1u << 1u);
 471:../src/miv_rv32_hal/miv_rv32_hal.h **** #endif
 472:../src/miv_rv32_hal/miv_rv32_hal.h **** }
 473:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 474:../src/miv_rv32_hal/miv_rv32_hal.h **** /***************************************************************************//**
 475:../src/miv_rv32_hal/miv_rv32_hal.h ****  * The function MRV_clear_soft_irq() clears a synchronous software interrupt
 476:../src/miv_rv32_hal/miv_rv32_hal.h ****  * by clearing the MSIP register.
