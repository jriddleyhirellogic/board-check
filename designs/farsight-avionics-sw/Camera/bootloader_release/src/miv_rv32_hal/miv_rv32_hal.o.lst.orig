 327:../src/miv_rv32_hal/miv_rv32_hal.c ****          6 Store/AMO address fault        (mtval/mtval is the address)
 328:../src/miv_rv32_hal/miv_rv32_hal.c ****          7 Store/AMO access fault         (mtval/mtval is the address)
 329:../src/miv_rv32_hal/miv_rv32_hal.c ****          8 Environment call from U-mode
 330:../src/miv_rv32_hal/miv_rv32_hal.c ****          9 Environment call from S-mode
 331:../src/miv_rv32_hal/miv_rv32_hal.c ****          A Environment call from M-mode
 332:../src/miv_rv32_hal/miv_rv32_hal.c ****          B Instruction page fault
 333:../src/miv_rv32_hal/miv_rv32_hal.c ****          C Load page fault                (mtval/mtval is the address)
 334:../src/miv_rv32_hal/miv_rv32_hal.c ****          E Store page fault               (mtval/mtval is the address)
 335:../src/miv_rv32_hal/miv_rv32_hal.c **** 
