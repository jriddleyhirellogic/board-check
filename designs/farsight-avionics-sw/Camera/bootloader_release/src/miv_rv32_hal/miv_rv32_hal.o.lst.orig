 148:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Apart from the standard software, timer and external interrupts, the names
 149:../src/miv_rv32_hal/miv_rv32_hal.h ****  * of the additional interrupts correspond to the names as used in the MIV_RV32
 150:../src/miv_rv32_hal/miv_rv32_hal.h ****  * handbook. Please refer the MIV_RV32 handbook for more details.
 151:../src/miv_rv32_hal/miv_rv32_hal.h ****  * */
 152:../src/miv_rv32_hal/miv_rv32_hal.h **** #define MRV32_SOFT_IRQn                 MIE_3_IRQn
 153:../src/miv_rv32_hal/miv_rv32_hal.h **** #define MRV32_TIMER_IRQn                MIE_7_IRQn
 154:../src/miv_rv32_hal/miv_rv32_hal.h **** #define MRV32_EXT_IRQn                  MIE_11_IRQn
 155:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 156:../src/miv_rv32_hal/miv_rv32_hal.h **** /*==============================================================================
 157:../src/miv_rv32_hal/miv_rv32_hal.h ****  * Interrupt numbers:
 158:../src/miv_rv32_hal/miv_rv32_hal.h ****  * This enum represents the interrupt enable bits in the MIE register.
 159:../src/miv_rv32_hal/miv_rv32_hal.h ****  */
 160:../src/miv_rv32_hal/miv_rv32_hal.h **** enum
 161:../src/miv_rv32_hal/miv_rv32_hal.h **** {
 162:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_0_IRQn  =  (0x01u),
 163:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_1_IRQn  =  (0x01u<<1u),
 164:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_2_IRQn  =  (0x01u<<2u),
 165:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_3_IRQn  =  (0x01u<<3u),         /*MSIE*/
 166:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_4_IRQn  =  (0x01u<<4u),
 167:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_5_IRQn  =  (0x01u<<5u),
 168:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_6_IRQn  =  (0x01u<<6u),
 169:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_7_IRQn  =  (0x01u<<7u),         /*MTIE*/
 170:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_8_IRQn  =  (0x01u<<8u),
 171:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_9_IRQn  =  (0x01u<<9u),
 172:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_10_IRQn =  (0x01u<<10u),
 173:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_11_IRQn =  (0x01u<<11u),        /*MEIE*/
 174:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_12_IRQn =  (0x01u<<12u),
 175:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_13_IRQn =  (0x01u<<13u),
 176:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_14_IRQn =  (0x01u<<14u),
 177:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_15_IRQn =  (0x01u<<15u),
 178:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_16_IRQn =  (0x01u<<16u),        /*MGEUIE*/
 179:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_17_IRQn =  (0x01u<<17u),        /*MGECIE*/
 180:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_18_IRQn =  (0x01u<<18u),
 181:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_19_IRQn =  (0x01u<<19u),
 182:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_20_IRQn =  (0x01u<<20u),
 183:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_21_IRQn =  (0x01u<<21u),
 184:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_22_IRQn =  (0x01u<<22u),
 185:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_23_IRQn =  (0x01u<<23u),
 186:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_24_IRQn =  (0x01u<<24u),        /*MSYS_EIE0*/
 187:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_25_IRQn =  (0x01u<<25u),        /*MSYS_EIE1*/
 188:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_26_IRQn =  (0x01u<<26u),        /*MSYS_EIE2*/
 189:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_27_IRQn =  (0x01u<<27u),        /*MSYS_EIE3*/
 190:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_28_IRQn =  (0x01u<<28u),        /*MSYS_EIE4*/
 191:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_29_IRQn =  (0x01u<<29u),        /*MSYS_EIE5*/
 192:../src/miv_rv32_hal/miv_rv32_hal.h ****     MIE_30_IRQn =  (0x01u<<30u)         /*OPSRV_IRQ_IE*/
 193:../src/miv_rv32_hal/miv_rv32_hal.h **** 
 194:../src/miv_rv32_hal/miv_rv32_hal.h **** } MRV_LOCAL_IRQn_Type;
