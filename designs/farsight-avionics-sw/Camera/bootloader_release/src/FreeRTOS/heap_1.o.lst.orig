  48:../src/FreeRTOS/heap_1.c **** 
  49:../src/FreeRTOS/heap_1.c **** #if ( configSUPPORT_MotionAMIC_ALLOCATION == 0 )
  50:../src/FreeRTOS/heap_1.c ****     #error This file must not be used if configSUPPORT_MotionAMIC_ALLOCATION is 0
  51:../src/FreeRTOS/heap_1.c **** #endif
  52:../src/FreeRTOS/heap_1.c **** 
  53:../src/FreeRTOS/heap_1.c **** /* A few bytes might be lost to byte aligning the heap start address. */
  54:../src/FreeRTOS/heap_1.c **** #define configADJUSTED_HEAP_SIZE        ( configTOTAL_HEAP_SIZE - portBYTE_ALIGNMENT )
  55:../src/FreeRTOS/heap_1.c **** 
  56:../src/FreeRTOS/heap_1.c **** /* Max value that fits in a size_t type. */
  57:../src/FreeRTOS/heap_1.c **** #define heapSIZE_MAX                    ( ~( ( size_t ) 0 ) )
  58:../src/FreeRTOS/heap_1.c **** 
  59:../src/FreeRTOS/heap_1.c **** /* Check if adding a and b will result in overflow. */
  60:../src/FreeRTOS/heap_1.c **** #define heapADD_WILL_OVERFLOW( a, b )   ( ( a ) > ( heapSIZE_MAX - ( b ) ) )
  61:../src/FreeRTOS/heap_1.c **** 
