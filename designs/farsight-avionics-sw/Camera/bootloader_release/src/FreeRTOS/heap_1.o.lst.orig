  30:../src/FreeRTOS/heap_1.c **** /*
  31:../src/FreeRTOS/heap_1.c ****  * The simplest possible implementation of pvPortMalloc().  Note that this
  32:../src/FreeRTOS/heap_1.c ****  * implementation does NOT allow allocated memory to be freed again.
  33:../src/FreeRTOS/heap_1.c ****  *
  34:../src/FreeRTOS/heap_1.c ****  * See heap_2.c, heap_3.c and heap_4.c for alternative implementations, and the
  35:../src/FreeRTOS/heap_1.c ****  * memory management pages of https://www.FreeRTOS.org for more information.
  36:../src/FreeRTOS/heap_1.c ****  */
  37:../src/FreeRTOS/heap_1.c **** #include <stdlib.h>
  38:../src/FreeRTOS/heap_1.c **** 
  39:../src/FreeRTOS/heap_1.c **** /* Defining MPU_WRAPPERS_INCLUDED_FROM_API_FILE prevents task.h from redefining
  40:../src/FreeRTOS/heap_1.c ****  * all the API functions to use the MPU wrappers.  That should only be done when
  41:../src/FreeRTOS/heap_1.c ****  * task.h is included from an application file. */
  42:../src/FreeRTOS/heap_1.c **** #define MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  43:../src/FreeRTOS/heap_1.c **** 
  44:../src/FreeRTOS/heap_1.c **** #include "FreeRTOS.h"
  45:../src/FreeRTOS/heap_1.c **** #include "task.h"
  46:../src/FreeRTOS/heap_1.c **** 
