 254:../src/FreeRTOS/queue.c **** /*
 255:../src/FreeRTOS/queue.c ****  * Macro to mark a queue as locked.  Locking a queue prevents an ISR from
 256:../src/FreeRTOS/queue.c ****  * accessing the queue event lists.
 257:../src/FreeRTOS/queue.c ****  */
 258:../src/FreeRTOS/queue.c **** #define prvLockQueue( pxQueue )                            \
 259:../src/FreeRTOS/queue.c ****     taskENTER_CRITICAL();                                  \
 260:../src/FreeRTOS/queue.c ****     {                                                      \
 261:../src/FreeRTOS/queue.c ****         if( ( pxQueue )->cRxLock == queueUNLOCKED )        \
 262:../src/FreeRTOS/queue.c ****         {                                                  \
 263:../src/FreeRTOS/queue.c ****             ( pxQueue )->cRxLock = queueLOCKED_UNMODIFIED; \
 264:../src/FreeRTOS/queue.c ****         }                                                  \
 265:../src/FreeRTOS/queue.c ****         if( ( pxQueue )->cTxLock == queueUNLOCKED )        \
 266:../src/FreeRTOS/queue.c ****         {                                                  \
 267:../src/FreeRTOS/queue.c ****             ( pxQueue )->cTxLock = queueLOCKED_UNMODIFIED; \
 268:../src/FreeRTOS/queue.c ****         }                                                  \
 269:../src/FreeRTOS/queue.c ****     }                                                      \
 270:../src/FreeRTOS/queue.c ****     taskEXIT_CRITICAL()
 271:../src/FreeRTOS/queue.c **** 
 272:../src/FreeRTOS/queue.c **** /*
 273:../src/FreeRTOS/queue.c ****  * Macro to increment cTxLock member of the queue data structure. It is
 274:../src/FreeRTOS/queue.c ****  * capped at the number of tasks in the system as we cannot unblock more
 275:../src/FreeRTOS/queue.c ****  * tasks than the number of tasks in the system.
 276:../src/FreeRTOS/queue.c ****  */
 277:../src/FreeRTOS/queue.c **** #define prvIncrementQueueTxLock( pxQueue, cTxLock )                           \
 278:../src/FreeRTOS/queue.c ****     do {                                                                      \
 279:../src/FreeRTOS/queue.c ****         const UBaseType_t uxNumberOfTasks = uxTaskGetNumberOfTasks();         \
 280:../src/FreeRTOS/queue.c ****         if( ( UBaseType_t ) ( cTxLock ) < uxNumberOfTasks )                   \
 281:../src/FreeRTOS/queue.c ****         {                                                                     \
 282:../src/FreeRTOS/queue.c ****             configASSERT( ( cTxLock ) != queueINT8_MAX );                     \
 283:../src/FreeRTOS/queue.c ****             ( pxQueue )->cTxLock = ( int8_t ) ( ( cTxLock ) + ( int8_t ) 1 ); \
 284:../src/FreeRTOS/queue.c ****         }                                                                     \
 285:../src/FreeRTOS/queue.c ****     } while( 0 )
 286:../src/FreeRTOS/queue.c **** 
 287:../src/FreeRTOS/queue.c **** /*
 288:../src/FreeRTOS/queue.c ****  * Macro to increment cRxLock member of the queue data structure. It is
 289:../src/FreeRTOS/queue.c ****  * capped at the number of tasks in the system as we cannot unblock more
