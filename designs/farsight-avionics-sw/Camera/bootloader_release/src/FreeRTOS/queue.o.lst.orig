 175:../src/FreeRTOS/queue.c **** /*
 176:../src/FreeRTOS/queue.c ****  * Unlocks a queue locked by a call to prvLockQueue.  Locking a queue does not
 177:../src/FreeRTOS/queue.c ****  * prevent an ISR from adding or removing items to the queue, but does prevent
 178:../src/FreeRTOS/queue.c ****  * an ISR from removing tasks from the queue event lists.  If an ISR finds a
 179:../src/FreeRTOS/queue.c ****  * queue is locked it will instead increment the appropriate queue lock count
 180:../src/FreeRTOS/queue.c ****  * to indicate that a task may require unblocking.  When the queue in unlocked
 181:../src/FreeRTOS/queue.c ****  * these lock counts are inspected, and the appropriate action taken.
 182:../src/FreeRTOS/queue.c ****  */
 183:../src/FreeRTOS/queue.c **** static void prvUnlockQueue( Queue_t * const pxQueue ) PRIVILEGED_FUNCTION;
 184:../src/FreeRTOS/queue.c **** 
