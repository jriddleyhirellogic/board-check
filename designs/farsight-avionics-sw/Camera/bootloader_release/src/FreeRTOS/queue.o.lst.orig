 759:../src/FreeRTOS/queue.c ****     BaseType_t xQueueGiveMutexRecursive( QueueHandle_t xMutex )
 760:../src/FreeRTOS/queue.c ****     {
 761:../src/FreeRTOS/queue.c ****         BaseType_t xReturn;
 762:../src/FreeRTOS/queue.c ****         Queue_t * const pxMutex = ( Queue_t * ) xMutex;
 763:../src/FreeRTOS/queue.c **** 
 764:../src/FreeRTOS/queue.c ****         traceENTER_xQueueGiveMutexRecursive( xMutex );
 765:../src/FreeRTOS/queue.c **** 
 766:../src/FreeRTOS/queue.c ****         configASSERT( pxMutex );
 767:../src/FreeRTOS/queue.c **** 
 768:../src/FreeRTOS/queue.c ****         /* If this is the task that holds the mutex then xMutexHolder will not
 769:../src/FreeRTOS/queue.c ****          * change outside of this task.  If this task does not hold the mutex then
 770:../src/FreeRTOS/queue.c ****          * pxMutexHolder can never coincidentally equal the tasks handle, and as
 771:../src/FreeRTOS/queue.c ****          * this is the only condition we are interested in it does not matter if
 772:../src/FreeRTOS/queue.c ****          * pxMutexHolder is accessed simultaneously by another task.  Therefore no
 773:../src/FreeRTOS/queue.c ****          * mutual exclusion is required to test the pxMutexHolder variable. */
 774:../src/FreeRTOS/queue.c ****         if( pxMutex->u.xSemaphore.xMutexHolder == xTaskGetCurrentTaskHandle() )
 775:../src/FreeRTOS/queue.c ****         {
 776:../src/FreeRTOS/queue.c ****             traceGIVE_MUTEX_RECURSIVE( pxMutex );
 777:../src/FreeRTOS/queue.c **** 
 778:../src/FreeRTOS/queue.c ****             /* uxRecursiveCallCount cannot be zero if xMutexHolder is equal to
 779:../src/FreeRTOS/queue.c ****              * the task handle, therefore no underflow check is required.  Also,
