 292:../src/FreeRTOS/queue.c **** #define prvIncrementQueueRxLock( pxQueue, cRxLock )                           \
 293:../src/FreeRTOS/queue.c ****     do {                                                                      \
 294:../src/FreeRTOS/queue.c ****         const UBaseType_t uxNumberOfTasks = uxTaskGetNumberOfTasks();         \
 295:../src/FreeRTOS/queue.c ****         if( ( UBaseType_t ) ( cRxLock ) < uxNumberOfTasks )                   \
 296:../src/FreeRTOS/queue.c ****         {                                                                     \
 297:../src/FreeRTOS/queue.c ****             configASSERT( ( cRxLock ) != queueINT8_MAX );                     \
