 828:../src/FreeRTOS/queue.c ****         /* Comments regarding mutual exclusion as per those within
 829:../src/FreeRTOS/queue.c ****          * xQueueGiveMutexRecursive(). */
 830:../src/FreeRTOS/queue.c **** 
 831:../src/FreeRTOS/queue.c ****         traceTAKE_MUTEX_RECURSIVE( pxMutex );
 832:../src/FreeRTOS/queue.c **** 
 833:../src/FreeRTOS/queue.c ****         if( pxMutex->u.xSemaphore.xMutexHolder == xTaskGetCurrentTaskHandle() )
 834:../src/FreeRTOS/queue.c ****         {
 835:../src/FreeRTOS/queue.c ****             ( pxMutex->u.xSemaphore.uxRecursiveCallCount )++;
 836:../src/FreeRTOS/queue.c ****             xReturn = pdPASS;
 837:../src/FreeRTOS/queue.c ****         }
