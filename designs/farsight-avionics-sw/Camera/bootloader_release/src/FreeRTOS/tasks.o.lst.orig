3334:../src/FreeRTOS/tasks.c ****                     {
3335:../src/FreeRTOS/tasks.c ****                         BaseType_t x;
3336:../src/FreeRTOS/tasks.c **** 
3337:../src/FreeRTOS/tasks.c ****                         /* The task does not appear on the event list item of
3338:../src/FreeRTOS/tasks.c ****                          * and of the RTOS objects, but could still be in the
3339:../src/FreeRTOS/tasks.c ****                          * blocked state if it is waiting on its notification
3340:../src/FreeRTOS/tasks.c ****                          * rather than waiting on an object.  If not, is
3341:../src/FreeRTOS/tasks.c ****                          * suspended. */
