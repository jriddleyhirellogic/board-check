5332:../src/FreeRTOS/tasks.c **** 
5333:../src/FreeRTOS/tasks.c ****     /* THIS FUNCTION MUST BE CALLED WITH THE SCHEDULER SUSPENDED.  It is used by
5334:../src/FreeRTOS/tasks.c ****      * the event groups implementation. */
5335:../src/FreeRTOS/tasks.c ****     configASSERT( uxSchedulerSuspended != ( UBaseType_t ) 0U );
5336:../src/FreeRTOS/tasks.c **** 
5337:../src/FreeRTOS/tasks.c ****     /* Store the item value in the event list item.  It is safe to access the
5338:../src/FreeRTOS/tasks.c ****      * event list item here as interrupts won't access the event list item of a
5339:../src/FreeRTOS/tasks.c ****      * task that is not in the Blocked state. */
5340:../src/FreeRTOS/tasks.c ****     listSET_LIST_ITEM_VALUE( &( pxCurrentTCB->xEventListItem ), xItemValue | taskEVENT_LIST_ITEM_VA
5341:../src/FreeRTOS/tasks.c **** 
5342:../src/FreeRTOS/tasks.c ****     /* Place the event list item of the TCB at the end of the appropriate event
5343:../src/FreeRTOS/tasks.c ****      * list.  It is safe to access the event list here because it is part of an
5344:../src/FreeRTOS/tasks.c ****      * event group implementation - and interrupts don't access event groups
5345:../src/FreeRTOS/tasks.c ****      * directly (instead they access them indirectly by pending function calls to
5346:../src/FreeRTOS/tasks.c ****      * the task level). */
