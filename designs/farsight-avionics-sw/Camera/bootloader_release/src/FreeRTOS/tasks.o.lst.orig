6114:../src/FreeRTOS/tasks.c ****                 {
6115:../src/FreeRTOS/tasks.c ****                     {
6116:../src/FreeRTOS/tasks.c ****                         /* MISRA Ref 11.5.3 [Void pointer assignment] */
6117:../src/FreeRTOS/tasks.c ****                         /* More details at: https://github.com/FreeRTOS/FreeRTOS-Kernel/blob/main/M
6118:../src/FreeRTOS/tasks.c ****                         /* coverity[misra_c_2012_rule_11_5_violation] */
6119:../src/FreeRTOS/tasks.c ****                         pxTCB = listGET_OWNER_OF_HEAD_ENTRY( ( &xTasksWaitingTermination ) );
6120:../src/FreeRTOS/tasks.c ****                         ( void ) uxListRemove( &( pxTCB->xStateListItem ) );
6121:../src/FreeRTOS/tasks.c ****                         --uxCurrentNumberOfTasks;
6122:../src/FreeRTOS/tasks.c ****                         --uxDeletedTasksWaitingCleanUp;
6123:../src/FreeRTOS/tasks.c ****                     }
6124:../src/FreeRTOS/tasks.c ****                 }
6125:../src/FreeRTOS/tasks.c ****                 taskEXIT_CRITICAL();
6126:../src/FreeRTOS/tasks.c **** 
6127:../src/FreeRTOS/tasks.c ****                 prvDeleteTCB( pxTCB );
6128:../src/FreeRTOS/tasks.c ****             }
6129:../src/FreeRTOS/tasks.c ****             #else /* #if( configNUMBER_OF_CORES == 1 ) */
6130:../src/FreeRTOS/tasks.c ****             {
6131:../src/FreeRTOS/tasks.c ****                 pxTCB = NULL;
6132:../src/FreeRTOS/tasks.c **** 
6133:../src/FreeRTOS/tasks.c ****                 taskENTER_CRITICAL();
6134:../src/FreeRTOS/tasks.c ****                 {
6135:../src/FreeRTOS/tasks.c ****                     /* For SMP, multiple idles can be running simultaneously
6136:../src/FreeRTOS/tasks.c ****                      * and we need to check that other idles did not cleanup while we were
6137:../src/FreeRTOS/tasks.c ****                      * waiting to enter the critical section. */
6138:../src/FreeRTOS/tasks.c ****                     if( uxDeletedTasksWaitingCleanUp > ( UBaseType_t ) 0U )
6139:../src/FreeRTOS/tasks.c ****                     {
6140:../src/FreeRTOS/tasks.c ****                         /* MISRA Ref 11.5.3 [Void pointer assignment] */
6141:../src/FreeRTOS/tasks.c ****                         /* More details at: https://github.com/FreeRTOS/FreeRTOS-Kernel/blob/main/M
6142:../src/FreeRTOS/tasks.c ****                         /* coverity[misra_c_2012_rule_11_5_violation] */
6143:../src/FreeRTOS/tasks.c ****                         pxTCB = listGET_OWNER_OF_HEAD_ENTRY( ( &xTasksWaitingTermination ) );
6144:../src/FreeRTOS/tasks.c **** 
6145:../src/FreeRTOS/tasks.c ****                         if( pxTCB->xTaskRunState == taskTASK_NOT_RUNNING )
6146:../src/FreeRTOS/tasks.c ****                         {
6147:../src/FreeRTOS/tasks.c ****                             ( void ) uxListRemove( &( pxTCB->xStateListItem ) );
6148:../src/FreeRTOS/tasks.c ****                             --uxCurrentNumberOfTasks;
6149:../src/FreeRTOS/tasks.c ****                             --uxDeletedTasksWaitingCleanUp;
6150:../src/FreeRTOS/tasks.c ****                         }
6151:../src/FreeRTOS/tasks.c ****                         else
6152:../src/FreeRTOS/tasks.c ****                         {
6153:../src/FreeRTOS/tasks.c ****                             /* The TCB to be deleted still has not yet been switched out
6154:../src/FreeRTOS/tasks.c ****                              * by the scheduler, so we will just exit this loop early and
6155:../src/FreeRTOS/tasks.c ****                              * try again next time. */
6156:../src/FreeRTOS/tasks.c ****                             taskEXIT_CRITICAL();
6157:../src/FreeRTOS/tasks.c ****                             break;
6158:../src/FreeRTOS/tasks.c ****                         }
6159:../src/FreeRTOS/tasks.c ****                     }
6160:../src/FreeRTOS/tasks.c ****                 }
6161:../src/FreeRTOS/tasks.c ****                 taskEXIT_CRITICAL();
6162:../src/FreeRTOS/tasks.c **** 
6163:../src/FreeRTOS/tasks.c ****                 if( pxTCB != NULL )
6164:../src/FreeRTOS/tasks.c ****                 {
6165:../src/FreeRTOS/tasks.c ****                     prvDeleteTCB( pxTCB );
6166:../src/FreeRTOS/tasks.c ****                 }
6167:../src/FreeRTOS/tasks.c ****             }
6168:../src/FreeRTOS/tasks.c ****             #endif /* #if( configNUMBER_OF_CORES == 1 ) */
