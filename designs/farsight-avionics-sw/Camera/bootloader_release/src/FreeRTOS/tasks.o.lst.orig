3343:../src/FreeRTOS/tasks.c **** 
3344:../src/FreeRTOS/tasks.c ****                         for( x = ( BaseType_t ) 0; x < ( BaseType_t ) configTASK_NOTIFICATION_ARRAY
3345:../src/FreeRTOS/tasks.c ****                         {
3346:../src/FreeRTOS/tasks.c ****                             if( pxTCB->ucNotifyState[ x ] == taskWAITING_NOTIFICATION )
3347:../src/FreeRTOS/tasks.c ****                             {
