3330:../src/FreeRTOS/tasks.c ****                  * state, or because it is blocked with no timeout? */
3331:../src/FreeRTOS/tasks.c ****                 if( listIS_CONTAINED_WITHIN( NULL, &( pxTCB->xEventListItem ) ) != pdFALSE )
3332:../src/FreeRTOS/tasks.c ****                 {
