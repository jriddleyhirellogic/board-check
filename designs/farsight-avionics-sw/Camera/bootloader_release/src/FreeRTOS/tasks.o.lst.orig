5628:../src/FreeRTOS/tasks.c ****              * vTaskSetTimeout() was called, but has also overflowed since
5629:../src/FreeRTOS/tasks.c ****              * vTaskSetTimeOut() was called.  It must have wrapped all the way
5630:../src/FreeRTOS/tasks.c ****              * around and gone past again. This passed since vTaskSetTimeout()
5631:../src/FreeRTOS/tasks.c ****              * was called. */
5632:../src/FreeRTOS/tasks.c ****             xReturn = pdTRUE;
5633:../src/FreeRTOS/tasks.c ****             *pxTicksToWait = ( TickType_t ) 0;
5634:../src/FreeRTOS/tasks.c ****         }
5635:../src/FreeRTOS/tasks.c ****         else if( xElapsedTime < *pxTicksToWait )
5636:../src/FreeRTOS/tasks.c ****         {
