3755:../src/FreeRTOS/tasks.c **** 
3756:../src/FreeRTOS/tasks.c ****         traceTASK_SWITCHED_IN();
3757:../src/FreeRTOS/tasks.c **** 
3758:../src/FreeRTOS/tasks.c ****         traceSTARTING_SCHEDULER( xIdleTaskHandles );
3759:../src/FreeRTOS/tasks.c **** 
3760:../src/FreeRTOS/tasks.c ****         /* Setting up the timer tick is hardware specific and thus in the
3761:../src/FreeRTOS/tasks.c ****          * portable interface. */
3762:../src/FreeRTOS/tasks.c **** 
3763:../src/FreeRTOS/tasks.c ****         /* The return value for xPortStartScheduler is not required
3764:../src/FreeRTOS/tasks.c ****          * hence using a void datatype. */
3765:../src/FreeRTOS/tasks.c ****         ( void ) xPortStartScheduler();
3766:../src/FreeRTOS/tasks.c **** 
3767:../src/FreeRTOS/tasks.c ****         /* In most cases, xPortStartScheduler() will not return. If it
3768:../src/FreeRTOS/tasks.c ****          * returns pdTRUE then there was not enough heap memory available
3769:../src/FreeRTOS/tasks.c ****          * to create either the Idle or the Timer task. If it returned
3770:../src/FreeRTOS/tasks.c ****          * pdFALSE, then the application called xTaskEndScheduler().
3771:../src/FreeRTOS/tasks.c ****          * Most ports don't implement xTaskEndScheduler() as there is
3772:../src/FreeRTOS/tasks.c ****          * nothing to return to. */
3773:../src/FreeRTOS/tasks.c ****     }
3774:../src/FreeRTOS/tasks.c ****     else
3775:../src/FreeRTOS/tasks.c ****     {
3776:../src/FreeRTOS/tasks.c ****         /* This line will only be reached if the kernel could not be started,
3777:../src/FreeRTOS/tasks.c ****          * because there was not enough FreeRTOS heap to create the idle task
3778:../src/FreeRTOS/tasks.c ****          * or the timer task. */
