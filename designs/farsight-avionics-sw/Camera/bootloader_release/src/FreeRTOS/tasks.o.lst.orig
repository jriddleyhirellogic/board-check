 794:../src/FreeRTOS/tasks.c **** 
 795:../src/FreeRTOS/tasks.c **** /*
 796:../src/FreeRTOS/tasks.c ****  * Convert the snprintf return value to the number of characters
 797:../src/FreeRTOS/tasks.c ****  * written. The following are the possible cases:
 798:../src/FreeRTOS/tasks.c ****  *
 799:../src/FreeRTOS/tasks.c ****  * 1. The buffer supplied to snprintf is large enough to hold the
 800:../src/FreeRTOS/tasks.c ****  *    generated string. The return value in this case is the number
 801:../src/FreeRTOS/tasks.c ****  *    of characters actually written, not counting the terminating
 802:../src/FreeRTOS/tasks.c ****  *    null character.
 803:../src/FreeRTOS/tasks.c ****  * 2. The buffer supplied to snprintf is NOT large enough to hold
 804:../src/FreeRTOS/tasks.c ****  *    the generated string. The return value in this case is the
 805:../src/FreeRTOS/tasks.c ****  *    number of characters that would have been written if the
 806:../src/FreeRTOS/tasks.c ****  *    buffer had been sufficiently large, not counting the
 807:../src/FreeRTOS/tasks.c ****  *    terminating null character.
 808:../src/FreeRTOS/tasks.c ****  * 3. Encoding error. The return value in this case is a negative
 809:../src/FreeRTOS/tasks.c ****  *    number.
 810:../src/FreeRTOS/tasks.c ****  *
 811:../src/FreeRTOS/tasks.c ****  * From 1 and 2 above ==> Only when the return value is non-negative
 812:../src/FreeRTOS/tasks.c ****  * and less than the supplied buffer length, the string has been
 813:../src/FreeRTOS/tasks.c ****  * completely written.
 814:../src/FreeRTOS/tasks.c ****  */
 815:../src/FreeRTOS/tasks.c ****     static size_t prvSnprintfReturnValueToCharsWritten( int iSnprintfReturnValue,
 816:../src/FreeRTOS/tasks.c ****                                                         size_t n );
 817:../src/FreeRTOS/tasks.c **** 
 818:../src/FreeRTOS/tasks.c **** #endif /* #if ( ( configUSE_TRACE_FACILITY == 1 ) && ( configUSE_STATS_FORMATTING_FUNCTIONS > 0 ) )
 819:../src/FreeRTOS/tasks.c **** /*-----------------------------------------------------------*/
 820:../src/FreeRTOS/tasks.c **** 
 821:../src/FreeRTOS/tasks.c **** #if ( configNUMBER_OF_CORES > 1 )
 822:../src/FreeRTOS/tasks.c ****     static void prvCheckForRunStateChange( void )
 823:../src/FreeRTOS/tasks.c ****     {
 824:../src/FreeRTOS/tasks.c ****         UBaseType_t uxPrevCriticalNesting;
 825:../src/FreeRTOS/tasks.c ****         const TCB_t * pxThisTCB;
 826:../src/FreeRTOS/tasks.c ****         BaseType_t xCoreID = ( BaseType_t ) portGET_CORE_ID();
 827:../src/FreeRTOS/tasks.c **** 
 828:../src/FreeRTOS/tasks.c ****         /* This must only be called from within a task. */
 829:../src/FreeRTOS/tasks.c ****         portASSERT_IF_IN_ISR();
 830:../src/FreeRTOS/tasks.c **** 
 831:../src/FreeRTOS/tasks.c ****         /* This function is always called with interrupts disabled
 832:../src/FreeRTOS/tasks.c ****          * so this is safe. */
 833:../src/FreeRTOS/tasks.c ****         pxThisTCB = pxCurrentTCBs[ xCoreID ];
 834:../src/FreeRTOS/tasks.c **** 
 835:../src/FreeRTOS/tasks.c ****         while( pxThisTCB->xTaskRunState == taskTASK_SCHEDULED_TO_YIELD )
 836:../src/FreeRTOS/tasks.c ****         {
 837:../src/FreeRTOS/tasks.c ****             /* We are only here if we just entered a critical section
 838:../src/FreeRTOS/tasks.c ****             * or if we just suspended the scheduler, and another task
 839:../src/FreeRTOS/tasks.c ****             * has requested that we yield.
 840:../src/FreeRTOS/tasks.c ****             *
 841:../src/FreeRTOS/tasks.c ****             * This is slightly complicated since we need to save and restore
 842:../src/FreeRTOS/tasks.c ****             * the suspension and critical nesting counts, as well as release
 843:../src/FreeRTOS/tasks.c ****             * and reacquire the correct locks. And then, do it all over again
 844:../src/FreeRTOS/tasks.c ****             * if our state changed again during the reacquisition. */
 845:../src/FreeRTOS/tasks.c ****             uxPrevCriticalNesting = portGET_CRITICAL_NESTING_COUNT( xCoreID );
 846:../src/FreeRTOS/tasks.c **** 
 847:../src/FreeRTOS/tasks.c ****             if( uxPrevCriticalNesting > 0U )
 848:../src/FreeRTOS/tasks.c ****             {
 849:../src/FreeRTOS/tasks.c ****                 portSET_CRITICAL_NESTING_COUNT( xCoreID, 0U );
 850:../src/FreeRTOS/tasks.c ****                 portRELEASE_ISR_LOCK( xCoreID );
 851:../src/FreeRTOS/tasks.c ****             }
 852:../src/FreeRTOS/tasks.c ****             else
 853:../src/FreeRTOS/tasks.c ****             {
 854:../src/FreeRTOS/tasks.c ****                 /* The scheduler is suspended. uxSchedulerSuspended is updated
 855:../src/FreeRTOS/tasks.c ****                  * only when the task is not requested to yield. */
 856:../src/FreeRTOS/tasks.c ****                 mtCOVERAGE_TEST_MARKER();
 857:../src/FreeRTOS/tasks.c ****             }
 858:../src/FreeRTOS/tasks.c **** 
 859:../src/FreeRTOS/tasks.c ****             portRELEASE_TASK_LOCK( xCoreID );
 860:../src/FreeRTOS/tasks.c ****             portMEMORY_BARRIER();
 861:../src/FreeRTOS/tasks.c ****             configASSERT( pxThisTCB->xTaskRunState == taskTASK_SCHEDULED_TO_YIELD );
 862:../src/FreeRTOS/tasks.c **** 
 863:../src/FreeRTOS/tasks.c ****             portENABLE_INTERRUPTS();
 864:../src/FreeRTOS/tasks.c **** 
 865:../src/FreeRTOS/tasks.c ****             /* Enabling interrupts should cause this core to immediately service
 866:../src/FreeRTOS/tasks.c ****              * the pending interrupt and yield. After servicing the pending interrupt,
 867:../src/FreeRTOS/tasks.c ****              * the task needs to re-evaluate its run state within this loop, as
 868:../src/FreeRTOS/tasks.c ****              * other cores may have requested this task to yield, potentially altering
 869:../src/FreeRTOS/tasks.c ****              * its run state. */
 870:../src/FreeRTOS/tasks.c **** 
