3353:../src/FreeRTOS/tasks.c ****                     #else /* if ( configUSE_TASK_NOTIFICATIONS == 1 ) */
3354:../src/FreeRTOS/tasks.c ****                     {
3355:../src/FreeRTOS/tasks.c ****                         xReturn = pdTRUE;
3356:../src/FreeRTOS/tasks.c ****                     }
3357:../src/FreeRTOS/tasks.c ****                     #endif /* if ( configUSE_TASK_NOTIFICATIONS == 1 ) */
3358:../src/FreeRTOS/tasks.c ****                 }
3359:../src/FreeRTOS/tasks.c ****                 else
3360:../src/FreeRTOS/tasks.c ****                 {
3361:../src/FreeRTOS/tasks.c ****                     mtCOVERAGE_TEST_MARKER();
3362:../src/FreeRTOS/tasks.c ****                 }
3363:../src/FreeRTOS/tasks.c ****             }
3364:../src/FreeRTOS/tasks.c ****             else
3365:../src/FreeRTOS/tasks.c ****             {
3366:../src/FreeRTOS/tasks.c ****                 mtCOVERAGE_TEST_MARKER();
3367:../src/FreeRTOS/tasks.c ****             }
