4028:../src/FreeRTOS/tasks.c ****         {
4029:../src/FreeRTOS/tasks.c ****             const BaseType_t xCoreID = ( BaseType_t ) portGET_CORE_ID();
4030:../src/FreeRTOS/tasks.c **** 
4031:../src/FreeRTOS/tasks.c ****             /* If uxSchedulerSuspended is zero then this function does not match a
4032:../src/FreeRTOS/tasks.c ****              * previous call to vTaskSuspendAll(). */
4033:../src/FreeRTOS/tasks.c ****             configASSERT( uxSchedulerSuspended != 0U );
4034:../src/FreeRTOS/tasks.c **** 
4035:../src/FreeRTOS/tasks.c ****             uxSchedulerSuspended = ( UBaseType_t ) ( uxSchedulerSuspended - 1U );
4036:../src/FreeRTOS/tasks.c ****             portRELEASE_TASK_LOCK( xCoreID );
4037:../src/FreeRTOS/tasks.c **** 
4038:../src/FreeRTOS/tasks.c ****             if( uxSchedulerSuspended == ( UBaseType_t ) 0U )
4039:../src/FreeRTOS/tasks.c ****             {
4040:../src/FreeRTOS/tasks.c ****                 if( uxCurrentNumberOfTasks > ( UBaseType_t ) 0U )
4041:../src/FreeRTOS/tasks.c ****                 {
