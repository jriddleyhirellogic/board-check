3208:../src/FreeRTOS/tasks.c ****              * task won't be scheduled before it is resumed as it will no longer
3209:../src/FreeRTOS/tasks.c ****              * be on the ready list. */
3210:../src/FreeRTOS/tasks.c ****             #if ( configNUMBER_OF_CORES > 1 )
3211:../src/FreeRTOS/tasks.c ****             {
