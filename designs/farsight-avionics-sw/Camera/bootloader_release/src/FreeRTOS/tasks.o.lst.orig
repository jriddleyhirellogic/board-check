5295:../src/FreeRTOS/tasks.c **** 
5296:../src/FreeRTOS/tasks.c **** void vTaskPlaceOnEventList( List_t * const pxEventList,
5297:../src/FreeRTOS/tasks.c ****                             const TickType_t xTicksToWait )
5298:../src/FreeRTOS/tasks.c **** {
5299:../src/FreeRTOS/tasks.c ****     traceENTER_vTaskPlaceOnEventList( pxEventList, xTicksToWait );
5300:../src/FreeRTOS/tasks.c **** 
5301:../src/FreeRTOS/tasks.c ****     configASSERT( pxEventList );
5302:../src/FreeRTOS/tasks.c **** 
5303:../src/FreeRTOS/tasks.c ****     /* THIS FUNCTION MUST BE CALLED WITH THE
5304:../src/FreeRTOS/tasks.c ****      * SCHEDULER SUSPENDED AND THE QUEUE BEING ACCESSED LOCKED. */
5305:../src/FreeRTOS/tasks.c **** 
5306:../src/FreeRTOS/tasks.c ****     /* Place the event list item of the TCB in the appropriate event list.
5307:../src/FreeRTOS/tasks.c ****      * This is placed in the list in priority order so the highest priority task
5308:../src/FreeRTOS/tasks.c ****      * is the first to be woken by the event.
5309:../src/FreeRTOS/tasks.c ****      *
5310:../src/FreeRTOS/tasks.c ****      * Note: Lists are sorted in ascending order by ListItem_t.xItemValue.
5311:../src/FreeRTOS/tasks.c ****      * Normally, the xItemValue of a TCB's ListItem_t members is:
5312:../src/FreeRTOS/tasks.c ****      *      xItemValue = ( configMAX_PRIORITIES - uxPriority )
5313:../src/FreeRTOS/tasks.c ****      * Therefore, the event list is sorted in descending priority order.
5314:../src/FreeRTOS/tasks.c ****      *
5315:../src/FreeRTOS/tasks.c ****      * The queue that contains the event list is locked, preventing
5316:../src/FreeRTOS/tasks.c ****      * simultaneous access from interrupts. */
5317:../src/FreeRTOS/tasks.c ****     vListInsert( pxEventList, &( pxCurrentTCB->xEventListItem ) );
