4047:../src/FreeRTOS/tasks.c ****                         /* More details at: https://github.com/FreeRTOS/FreeRTOS-Kernel/blob/main/M
4048:../src/FreeRTOS/tasks.c ****                         /* coverity[misra_c_2012_rule_11_5_violation] */
4049:../src/FreeRTOS/tasks.c ****                         pxTCB = listGET_OWNER_OF_HEAD_ENTRY( ( &xPendingReadyList ) );
4050:../src/FreeRTOS/tasks.c ****                         listREMOVE_ITEM( &( pxTCB->xEventListItem ) );
4051:../src/FreeRTOS/tasks.c ****                         portMEMORY_BARRIER();
4052:../src/FreeRTOS/tasks.c ****                         listREMOVE_ITEM( &( pxTCB->xStateListItem ) );
4053:../src/FreeRTOS/tasks.c ****                         prvAddTaskToReadyList( pxTCB );
4054:../src/FreeRTOS/tasks.c **** 
4055:../src/FreeRTOS/tasks.c ****                         #if ( configNUMBER_OF_CORES == 1 )
4056:../src/FreeRTOS/tasks.c ****                         {
4057:../src/FreeRTOS/tasks.c ****                             /* If the moved task has a priority higher than the current
4058:../src/FreeRTOS/tasks.c ****                              * task then a yield must be performed. */
4059:../src/FreeRTOS/tasks.c ****                             if( pxTCB->uxPriority > pxCurrentTCB->uxPriority )
