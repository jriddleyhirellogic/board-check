5194:../src/FreeRTOS/tasks.c ****     void vTaskSwitchContext( BaseType_t xCoreID )
5195:../src/FreeRTOS/tasks.c ****     {
5196:../src/FreeRTOS/tasks.c ****         traceENTER_vTaskSwitchContext();
5197:../src/FreeRTOS/tasks.c **** 
5198:../src/FreeRTOS/tasks.c ****         /* Acquire both locks:
5199:../src/FreeRTOS/tasks.c ****          * - The ISR lock protects the ready list from simultaneous access by
5200:../src/FreeRTOS/tasks.c ****          *   both other ISRs and tasks.
5201:../src/FreeRTOS/tasks.c ****          * - We also take the task lock to pause here in case another core has
5202:../src/FreeRTOS/tasks.c ****          *   suspended the scheduler. We don't want to simply set xYieldPending
5203:../src/FreeRTOS/tasks.c ****          *   and move on if another core suspended the scheduler. We should only
5204:../src/FreeRTOS/tasks.c ****          *   do that if the current core has suspended the scheduler. */
5205:../src/FreeRTOS/tasks.c **** 
5206:../src/FreeRTOS/tasks.c ****         portGET_TASK_LOCK( xCoreID ); /* Must always acquire the task lock first. */
5207:../src/FreeRTOS/tasks.c ****         portGET_ISR_LOCK( xCoreID );
5208:../src/FreeRTOS/tasks.c ****         {
