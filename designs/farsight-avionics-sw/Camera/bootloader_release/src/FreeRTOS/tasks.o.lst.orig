6099:../src/FreeRTOS/tasks.c **** static void prvCheckTasksWaitingTermination( void )
6100:../src/FreeRTOS/tasks.c **** {
6101:../src/FreeRTOS/tasks.c ****     /** THIS FUNCTION IS CALLED FROM THE RTOS IDLE TASK **/
6102:../src/FreeRTOS/tasks.c **** 
6103:../src/FreeRTOS/tasks.c ****     #if ( INCLUDE_vTaskDelete == 1 )
6104:../src/FreeRTOS/tasks.c ****     {
6105:../src/FreeRTOS/tasks.c ****         TCB_t * pxTCB;
6106:../src/FreeRTOS/tasks.c **** 
6107:../src/FreeRTOS/tasks.c ****         /* uxDeletedTasksWaitingCleanUp is used to prevent taskENTER_CRITICAL()
6108:../src/FreeRTOS/tasks.c ****          * being called too often in the idle task. */
6109:../src/FreeRTOS/tasks.c ****         while( uxDeletedTasksWaitingCleanUp > ( UBaseType_t ) 0U )
6110:../src/FreeRTOS/tasks.c ****         {
6111:../src/FreeRTOS/tasks.c ****             #if ( configNUMBER_OF_CORES == 1 )
6112:../src/FreeRTOS/tasks.c ****             {
