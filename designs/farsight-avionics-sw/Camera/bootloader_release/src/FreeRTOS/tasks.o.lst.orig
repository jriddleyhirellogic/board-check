3787:../src/FreeRTOS/tasks.c ****      * from getting optimized out as it is no longer used by the kernel. */
3788:../src/FreeRTOS/tasks.c ****     ( void ) uxTopUsedPriority;
3789:../src/FreeRTOS/tasks.c **** 
3790:../src/FreeRTOS/tasks.c ****     traceRETURN_vTaskStartScheduler();
3791:../src/FreeRTOS/tasks.c **** }
3792:../src/FreeRTOS/tasks.c **** /*-----------------------------------------------------------*/
3793:../src/FreeRTOS/tasks.c **** 
3794:../src/FreeRTOS/tasks.c **** void vTaskEndScheduler( void )
3795:../src/FreeRTOS/tasks.c **** {
3796:../src/FreeRTOS/tasks.c ****     traceENTER_vTaskEndScheduler();
3797:../src/FreeRTOS/tasks.c **** 
3798:../src/FreeRTOS/tasks.c ****     #if ( INCLUDE_vTaskDelete == 1 )
3799:../src/FreeRTOS/tasks.c ****     {
3800:../src/FreeRTOS/tasks.c ****         BaseType_t xCoreID;
3801:../src/FreeRTOS/tasks.c **** 
3802:../src/FreeRTOS/tasks.c ****         #if ( configUSE_TIMERS == 1 )
3803:../src/FreeRTOS/tasks.c ****         {
3804:../src/FreeRTOS/tasks.c ****             /* Delete the timer task created by the kernel. */
3805:../src/FreeRTOS/tasks.c ****             vTaskDelete( xTimerGetTimerDaemonTaskHandle() );
3806:../src/FreeRTOS/tasks.c ****         }
3807:../src/FreeRTOS/tasks.c ****         #endif /* #if ( configUSE_TIMERS == 1 ) */
3808:../src/FreeRTOS/tasks.c **** 
3809:../src/FreeRTOS/tasks.c ****         /* Delete Idle tasks created by the kernel.*/
3810:../src/FreeRTOS/tasks.c ****         for( xCoreID = 0; xCoreID < ( BaseType_t ) configNUMBER_OF_CORES; xCoreID++ )
3811:../src/FreeRTOS/tasks.c ****         {
3812:../src/FreeRTOS/tasks.c ****             vTaskDelete( xIdleTaskHandles[ xCoreID ] );
3813:../src/FreeRTOS/tasks.c ****         }
3814:../src/FreeRTOS/tasks.c **** 
3815:../src/FreeRTOS/tasks.c ****         /* Idle task is responsible for reclaiming the resources of the tasks in
3816:../src/FreeRTOS/tasks.c ****          * xTasksWaitingTermination list. Since the idle task is now deleted and
3817:../src/FreeRTOS/tasks.c ****          * no longer going to run, we need to reclaim resources of all the tasks
3818:../src/FreeRTOS/tasks.c ****          * in the xTasksWaitingTermination list. */
3819:../src/FreeRTOS/tasks.c ****         prvCheckTasksWaitingTermination();
3820:../src/FreeRTOS/tasks.c ****     }
3821:../src/FreeRTOS/tasks.c ****     #endif /* #if ( INCLUDE_vTaskDelete == 1 ) */
3822:../src/FreeRTOS/tasks.c **** 
3823:../src/FreeRTOS/tasks.c ****     /* Stop the scheduler interrupts and call the portable scheduler end
3824:../src/FreeRTOS/tasks.c ****      * routine so the original ISRs can be restored if necessary.  The port
3825:../src/FreeRTOS/tasks.c ****      * layer must ensure interrupts enable  bit is left in the correct state. */
3826:../src/FreeRTOS/tasks.c ****     portDISABLE_INTERRUPTS();
3827:../src/FreeRTOS/tasks.c ****     xSchedulerRunning = pdFALSE;
3828:../src/FreeRTOS/tasks.c **** 
3829:../src/FreeRTOS/tasks.c ****     /* This function must be called from a task and the application is
3830:../src/FreeRTOS/tasks.c ****      * responsible for deleting that task after the scheduler is stopped. */
3831:../src/FreeRTOS/tasks.c ****     vPortEndScheduler();
3832:../src/FreeRTOS/tasks.c **** 
3833:../src/FreeRTOS/tasks.c ****     traceRETURN_vTaskEndScheduler();
3834:../src/FreeRTOS/tasks.c **** }
3835:../src/FreeRTOS/tasks.c **** /*----------------------------------------------------------*/
3836:../src/FreeRTOS/tasks.c **** 
3837:../src/FreeRTOS/tasks.c **** void vTaskSuspendAll( void )
3838:../src/FreeRTOS/tasks.c **** {
3839:../src/FreeRTOS/tasks.c ****     traceENTER_vTaskSuspendAll();
3840:../src/FreeRTOS/tasks.c **** 
3841:../src/FreeRTOS/tasks.c ****     #if ( configNUMBER_OF_CORES == 1 )
3842:../src/FreeRTOS/tasks.c ****     {
3843:../src/FreeRTOS/tasks.c ****         /* A critical section is not required as the variable is of type
3844:../src/FreeRTOS/tasks.c ****          * BaseType_t. Each task maintains its own context, and a context switch
3845:../src/FreeRTOS/tasks.c ****          * cannot occur if the variable is non zero. So, as long as the writing
3846:../src/FreeRTOS/tasks.c ****          * from the register back into the memory is atomic, it is not a
3847:../src/FreeRTOS/tasks.c ****          * problem.
3848:../src/FreeRTOS/tasks.c ****          *
3849:../src/FreeRTOS/tasks.c ****          * Consider the following scenario, which starts with
3850:../src/FreeRTOS/tasks.c ****          * uxSchedulerSuspended at zero.
3851:../src/FreeRTOS/tasks.c ****          *
3852:../src/FreeRTOS/tasks.c ****          * 1. load uxSchedulerSuspended into register.
3853:../src/FreeRTOS/tasks.c ****          * 2. Now a context switch causes another task to run, and the other
3854:../src/FreeRTOS/tasks.c ****          *    task uses the same variable. The other task will see the variable
3855:../src/FreeRTOS/tasks.c ****          *    as zero because the variable has not yet been updated by the
3856:../src/FreeRTOS/tasks.c ****          *    original task. Eventually the original task runs again. **That can
3857:../src/FreeRTOS/tasks.c ****          *    only happen when uxSchedulerSuspended is once again zero**. When
3858:../src/FreeRTOS/tasks.c ****          *    the original task runs again, the contents of the CPU registers
3859:../src/FreeRTOS/tasks.c ****          *    are restored to exactly how they were when it was switched out -
3860:../src/FreeRTOS/tasks.c ****          *    therefore the value it read into the register still matches the
3861:../src/FreeRTOS/tasks.c ****          *    value of the uxSchedulerSuspended variable.
3862:../src/FreeRTOS/tasks.c ****          *
3863:../src/FreeRTOS/tasks.c ****          * 3. increment register.
3864:../src/FreeRTOS/tasks.c ****          * 4. store register into uxSchedulerSuspended. The value restored to
3865:../src/FreeRTOS/tasks.c ****          *    uxSchedulerSuspended will be the correct value of 1, even though
3866:../src/FreeRTOS/tasks.c ****          *    the variable was used by other tasks in the mean time.
3867:../src/FreeRTOS/tasks.c ****          */
3868:../src/FreeRTOS/tasks.c **** 
3869:../src/FreeRTOS/tasks.c ****         /* portSOFTWARE_BARRIER() is only implemented for emulated/simulated ports that
3870:../src/FreeRTOS/tasks.c ****          * do not otherwise exhibit real time behaviour. */
3871:../src/FreeRTOS/tasks.c ****         portSOFTWARE_BARRIER();
3872:../src/FreeRTOS/tasks.c **** 
3873:../src/FreeRTOS/tasks.c ****         /* The scheduler is suspended if uxSchedulerSuspended is non-zero.  An increment
3874:../src/FreeRTOS/tasks.c ****          * is used to allow calls to vTaskSuspendAll() to nest. */
3875:../src/FreeRTOS/tasks.c ****         uxSchedulerSuspended = ( UBaseType_t ) ( uxSchedulerSuspended + 1U );
3876:../src/FreeRTOS/tasks.c **** 
3877:../src/FreeRTOS/tasks.c ****         /* Enforces ordering for ports and optimised compilers that may otherwise place
3878:../src/FreeRTOS/tasks.c ****          * the above increment elsewhere. */
3879:../src/FreeRTOS/tasks.c ****         portMEMORY_BARRIER();
3880:../src/FreeRTOS/tasks.c ****     }
3881:../src/FreeRTOS/tasks.c ****     #else /* #if ( configNUMBER_OF_CORES == 1 ) */
3882:../src/FreeRTOS/tasks.c ****     {
3883:../src/FreeRTOS/tasks.c ****         UBaseType_t ulState;
3884:../src/FreeRTOS/tasks.c ****         BaseType_t xCoreID;
3885:../src/FreeRTOS/tasks.c **** 
3886:../src/FreeRTOS/tasks.c ****         /* This must only be called from within a task. */
3887:../src/FreeRTOS/tasks.c ****         portASSERT_IF_IN_ISR();
3888:../src/FreeRTOS/tasks.c **** 
3889:../src/FreeRTOS/tasks.c ****         if( xSchedulerRunning != pdFALSE )
3890:../src/FreeRTOS/tasks.c ****         {
3891:../src/FreeRTOS/tasks.c ****             /* Writes to uxSchedulerSuspended must be protected by both the task AND ISR locks.
3892:../src/FreeRTOS/tasks.c ****              * We must disable interrupts before we grab the locks in the event that this task is
3893:../src/FreeRTOS/tasks.c ****              * interrupted and switches context before incrementing uxSchedulerSuspended.
3894:../src/FreeRTOS/tasks.c ****              * It is safe to re-enable interrupts after releasing the ISR lock and incrementing
3895:../src/FreeRTOS/tasks.c ****              * uxSchedulerSuspended since that will prevent context switches. */
3896:../src/FreeRTOS/tasks.c ****             ulState = portSET_INTERRUPT_MASK();
3897:../src/FreeRTOS/tasks.c **** 
3898:../src/FreeRTOS/tasks.c ****             xCoreID = ( BaseType_t ) portGET_CORE_ID();
3899:../src/FreeRTOS/tasks.c **** 
3900:../src/FreeRTOS/tasks.c ****             /* This must never be called from inside a critical section. */
3901:../src/FreeRTOS/tasks.c ****             configASSERT( portGET_CRITICAL_NESTING_COUNT( xCoreID ) == 0 );
3902:../src/FreeRTOS/tasks.c **** 
3903:../src/FreeRTOS/tasks.c ****             /* portSOFTWARE_BARRIER() is only implemented for emulated/simulated ports that
3904:../src/FreeRTOS/tasks.c ****              * do not otherwise exhibit real time behaviour. */
3905:../src/FreeRTOS/tasks.c ****             portSOFTWARE_BARRIER();
3906:../src/FreeRTOS/tasks.c **** 
3907:../src/FreeRTOS/tasks.c ****             portGET_TASK_LOCK( xCoreID );
3908:../src/FreeRTOS/tasks.c **** 
3909:../src/FreeRTOS/tasks.c ****             /* uxSchedulerSuspended is increased after prvCheckForRunStateChange. The
3910:../src/FreeRTOS/tasks.c ****              * purpose is to prevent altering the variable when fromISR APIs are readying
3911:../src/FreeRTOS/tasks.c ****              * it. */
3912:../src/FreeRTOS/tasks.c ****             if( uxSchedulerSuspended == 0U )
3913:../src/FreeRTOS/tasks.c ****             {
3914:../src/FreeRTOS/tasks.c ****                 prvCheckForRunStateChange();
3915:../src/FreeRTOS/tasks.c ****             }
3916:../src/FreeRTOS/tasks.c ****             else
3917:../src/FreeRTOS/tasks.c ****             {
3918:../src/FreeRTOS/tasks.c ****                 mtCOVERAGE_TEST_MARKER();
3919:../src/FreeRTOS/tasks.c ****             }
3920:../src/FreeRTOS/tasks.c **** 
3921:../src/FreeRTOS/tasks.c ****             /* Query the coreID again as prvCheckForRunStateChange may have
3922:../src/FreeRTOS/tasks.c ****              * caused the task to get scheduled on a different core. The correct
3923:../src/FreeRTOS/tasks.c ****              * task lock for the core is acquired in prvCheckForRunStateChange. */
3924:../src/FreeRTOS/tasks.c ****             xCoreID = ( BaseType_t ) portGET_CORE_ID();
3925:../src/FreeRTOS/tasks.c **** 
3926:../src/FreeRTOS/tasks.c ****             portGET_ISR_LOCK( xCoreID );
3927:../src/FreeRTOS/tasks.c **** 
3928:../src/FreeRTOS/tasks.c ****             /* The scheduler is suspended if uxSchedulerSuspended is non-zero. An increment
3929:../src/FreeRTOS/tasks.c ****              * is used to allow calls to vTaskSuspendAll() to nest. */
3930:../src/FreeRTOS/tasks.c ****             ++uxSchedulerSuspended;
3931:../src/FreeRTOS/tasks.c ****             portRELEASE_ISR_LOCK( xCoreID );
3932:../src/FreeRTOS/tasks.c **** 
3933:../src/FreeRTOS/tasks.c ****             portCLEAR_INTERRUPT_MASK( ulState );
3934:../src/FreeRTOS/tasks.c ****         }
3935:../src/FreeRTOS/tasks.c ****         else
3936:../src/FreeRTOS/tasks.c ****         {
3937:../src/FreeRTOS/tasks.c ****             mtCOVERAGE_TEST_MARKER();
3938:../src/FreeRTOS/tasks.c ****         }
3939:../src/FreeRTOS/tasks.c ****     }
3940:../src/FreeRTOS/tasks.c ****     #endif /* #if ( configNUMBER_OF_CORES == 1 ) */
3941:../src/FreeRTOS/tasks.c **** 
3942:../src/FreeRTOS/tasks.c ****     traceRETURN_vTaskSuspendAll();
3943:../src/FreeRTOS/tasks.c **** }
3944:../src/FreeRTOS/tasks.c **** 
3945:../src/FreeRTOS/tasks.c **** /*----------------------------------------------------------*/
3946:../src/FreeRTOS/tasks.c **** 
3947:../src/FreeRTOS/tasks.c **** #if ( configUSE_TICKLESS_IDLE != 0 )
3948:../src/FreeRTOS/tasks.c **** 
3949:../src/FreeRTOS/tasks.c ****     static TickType_t prvGetExpectedIdleTime( void )
3950:../src/FreeRTOS/tasks.c ****     {
3951:../src/FreeRTOS/tasks.c ****         TickType_t xReturn;
3952:../src/FreeRTOS/tasks.c ****         BaseType_t xHigherPriorityReadyTasks = pdFALSE;
3953:../src/FreeRTOS/tasks.c **** 
3954:../src/FreeRTOS/tasks.c ****         /* xHigherPriorityReadyTasks takes care of the case where
3955:../src/FreeRTOS/tasks.c ****          * configUSE_PREEMPTION is 0, so there may be tasks above the idle priority
3956:../src/FreeRTOS/tasks.c ****          * task that are in the Ready state, even though the idle task is
3957:../src/FreeRTOS/tasks.c ****          * running. */
3958:../src/FreeRTOS/tasks.c ****         #if ( configUSE_PORT_OPTIMISED_TASK_SELECTION == 0 )
3959:../src/FreeRTOS/tasks.c ****         {
3960:../src/FreeRTOS/tasks.c ****             if( uxTopReadyPriority > tskIDLE_PRIORITY )
3961:../src/FreeRTOS/tasks.c ****             {
3962:../src/FreeRTOS/tasks.c ****                 xHigherPriorityReadyTasks = pdTRUE;
3963:../src/FreeRTOS/tasks.c ****             }
3964:../src/FreeRTOS/tasks.c ****         }
3965:../src/FreeRTOS/tasks.c ****         #else
3966:../src/FreeRTOS/tasks.c ****         {
3967:../src/FreeRTOS/tasks.c ****             const UBaseType_t uxLeastSignificantBit = ( UBaseType_t ) 0x01;
3968:../src/FreeRTOS/tasks.c **** 
3969:../src/FreeRTOS/tasks.c ****             /* When port optimised task selection is used the uxTopReadyPriority
3970:../src/FreeRTOS/tasks.c ****              * variable is used as a bit map.  If bits other than the least
3971:../src/FreeRTOS/tasks.c ****              * significant bit are set then there are tasks that have a priority
3972:../src/FreeRTOS/tasks.c ****              * above the idle priority that are in the Ready state.  This takes
3973:../src/FreeRTOS/tasks.c ****              * care of the case where the co-operative scheduler is in use. */
3974:../src/FreeRTOS/tasks.c ****             if( uxTopReadyPriority > uxLeastSignificantBit )
3975:../src/FreeRTOS/tasks.c ****             {
3976:../src/FreeRTOS/tasks.c ****                 xHigherPriorityReadyTasks = pdTRUE;
3977:../src/FreeRTOS/tasks.c ****             }
3978:../src/FreeRTOS/tasks.c ****         }
3979:../src/FreeRTOS/tasks.c ****         #endif /* if ( configUSE_PORT_OPTIMISED_TASK_SELECTION == 0 ) */
3980:../src/FreeRTOS/tasks.c **** 
3981:../src/FreeRTOS/tasks.c ****         if( pxCurrentTCB->uxPriority > tskIDLE_PRIORITY )
3982:../src/FreeRTOS/tasks.c ****         {
3983:../src/FreeRTOS/tasks.c ****             xReturn = 0;
3984:../src/FreeRTOS/tasks.c ****         }
3985:../src/FreeRTOS/tasks.c ****         else if( listCURRENT_LIST_LENGTH( &( pxReadyTasksLists[ tskIDLE_PRIORITY ] ) ) > 1U )
3986:../src/FreeRTOS/tasks.c ****         {
3987:../src/FreeRTOS/tasks.c ****             /* There are other idle priority tasks in the ready state.  If
3988:../src/FreeRTOS/tasks.c ****              * time slicing is used then the very next tick interrupt must be
3989:../src/FreeRTOS/tasks.c ****              * processed. */
3990:../src/FreeRTOS/tasks.c ****             xReturn = 0;
3991:../src/FreeRTOS/tasks.c ****         }
3992:../src/FreeRTOS/tasks.c ****         else if( xHigherPriorityReadyTasks != pdFALSE )
3993:../src/FreeRTOS/tasks.c ****         {
3994:../src/FreeRTOS/tasks.c ****             /* There are tasks in the Ready state that have a priority above the
3995:../src/FreeRTOS/tasks.c ****              * idle priority.  This path can only be reached if
3996:../src/FreeRTOS/tasks.c ****              * configUSE_PREEMPTION is 0. */
3997:../src/FreeRTOS/tasks.c ****             xReturn = 0;
3998:../src/FreeRTOS/tasks.c ****         }
3999:../src/FreeRTOS/tasks.c ****         else
4000:../src/FreeRTOS/tasks.c ****         {
4001:../src/FreeRTOS/tasks.c ****             xReturn = xNextTaskUnblockTime;
4002:../src/FreeRTOS/tasks.c ****             xReturn -= xTickCount;
4003:../src/FreeRTOS/tasks.c ****         }
4004:../src/FreeRTOS/tasks.c **** 
4005:../src/FreeRTOS/tasks.c ****         return xReturn;
4006:../src/FreeRTOS/tasks.c ****     }
4007:../src/FreeRTOS/tasks.c **** 
4008:../src/FreeRTOS/tasks.c **** #endif /* configUSE_TICKLESS_IDLE */
