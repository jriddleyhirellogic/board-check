8656:../src/FreeRTOS/tasks.c ****     #else /* INCLUDE_vTaskSuspend */
8657:../src/FreeRTOS/tasks.c ****     {
8658:../src/FreeRTOS/tasks.c ****         /* Calculate the time at which the task should be woken if the event
8659:../src/FreeRTOS/tasks.c ****          * does not occur.  This may overflow but this doesn't matter, the kernel
8660:../src/FreeRTOS/tasks.c ****          * will manage it correctly. */
8661:../src/FreeRTOS/tasks.c ****         xTimeToWake = xConstTickCount + xTicksToWait;
8662:../src/FreeRTOS/tasks.c **** 
8663:../src/FreeRTOS/tasks.c ****         /* The list item will be inserted in wake time order. */
8664:../src/FreeRTOS/tasks.c ****         listSET_LIST_ITEM_VALUE( &( pxCurrentTCB->xStateListItem ), xTimeToWake );
8665:../src/FreeRTOS/tasks.c **** 
8666:../src/FreeRTOS/tasks.c ****         if( xTimeToWake < xConstTickCount )
8667:../src/FreeRTOS/tasks.c ****         {
8668:../src/FreeRTOS/tasks.c ****             traceMOVED_TASK_TO_OVERFLOW_DELAYED_LIST();
8669:../src/FreeRTOS/tasks.c ****             /* Wake time has overflowed.  Place this item in the overflow list. */
8670:../src/FreeRTOS/tasks.c ****             vListInsert( pxOverflowDelayedList, &( pxCurrentTCB->xStateListItem ) );
8671:../src/FreeRTOS/tasks.c ****         }
8672:../src/FreeRTOS/tasks.c ****         else
8673:../src/FreeRTOS/tasks.c ****         {
8674:../src/FreeRTOS/tasks.c ****             traceMOVED_TASK_TO_DELAYED_LIST();
8675:../src/FreeRTOS/tasks.c ****             /* The wake time has not overflowed, so the current block list is used. */
8676:../src/FreeRTOS/tasks.c ****             vListInsert( pxDelayedList, &( pxCurrentTCB->xStateListItem ) );
8677:../src/FreeRTOS/tasks.c **** 
8678:../src/FreeRTOS/tasks.c ****             /* If the task entering the blocked state was placed at the head of the
8679:../src/FreeRTOS/tasks.c ****              * list of blocked tasks then xNextTaskUnblockTime needs to be updated
8680:../src/FreeRTOS/tasks.c ****              * too. */
8681:../src/FreeRTOS/tasks.c ****             if( xTimeToWake < xNextTaskUnblockTime )
8682:../src/FreeRTOS/tasks.c ****             {
8683:../src/FreeRTOS/tasks.c ****                 xNextTaskUnblockTime = xTimeToWake;
8684:../src/FreeRTOS/tasks.c ****             }
8685:../src/FreeRTOS/tasks.c ****             else
8686:../src/FreeRTOS/tasks.c ****             {
8687:../src/FreeRTOS/tasks.c ****                 mtCOVERAGE_TEST_MARKER();
8688:../src/FreeRTOS/tasks.c ****             }
8689:../src/FreeRTOS/tasks.c ****         }
8690:../src/FreeRTOS/tasks.c **** 
8691:../src/FreeRTOS/tasks.c ****         /* Avoid compiler warning when INCLUDE_vTaskSuspend is not 1. */
8692:../src/FreeRTOS/tasks.c ****         ( void ) xCanBlockIndefinitely;
8693:../src/FreeRTOS/tasks.c ****     }
8694:../src/FreeRTOS/tasks.c ****     #endif /* INCLUDE_vTaskSuspend */
