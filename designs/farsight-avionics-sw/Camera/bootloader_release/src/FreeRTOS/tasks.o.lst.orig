3312:../src/FreeRTOS/tasks.c ****     static BaseType_t prvTaskIsTaskSuspended( const TaskHandle_t xTask )
3313:../src/FreeRTOS/tasks.c ****     {
3314:../src/FreeRTOS/tasks.c ****         BaseType_t xReturn = pdFALSE;
3315:../src/FreeRTOS/tasks.c ****         const TCB_t * const pxTCB = xTask;
3316:../src/FreeRTOS/tasks.c **** 
3317:../src/FreeRTOS/tasks.c ****         /* Accesses xPendingReadyList so must be called from a critical
3318:../src/FreeRTOS/tasks.c ****          * section. */
3319:../src/FreeRTOS/tasks.c **** 
3320:../src/FreeRTOS/tasks.c ****         /* It does not make sense to check if the calling task is suspended. */
3321:../src/FreeRTOS/tasks.c ****         configASSERT( xTask );
3322:../src/FreeRTOS/tasks.c **** 
3323:../src/FreeRTOS/tasks.c ****         /* Is the task being resumed actually in the suspended list? */
3324:../src/FreeRTOS/tasks.c ****         if( listIS_CONTAINED_WITHIN( &xSuspendedTaskList, &( pxTCB->xStateListItem ) ) != pdFALSE )
3325:../src/FreeRTOS/tasks.c ****         {
