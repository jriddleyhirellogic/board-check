5756:../src/FreeRTOS/tasks.c ****                  * A critical region is not required here as we are just reading from
5757:../src/FreeRTOS/tasks.c ****                  * the list, and an occasional incorrect value will not matter.  If
5758:../src/FreeRTOS/tasks.c ****                  * the ready list at the idle priority contains one more task than the
5759:../src/FreeRTOS/tasks.c ****                  * number of idle tasks, which is equal to the configured numbers of cores
5760:../src/FreeRTOS/tasks.c ****                  * then a task other than the idle task is ready to execute. */
5761:../src/FreeRTOS/tasks.c ****                 if( listCURRENT_LIST_LENGTH( &( pxReadyTasksLists[ tskIDLE_PRIORITY ] ) ) > ( UBase
5762:../src/FreeRTOS/tasks.c ****                 {
5763:../src/FreeRTOS/tasks.c ****                     taskYIELD();
5764:../src/FreeRTOS/tasks.c ****                 }
5765:../src/FreeRTOS/tasks.c ****                 else
5766:../src/FreeRTOS/tasks.c ****                 {
5767:../src/FreeRTOS/tasks.c ****                     mtCOVERAGE_TEST_MARKER();
5768:../src/FreeRTOS/tasks.c ****                 }
5769:../src/FreeRTOS/tasks.c ****             }
5770:../src/FreeRTOS/tasks.c ****             #endif /* ( ( configUSE_PREEMPTION == 1 ) && ( configIDLE_SHOULD_YIELD == 1 ) ) */
