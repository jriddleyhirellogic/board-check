4015:../src/FreeRTOS/tasks.c **** 
4016:../src/FreeRTOS/tasks.c ****     traceENTER_xTaskResumeAll();
4017:../src/FreeRTOS/tasks.c **** 
4018:../src/FreeRTOS/tasks.c ****     #if ( configNUMBER_OF_CORES > 1 )
4019:../src/FreeRTOS/tasks.c ****         if( xSchedulerRunning != pdFALSE )
4020:../src/FreeRTOS/tasks.c ****     #endif
4021:../src/FreeRTOS/tasks.c ****     {
4022:../src/FreeRTOS/tasks.c ****         /* It is possible that an ISR caused a task to be removed from an event
4023:../src/FreeRTOS/tasks.c ****          * list while the scheduler was suspended.  If this was the case then the
4024:../src/FreeRTOS/tasks.c ****          * removed task will have been added to the xPendingReadyList.  Once the
4025:../src/FreeRTOS/tasks.c ****          * scheduler has been resumed it is safe to move all the pending ready
4026:../src/FreeRTOS/tasks.c ****          * tasks from this list into their appropriate ready list. */
