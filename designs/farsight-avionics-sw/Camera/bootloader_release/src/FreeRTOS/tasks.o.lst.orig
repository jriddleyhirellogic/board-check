3389:../src/FreeRTOS/tasks.c ****         configASSERT( xTaskToResume );
3390:../src/FreeRTOS/tasks.c **** 
3391:../src/FreeRTOS/tasks.c ****         #if ( configNUMBER_OF_CORES == 1 )
3392:../src/FreeRTOS/tasks.c **** 
3393:../src/FreeRTOS/tasks.c ****             /* The parameter cannot be NULL as it is impossible to resume the
3394:../src/FreeRTOS/tasks.c ****              * currently executing task. */
3395:../src/FreeRTOS/tasks.c ****             if( ( pxTCB != pxCurrentTCB ) && ( pxTCB != NULL ) )
3396:../src/FreeRTOS/tasks.c ****         #else
3397:../src/FreeRTOS/tasks.c **** 
3398:../src/FreeRTOS/tasks.c ****             /* The parameter cannot be NULL as it is impossible to resume the
3399:../src/FreeRTOS/tasks.c ****              * currently executing task. It is also impossible to resume a task
3400:../src/FreeRTOS/tasks.c ****              * that is actively running on another core but it is not safe
3401:../src/FreeRTOS/tasks.c ****              * to check their run state here. Therefore, we get into a critical
3402:../src/FreeRTOS/tasks.c ****              * section and check if the task is actually suspended or not. */
3403:../src/FreeRTOS/tasks.c ****             if( pxTCB != NULL )
3404:../src/FreeRTOS/tasks.c ****         #endif
3405:../src/FreeRTOS/tasks.c ****         {
