4569:../src/FreeRTOS/tasks.c ****         configASSERT( xUpdatedTickCount <= xNextTaskUnblockTime );
4570:../src/FreeRTOS/tasks.c **** 
4571:../src/FreeRTOS/tasks.c ****         if( xUpdatedTickCount == xNextTaskUnblockTime )
4572:../src/FreeRTOS/tasks.c ****         {
