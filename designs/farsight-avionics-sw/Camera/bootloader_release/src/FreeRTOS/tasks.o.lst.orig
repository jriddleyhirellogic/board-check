5393:../src/FreeRTOS/tasks.c **** 
5394:../src/FreeRTOS/tasks.c **** BaseType_t xTaskRemoveFromEventList( const List_t * const pxEventList )
5395:../src/FreeRTOS/tasks.c **** {
5396:../src/FreeRTOS/tasks.c ****     TCB_t * pxUnblockedTCB;
5397:../src/FreeRTOS/tasks.c ****     BaseType_t xReturn;
5398:../src/FreeRTOS/tasks.c **** 
5399:../src/FreeRTOS/tasks.c ****     traceENTER_xTaskRemoveFromEventList( pxEventList );
5400:../src/FreeRTOS/tasks.c **** 
5401:../src/FreeRTOS/tasks.c ****     /* THIS FUNCTION MUST BE CALLED FROM A CRITICAL SECTION.  It can also be
5402:../src/FreeRTOS/tasks.c ****      * called from a critical section within an ISR. */
5403:../src/FreeRTOS/tasks.c **** 
5404:../src/FreeRTOS/tasks.c ****     /* The event list is sorted in priority order, so the first in the list can
5405:../src/FreeRTOS/tasks.c ****      * be removed as it is known to be the highest priority.  Remove the TCB from
5406:../src/FreeRTOS/tasks.c ****      * the delayed list, and add it to the ready list.
5407:../src/FreeRTOS/tasks.c ****      *
5408:../src/FreeRTOS/tasks.c ****      * If an event is for a queue that is locked then this function will never
5409:../src/FreeRTOS/tasks.c ****      * get called - the lock count on the queue will get modified instead.  This
5410:../src/FreeRTOS/tasks.c ****      * means exclusive access to the event list is guaranteed here.
5411:../src/FreeRTOS/tasks.c ****      *
5412:../src/FreeRTOS/tasks.c ****      * This function assumes that a check has already been made to ensure that
5413:../src/FreeRTOS/tasks.c ****      * pxEventList is not empty. */
5414:../src/FreeRTOS/tasks.c ****     /* MISRA Ref 11.5.3 [Void pointer assignment] */
5415:../src/FreeRTOS/tasks.c ****     /* More details at: https://github.com/FreeRTOS/FreeRTOS-Kernel/blob/main/MISRA.md#rule-115 */
5416:../src/FreeRTOS/tasks.c ****     /* coverity[misra_c_2012_rule_11_5_violation] */
5417:../src/FreeRTOS/tasks.c ****     pxUnblockedTCB = listGET_OWNER_OF_HEAD_ENTRY( pxEventList );
5418:../src/FreeRTOS/tasks.c ****     configASSERT( pxUnblockedTCB );
5419:../src/FreeRTOS/tasks.c ****     listREMOVE_ITEM( &( pxUnblockedTCB->xEventListItem ) );
5420:../src/FreeRTOS/tasks.c **** 
5421:../src/FreeRTOS/tasks.c ****     if( uxSchedulerSuspended == ( UBaseType_t ) 0U )
5422:../src/FreeRTOS/tasks.c ****     {
5423:../src/FreeRTOS/tasks.c ****         listREMOVE_ITEM( &( pxUnblockedTCB->xStateListItem ) );
5424:../src/FreeRTOS/tasks.c ****         prvAddTaskToReadyList( pxUnblockedTCB );
5425:../src/FreeRTOS/tasks.c **** 
5426:../src/FreeRTOS/tasks.c ****         #if ( configUSE_TICKLESS_IDLE != 0 )
5427:../src/FreeRTOS/tasks.c ****         {
5428:../src/FreeRTOS/tasks.c ****             /* If a task is blocked on a kernel object then xNextTaskUnblockTime
5429:../src/FreeRTOS/tasks.c ****              * might be set to the blocked task's time out time.  If the task is
5430:../src/FreeRTOS/tasks.c ****              * unblocked for a reason other than a timeout xNextTaskUnblockTime is
5431:../src/FreeRTOS/tasks.c ****              * normally left unchanged, because it is automatically reset to a new
5432:../src/FreeRTOS/tasks.c ****              * value when the tick count equals xNextTaskUnblockTime.  However if
5433:../src/FreeRTOS/tasks.c ****              * tickless idling is used it might be more important to enter sleep mode
5434:../src/FreeRTOS/tasks.c ****              * at the earliest possible time - so reset xNextTaskUnblockTime here to
5435:../src/FreeRTOS/tasks.c ****              * ensure it is updated at the earliest possible time. */
5436:../src/FreeRTOS/tasks.c ****             prvResetNextTaskUnblockTime();
5437:../src/FreeRTOS/tasks.c ****         }
5438:../src/FreeRTOS/tasks.c ****         #endif
5439:../src/FreeRTOS/tasks.c ****     }
5440:../src/FreeRTOS/tasks.c ****     else
5441:../src/FreeRTOS/tasks.c ****     {
5442:../src/FreeRTOS/tasks.c ****         /* The delayed and ready lists cannot be accessed, so hold this task
5443:../src/FreeRTOS/tasks.c ****          * pending until the scheduler is resumed. */
5444:../src/FreeRTOS/tasks.c ****         listINSERT_END( &( xPendingReadyList ), &( pxUnblockedTCB->xEventListItem ) );
5445:../src/FreeRTOS/tasks.c ****     }
5446:../src/FreeRTOS/tasks.c **** 
5447:../src/FreeRTOS/tasks.c ****     #if ( configNUMBER_OF_CORES == 1 )
5448:../src/FreeRTOS/tasks.c ****     {
5449:../src/FreeRTOS/tasks.c ****         if( pxUnblockedTCB->uxPriority > pxCurrentTCB->uxPriority )
5450:../src/FreeRTOS/tasks.c ****         {
5451:../src/FreeRTOS/tasks.c ****             /* Return true if the task removed from the event list has a higher
5452:../src/FreeRTOS/tasks.c ****              * priority than the calling task.  This allows the calling task to know if
5453:../src/FreeRTOS/tasks.c ****              * it should force a context switch now. */
5454:../src/FreeRTOS/tasks.c ****             xReturn = pdTRUE;
5455:../src/FreeRTOS/tasks.c **** 
5456:../src/FreeRTOS/tasks.c ****             /* Mark that a yield is pending in case the user is not using the
5457:../src/FreeRTOS/tasks.c ****              * "xHigherPriorityTaskWoken" parameter to an ISR safe FreeRTOS function. */
5458:../src/FreeRTOS/tasks.c ****             xYieldPendings[ 0 ] = pdTRUE;
5459:../src/FreeRTOS/tasks.c ****         }
5460:../src/FreeRTOS/tasks.c ****         else
5461:../src/FreeRTOS/tasks.c ****         {
5462:../src/FreeRTOS/tasks.c ****             xReturn = pdFALSE;
5463:../src/FreeRTOS/tasks.c ****         }
5464:../src/FreeRTOS/tasks.c ****     }
5465:../src/FreeRTOS/tasks.c ****     #else /* #if ( configNUMBER_OF_CORES == 1 ) */
5466:../src/FreeRTOS/tasks.c ****     {
5467:../src/FreeRTOS/tasks.c ****         xReturn = pdFALSE;
5468:../src/FreeRTOS/tasks.c **** 
5469:../src/FreeRTOS/tasks.c ****         #if ( configUSE_PREEMPTION == 1 )
5470:../src/FreeRTOS/tasks.c ****         {
5471:../src/FreeRTOS/tasks.c ****             prvYieldForTask( pxUnblockedTCB );
5472:../src/FreeRTOS/tasks.c **** 
5473:../src/FreeRTOS/tasks.c ****             if( xYieldPendings[ portGET_CORE_ID() ] != pdFALSE )
5474:../src/FreeRTOS/tasks.c ****             {
5475:../src/FreeRTOS/tasks.c ****                 xReturn = pdTRUE;
5476:../src/FreeRTOS/tasks.c ****             }
5477:../src/FreeRTOS/tasks.c ****         }
5478:../src/FreeRTOS/tasks.c ****         #endif /* #if ( configUSE_PREEMPTION == 1 ) */
5479:../src/FreeRTOS/tasks.c ****     }
5480:../src/FreeRTOS/tasks.c ****     #endif /* #if ( configNUMBER_OF_CORES == 1 ) */
5481:../src/FreeRTOS/tasks.c **** 
5482:../src/FreeRTOS/tasks.c ****     traceRETURN_xTaskRemoveFromEventList( xReturn );
5483:../src/FreeRTOS/tasks.c ****     return xReturn;
5484:../src/FreeRTOS/tasks.c **** }
