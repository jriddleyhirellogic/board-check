 346:../src/FreeRTOS/tasks.c **** /* Yields the given core. This must be called from a critical section and xCoreID
 347:../src/FreeRTOS/tasks.c ****  * must be valid. This macro is not required in single core since there is only
 348:../src/FreeRTOS/tasks.c ****  * one core to yield. */
 349:../src/FreeRTOS/tasks.c ****     #define prvYieldCore( xCoreID )                                                          \
 350:../src/FreeRTOS/tasks.c ****     do {                                                                                     \
 351:../src/FreeRTOS/tasks.c ****         if( ( xCoreID ) == ( BaseType_t ) portGET_CORE_ID() )                                \
 352:../src/FreeRTOS/tasks.c ****         {                                                                                    \
 353:../src/FreeRTOS/tasks.c ****             /* Pending a yield for this core since it is in the critical section. */         \
 354:../src/FreeRTOS/tasks.c ****             xYieldPendings[ ( xCoreID ) ] = pdTRUE;                                          \
 355:../src/FreeRTOS/tasks.c ****         }                                                                                    \
 356:../src/FreeRTOS/tasks.c ****         else                                                                                 \
 357:../src/FreeRTOS/tasks.c ****         {                                                                                    \
 358:../src/FreeRTOS/tasks.c ****             /* Request other core to yield if it is not requested before. */                 \
 359:../src/FreeRTOS/tasks.c ****             if( pxCurrentTCBs[ ( xCoreID ) ]->xTaskRunState != taskTASK_SCHEDULED_TO_YIELD ) \
 360:../src/FreeRTOS/tasks.c ****             {                                                                                \
 361:../src/FreeRTOS/tasks.c ****                 portYIELD_CORE( xCoreID );                                                   \
 362:../src/FreeRTOS/tasks.c ****                 pxCurrentTCBs[ ( xCoreID ) ]->xTaskRunState = taskTASK_SCHEDULED_TO_YIELD;   \
 363:../src/FreeRTOS/tasks.c ****             }                                                                                \
 364:../src/FreeRTOS/tasks.c ****         }                                                                                    \
 365:../src/FreeRTOS/tasks.c ****     } while( 0 )
 366:../src/FreeRTOS/tasks.c **** #endif /* #if ( configNUMBER_OF_CORES > 1 ) */
