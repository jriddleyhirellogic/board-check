5356:../src/FreeRTOS/tasks.c **** 
5357:../src/FreeRTOS/tasks.c ****     void vTaskPlaceOnEventListRestricted( List_t * const pxEventList,
5358:../src/FreeRTOS/tasks.c ****                                           TickType_t xTicksToWait,
5359:../src/FreeRTOS/tasks.c ****                                           const BaseType_t xWaitIndefinitely )
5360:../src/FreeRTOS/tasks.c ****     {
5361:../src/FreeRTOS/tasks.c ****         traceENTER_vTaskPlaceOnEventListRestricted( pxEventList, xTicksToWait, xWaitIndefinitely );
5362:../src/FreeRTOS/tasks.c **** 
5363:../src/FreeRTOS/tasks.c ****         configASSERT( pxEventList );
5364:../src/FreeRTOS/tasks.c **** 
5365:../src/FreeRTOS/tasks.c ****         /* This function should not be called by application code hence the
5366:../src/FreeRTOS/tasks.c ****          * 'Restricted' in its name.  It is not part of the public API.  It is
5367:../src/FreeRTOS/tasks.c ****          * designed for use by kernel code, and has special calling requirements -
5368:../src/FreeRTOS/tasks.c ****          * it should be called with the scheduler suspended. */
5369:../src/FreeRTOS/tasks.c **** 
5370:../src/FreeRTOS/tasks.c **** 
5371:../src/FreeRTOS/tasks.c ****         /* Place the event list item of the TCB in the appropriate event list.
5372:../src/FreeRTOS/tasks.c ****          * In this case it is assume that this is the only task that is going to
5373:../src/FreeRTOS/tasks.c ****          * be waiting on this event list, so the faster vListInsertEnd() function
5374:../src/FreeRTOS/tasks.c ****          * can be used in place of vListInsert. */
5375:../src/FreeRTOS/tasks.c ****         listINSERT_END( pxEventList, &( pxCurrentTCB->xEventListItem ) );
5376:../src/FreeRTOS/tasks.c **** 
5377:../src/FreeRTOS/tasks.c ****         /* If the task should block indefinitely then set the block time to a
5378:../src/FreeRTOS/tasks.c ****          * value that will be recognised as an indefinite delay inside the
5379:../src/FreeRTOS/tasks.c ****          * prvAddCurrentTaskToDelayedList() function. */
5380:../src/FreeRTOS/tasks.c ****         if( xWaitIndefinitely != pdFALSE )
5381:../src/FreeRTOS/tasks.c ****         {
5382:../src/FreeRTOS/tasks.c ****             xTicksToWait = portMAX_DELAY;
5383:../src/FreeRTOS/tasks.c ****         }
5384:../src/FreeRTOS/tasks.c **** 
5385:../src/FreeRTOS/tasks.c ****         traceTASK_DELAY_UNTIL( ( xTickCount + xTicksToWait ) );
5386:../src/FreeRTOS/tasks.c ****         prvAddCurrentTaskToDelayedList( xTicksToWait, xWaitIndefinitely );
5387:../src/FreeRTOS/tasks.c **** 
5388:../src/FreeRTOS/tasks.c ****         traceRETURN_vTaskPlaceOnEventListRestricted();
5389:../src/FreeRTOS/tasks.c ****     }
