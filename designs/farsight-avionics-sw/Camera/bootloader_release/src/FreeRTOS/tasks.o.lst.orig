5219:../src/FreeRTOS/tasks.c ****             }
5220:../src/FreeRTOS/tasks.c ****             else
5221:../src/FreeRTOS/tasks.c ****             {
5222:../src/FreeRTOS/tasks.c ****                 xYieldPendings[ xCoreID ] = pdFALSE;
5223:../src/FreeRTOS/tasks.c ****                 traceTASK_SWITCHED_OUT();
5224:../src/FreeRTOS/tasks.c **** 
5225:../src/FreeRTOS/tasks.c ****                 #if ( configGENERATE_RUN_TIME_STATS == 1 )
5226:../src/FreeRTOS/tasks.c ****                 {
