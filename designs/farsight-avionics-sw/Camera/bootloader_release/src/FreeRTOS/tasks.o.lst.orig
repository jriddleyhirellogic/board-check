 518:../src/FreeRTOS/tasks.c **** /* Context switches are held pending while the scheduler is suspended.  Also,
 519:../src/FreeRTOS/tasks.c ****  * interrupts must not manipulate the xStateListItem of a TCB, or any of the
 520:../src/FreeRTOS/tasks.c ****  * lists the xStateListItem can be referenced from, if the scheduler is suspended.
 521:../src/FreeRTOS/tasks.c ****  * If an interrupt needs to unblock a task while the scheduler is suspended then it
 522:../src/FreeRTOS/tasks.c ****  * moves the task's event list item into the xPendingReadyList, ready for the
 523:../src/FreeRTOS/tasks.c ****  * kernel to move the task from the pending ready list into the real ready list
 524:../src/FreeRTOS/tasks.c ****  * when the scheduler is unsuspended.  The pending ready list itself can only be
 525:../src/FreeRTOS/tasks.c ****  * accessed from a critical section.
 526:../src/FreeRTOS/tasks.c ****  *
 527:../src/FreeRTOS/tasks.c ****  * Updates to uxSchedulerSuspended must be protected by both the task lock and the ISR lock
 528:../src/FreeRTOS/tasks.c ****  * and must not be done from an ISR. Reads must be protected by either lock and may be done
 529:../src/FreeRTOS/tasks.c ****  * from either an ISR or a task. */
 530:../src/FreeRTOS/tasks.c **** PRIVILEGED_DATA static volatile UBaseType_t uxSchedulerSuspended = ( UBaseType_t ) 0U;
