3411:../src/FreeRTOS/tasks.c **** 
3412:../src/FreeRTOS/tasks.c ****                     /* The ready list can be accessed even if the scheduler is
3413:../src/FreeRTOS/tasks.c ****                      * suspended because this is inside a critical section. */
3414:../src/FreeRTOS/tasks.c ****                     ( void ) uxListRemove( &( pxTCB->xStateListItem ) );
3415:../src/FreeRTOS/tasks.c ****                     prvAddTaskToReadyList( pxTCB );
3416:../src/FreeRTOS/tasks.c **** 
3417:../src/FreeRTOS/tasks.c ****                     /* This yield may not cause the task just resumed to run,
3418:../src/FreeRTOS/tasks.c ****                      * but will leave the lists in the correct state for the
3419:../src/FreeRTOS/tasks.c ****                      * next yield. */
3420:../src/FreeRTOS/tasks.c ****                     taskYIELD_ANY_CORE_IF_USING_PREEMPTION( pxTCB );
3421:../src/FreeRTOS/tasks.c ****                 }
3422:../src/FreeRTOS/tasks.c ****                 else
3423:../src/FreeRTOS/tasks.c ****                 {
3424:../src/FreeRTOS/tasks.c ****                     mtCOVERAGE_TEST_MARKER();
3425:../src/FreeRTOS/tasks.c ****                 }
3426:../src/FreeRTOS/tasks.c ****             }
3427:../src/FreeRTOS/tasks.c ****             taskEXIT_CRITICAL();
3428:../src/FreeRTOS/tasks.c ****         }
3429:../src/FreeRTOS/tasks.c ****         else
3430:../src/FreeRTOS/tasks.c ****         {
