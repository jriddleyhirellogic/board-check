5228:../src/FreeRTOS/tasks.c ****                         portALT_GET_RUN_TIME_COUNTER_VALUE( ulTotalRunTime[ xCoreID ] );
5229:../src/FreeRTOS/tasks.c ****                     #else
5230:../src/FreeRTOS/tasks.c ****                         ulTotalRunTime[ xCoreID ] = portGET_RUN_TIME_COUNTER_VALUE();
5231:../src/FreeRTOS/tasks.c ****                     #endif
5232:../src/FreeRTOS/tasks.c **** 
5233:../src/FreeRTOS/tasks.c ****                     /* Add the amount of time the task has been running to the
5234:../src/FreeRTOS/tasks.c ****                      * accumulated time so far.  The time the task started running was
5235:../src/FreeRTOS/tasks.c ****                      * stored in ulTaskSwitchedInTime.  Note that there is no overflow
5236:../src/FreeRTOS/tasks.c ****                      * protection here so count values are only valid until the timer
5237:../src/FreeRTOS/tasks.c ****                      * overflows.  The guard against negative values is to protect
5238:../src/FreeRTOS/tasks.c ****                      * against suspect run time stat counter implementations - which
5239:../src/FreeRTOS/tasks.c ****                      * are provided by the application, not the kernel. */
5240:../src/FreeRTOS/tasks.c ****                     if( ulTotalRunTime[ xCoreID ] > ulTaskSwitchedInTime[ xCoreID ] )
5241:../src/FreeRTOS/tasks.c ****                     {
5242:../src/FreeRTOS/tasks.c ****                         pxCurrentTCBs[ xCoreID ]->ulRunTimeCounter += ( ulTotalRunTime[ xCoreID ] -
5243:../src/FreeRTOS/tasks.c ****                     }
5244:../src/FreeRTOS/tasks.c ****                     else
5245:../src/FreeRTOS/tasks.c ****                     {
5246:../src/FreeRTOS/tasks.c ****                         mtCOVERAGE_TEST_MARKER();
5247:../src/FreeRTOS/tasks.c ****                     }
5248:../src/FreeRTOS/tasks.c **** 
5249:../src/FreeRTOS/tasks.c ****                     ulTaskSwitchedInTime[ xCoreID ] = ulTotalRunTime[ xCoreID ];
5250:../src/FreeRTOS/tasks.c ****                 }
5251:../src/FreeRTOS/tasks.c ****                 #endif /* configGENERATE_RUN_TIME_STATS */
5252:../src/FreeRTOS/tasks.c **** 
5253:../src/FreeRTOS/tasks.c ****                 /* Check for stack overflow, if configured. */
5254:../src/FreeRTOS/tasks.c ****                 taskCHECK_FOR_STACK_OVERFLOW();
5255:../src/FreeRTOS/tasks.c **** 
5256:../src/FreeRTOS/tasks.c ****                 /* Before the currently running task is switched out, save its errno. */
