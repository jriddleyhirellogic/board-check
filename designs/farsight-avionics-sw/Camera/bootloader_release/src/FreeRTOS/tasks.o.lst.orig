5740:../src/FreeRTOS/tasks.c ****             {
5741:../src/FreeRTOS/tasks.c ****                 /* If we are not using preemption we keep forcing a task switch to
5742:../src/FreeRTOS/tasks.c ****                  * see if any other task has become available.  If we are using
5743:../src/FreeRTOS/tasks.c ****                  * preemption we don't need to do this as any task becoming available
5744:../src/FreeRTOS/tasks.c ****                  * will automatically get the processor anyway. */
5745:../src/FreeRTOS/tasks.c ****                 taskYIELD();
5746:../src/FreeRTOS/tasks.c ****             }
5747:../src/FreeRTOS/tasks.c ****             #endif /* configUSE_PREEMPTION */
5748:../src/FreeRTOS/tasks.c **** 
5749:../src/FreeRTOS/tasks.c ****             #if ( ( configUSE_PREEMPTION == 1 ) && ( configIDLE_SHOULD_YIELD == 1 ) )
5750:../src/FreeRTOS/tasks.c ****             {
5751:../src/FreeRTOS/tasks.c ****                 /* When using preemption tasks of equal priority will be
5752:../src/FreeRTOS/tasks.c ****                  * timesliced.  If a task that is sharing the idle priority is ready
5753:../src/FreeRTOS/tasks.c ****                  * to run then the idle task should yield before the end of the
5754:../src/FreeRTOS/tasks.c ****                  * timeslice.
