  77:../src/FreeRTOS/tasks.c **** /* This macro requests the running task pxTCB to yield. In single core
  78:../src/FreeRTOS/tasks.c ****  * scheduler, a running task always runs on core 0 and portYIELD_WITHIN_API()
  79:../src/FreeRTOS/tasks.c ****  * can be used to request the task running on core 0 to yield. Therefore, pxTCB
  80:../src/FreeRTOS/tasks.c ****  * is not used in this macro. */
  81:../src/FreeRTOS/tasks.c ****         #define taskYIELD_TASK_CORE_IF_USING_PREEMPTION( pxTCB ) \
  82:../src/FreeRTOS/tasks.c ****     do {                                                         \
  83:../src/FreeRTOS/tasks.c ****         ( void ) ( pxTCB );                                      \
  84:../src/FreeRTOS/tasks.c ****         portYIELD_WITHIN_API();                                  \
  85:../src/FreeRTOS/tasks.c ****     } while( 0 )
  86:../src/FreeRTOS/tasks.c **** 
  87:../src/FreeRTOS/tasks.c ****         #define taskYIELD_ANY_CORE_IF_USING_PREEMPTION( pxTCB ) \
  88:../src/FreeRTOS/tasks.c ****     do {                                                        \
  89:../src/FreeRTOS/tasks.c ****         if( pxCurrentTCB->uxPriority < ( pxTCB )->uxPriority )  \
  90:../src/FreeRTOS/tasks.c ****         {                                                       \
  91:../src/FreeRTOS/tasks.c ****             portYIELD_WITHIN_API();                             \
  92:../src/FreeRTOS/tasks.c ****         }                                                       \
  93:../src/FreeRTOS/tasks.c ****         else                                                    \
  94:../src/FreeRTOS/tasks.c ****         {                                                       \
