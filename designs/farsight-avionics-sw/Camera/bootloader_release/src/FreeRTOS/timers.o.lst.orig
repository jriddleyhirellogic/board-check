 159:../src/FreeRTOS/timers.c **** 
 160:../src/FreeRTOS/timers.c **** /*
 161:../src/FreeRTOS/timers.c ****  * The timer service task (daemon).  Timer functionality is controlled by this
 162:../src/FreeRTOS/timers.c ****  * task.  Other tasks communicate with the timer service task using the
 163:../src/FreeRTOS/timers.c ****  * xTimerQueue queue.
 164:../src/FreeRTOS/timers.c ****  */
 165:../src/FreeRTOS/timers.c ****     static portTASK_FUNCTION_PROTO( prvTimerTask, pvParameters ) PRIVILEGED_FUNCTION;
 166:../src/FreeRTOS/timers.c **** 
 167:../src/FreeRTOS/timers.c **** /*
 168:../src/FreeRTOS/timers.c ****  * Called by the timer service task to interpret and process a command it
 169:../src/FreeRTOS/timers.c ****  * received on the timer queue.
 170:../src/FreeRTOS/timers.c ****  */
 171:../src/FreeRTOS/timers.c ****     static void prvProcessReceivedCommands( void ) PRIVILEGED_FUNCTION;
 172:../src/FreeRTOS/timers.c **** 
 173:../src/FreeRTOS/timers.c **** /*
 174:../src/FreeRTOS/timers.c ****  * Insert the timer into either xActiveTimerList1, or xActiveTimerList2,
 175:../src/FreeRTOS/timers.c ****  * depending on if the expire time causes a timer counter overflow.
 176:../src/FreeRTOS/timers.c ****  */
 177:../src/FreeRTOS/timers.c ****     static BaseType_t prvInsertTimerInActiveList( Timer_t * const pxTimer,
 178:../src/FreeRTOS/timers.c ****                                                   const TickType_t xNextExpiryTime,
 179:../src/FreeRTOS/timers.c ****                                                   const TickType_t xTimeNow,
 180:../src/FreeRTOS/timers.c ****                                                   const TickType_t xCommandTime ) PRIVILEGED_FUNCTI
 181:../src/FreeRTOS/timers.c **** 
 182:../src/FreeRTOS/timers.c **** /*
 183:../src/FreeRTOS/timers.c ****  * Reload the specified auto-reload timer.  If the reloading is backlogged,
 184:../src/FreeRTOS/timers.c ****  * clear the backlog, calling the callback for each additional reload.  When
 185:../src/FreeRTOS/timers.c ****  * this function returns, the next expiry time is after xTimeNow.
 186:../src/FreeRTOS/timers.c ****  */
 187:../src/FreeRTOS/timers.c ****     static void prvReloadTimer( Timer_t * const pxTimer,
 188:../src/FreeRTOS/timers.c ****                                 TickType_t xExpiredTime,
 189:../src/FreeRTOS/timers.c ****                                 const TickType_t xTimeNow ) PRIVILEGED_FUNCTION;
 190:../src/FreeRTOS/timers.c **** 
 191:../src/FreeRTOS/timers.c **** /*
 192:../src/FreeRTOS/timers.c ****  * An active timer has reached its expire time.  Reload the timer if it is an
 193:../src/FreeRTOS/timers.c ****  * auto-reload timer, then call its callback.
 194:../src/FreeRTOS/timers.c ****  */
 195:../src/FreeRTOS/timers.c ****     static void prvProcessExpiredTimer( const TickType_t xNextExpireTime,
 196:../src/FreeRTOS/timers.c ****                                         const TickType_t xTimeNow ) PRIVILEGED_FUNCTION;
 197:../src/FreeRTOS/timers.c **** 
 198:../src/FreeRTOS/timers.c **** /*
 199:../src/FreeRTOS/timers.c ****  * The tick count has overflowed.  Switch the timer lists after ensuring the
 200:../src/FreeRTOS/timers.c ****  * current timer list does not still reference some timers.
 201:../src/FreeRTOS/timers.c ****  */
 202:../src/FreeRTOS/timers.c ****     static void prvSwitchTimerLists( void ) PRIVILEGED_FUNCTION;
 203:../src/FreeRTOS/timers.c **** 
 204:../src/FreeRTOS/timers.c **** /*
 205:../src/FreeRTOS/timers.c ****  * Obtain the current tick count, setting *pxTimerListsWereSwitched to pdTRUE
 206:../src/FreeRTOS/timers.c ****  * if a tick count overflow occurred since prvSampleTimeNow() was last called.
 207:../src/FreeRTOS/timers.c ****  */
 208:../src/FreeRTOS/timers.c ****     static TickType_t prvSampleTimeNow( BaseType_t * const pxTimerListsWereSwitched ) PRIVILEGED_FU
 209:../src/FreeRTOS/timers.c **** 
 210:../src/FreeRTOS/timers.c **** /*
 211:../src/FreeRTOS/timers.c ****  * If the timer list contains any active timers then return the expire time of
 212:../src/FreeRTOS/timers.c ****  * the timer that will expire first and set *pxListWasEmpty to false.  If the
 213:../src/FreeRTOS/timers.c ****  * timer list does not contain any timers then return 0 and set *pxListWasEmpty
 214:../src/FreeRTOS/timers.c ****  * to pdTRUE.
 215:../src/FreeRTOS/timers.c ****  */
 216:../src/FreeRTOS/timers.c ****     static TickType_t prvGetNextExpireTime( BaseType_t * const pxListWasEmpty ) PRIVILEGED_FUNCTION
 217:../src/FreeRTOS/timers.c **** 
 218:../src/FreeRTOS/timers.c **** /*
 219:../src/FreeRTOS/timers.c ****  * If a timer has expired, process it.  Otherwise, block the timer service task
 220:../src/FreeRTOS/timers.c ****  * until either a timer does expire or a command is received.
 221:../src/FreeRTOS/timers.c ****  */
 222:../src/FreeRTOS/timers.c ****     static void prvProcessTimerOrBlockTask( const TickType_t xNextExpireTime,
 223:../src/FreeRTOS/timers.c ****                                             BaseType_t xListWasEmpty ) PRIVILEGED_FUNCTION;
 224:../src/FreeRTOS/timers.c **** 
 225:../src/FreeRTOS/timers.c **** /*
 226:../src/FreeRTOS/timers.c ****  * Called after a Timer_t structure has been allocated either statically or
 227:../src/FreeRTOS/timers.c ****  * Motionamically to fill in the structure's members.
 228:../src/FreeRTOS/timers.c ****  */
 229:../src/FreeRTOS/timers.c ****     static void prvInitialiseNewTimer( const char * const pcTimerName,
 230:../src/FreeRTOS/timers.c ****                                        const TickType_t xTimerPeriodInTicks,
 231:../src/FreeRTOS/timers.c ****                                        const BaseType_t xAutoReload,
 232:../src/FreeRTOS/timers.c ****                                        void * const pvTimerID,
 233:../src/FreeRTOS/timers.c ****                                        TimerCallbackFunction_t pxCallbackFunction,
 234:../src/FreeRTOS/timers.c ****                                        Timer_t * pxNewTimer ) PRIVILEGED_FUNCTION;
