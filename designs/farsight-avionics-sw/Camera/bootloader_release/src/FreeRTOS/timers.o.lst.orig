 591:../src/FreeRTOS/timers.c **** 
 592:../src/FreeRTOS/timers.c ****     BaseType_t xTimerGetReloadMode( TimerHandle_t xTimer )
 593:../src/FreeRTOS/timers.c ****     {
 594:../src/FreeRTOS/timers.c ****         Timer_t * pxTimer = xTimer;
 595:../src/FreeRTOS/timers.c ****         BaseType_t xReturn;
 596:../src/FreeRTOS/timers.c **** 
 597:../src/FreeRTOS/timers.c ****         traceENTER_xTimerGetReloadMode( xTimer );
 598:../src/FreeRTOS/timers.c **** 
 599:../src/FreeRTOS/timers.c ****         configASSERT( xTimer );
 600:../src/FreeRTOS/timers.c ****         portBASE_TYPE_ENTER_CRITICAL();
 601:../src/FreeRTOS/timers.c ****         {
 602:../src/FreeRTOS/timers.c ****             if( ( pxTimer->ucStatus & tmrSTATUS_IS_AUTORELOAD ) == 0U )
 603:../src/FreeRTOS/timers.c ****             {
 604:../src/FreeRTOS/timers.c ****                 /* Not an auto-reload timer. */
 605:../src/FreeRTOS/timers.c ****                 xReturn = pdFALSE;
 606:../src/FreeRTOS/timers.c ****             }
 607:../src/FreeRTOS/timers.c ****             else
 608:../src/FreeRTOS/timers.c ****             {
 609:../src/FreeRTOS/timers.c ****                 /* Is an auto-reload timer. */
 610:../src/FreeRTOS/timers.c ****                 xReturn = pdTRUE;
 611:../src/FreeRTOS/timers.c ****             }
