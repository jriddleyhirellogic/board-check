 713:../src/FreeRTOS/timers.c **** 
 714:../src/FreeRTOS/timers.c ****     static void prvProcessExpiredTimer( const TickType_t xNextExpireTime,
 715:../src/FreeRTOS/timers.c ****                                         const TickType_t xTimeNow )
 716:../src/FreeRTOS/timers.c ****     {
 717:../src/FreeRTOS/timers.c ****         /* MISRA Ref 11.5.3 [Void pointer assignment] */
 718:../src/FreeRTOS/timers.c ****         /* More details at: https://github.com/FreeRTOS/FreeRTOS-Kernel/blob/main/MISRA.md#rule-115
 719:../src/FreeRTOS/timers.c ****         /* coverity[misra_c_2012_rule_11_5_violation] */
 720:../src/FreeRTOS/timers.c ****         Timer_t * const pxTimer = ( Timer_t * ) listGET_OWNER_OF_HEAD_ENTRY( pxCurrentTimerList );
 721:../src/FreeRTOS/timers.c **** 
 722:../src/FreeRTOS/timers.c ****         /* Remove the timer from the list of active timers.  A check has already
 723:../src/FreeRTOS/timers.c ****          * been performed to ensure the list is not empty. */
 724:../src/FreeRTOS/timers.c **** 
 725:../src/FreeRTOS/timers.c ****         ( void ) uxListRemove( &( pxTimer->xTimerListItem ) );
 726:../src/FreeRTOS/timers.c **** 
 727:../src/FreeRTOS/timers.c ****         /* If the timer is an auto-reload timer then calculate the next
 728:../src/FreeRTOS/timers.c ****          * expiry time and re-insert the timer in the list of active timers. */
 729:../src/FreeRTOS/timers.c ****         if( ( pxTimer->ucStatus & tmrSTATUS_IS_AUTORELOAD ) != 0U )
 730:../src/FreeRTOS/timers.c ****         {
 731:../src/FreeRTOS/timers.c ****             prvReloadTimer( pxTimer, xNextExpireTime, xTimeNow );
 732:../src/FreeRTOS/timers.c ****         }
 733:../src/FreeRTOS/timers.c ****         else
 734:../src/FreeRTOS/timers.c ****         {
 735:../src/FreeRTOS/timers.c ****             pxTimer->ucStatus &= ( ( uint8_t ) ~tmrSTATUS_IS_ACTIVE );
 736:../src/FreeRTOS/timers.c ****         }
 737:../src/FreeRTOS/timers.c **** 
 738:../src/FreeRTOS/timers.c ****         /* Call the timer callback. */
 739:../src/FreeRTOS/timers.c ****         traceTIMER_EXPIRED( pxTimer );
 740:../src/FreeRTOS/timers.c ****         pxTimer->pxCallbackFunction( ( TimerHandle_t ) pxTimer );
 741:../src/FreeRTOS/timers.c ****     }
