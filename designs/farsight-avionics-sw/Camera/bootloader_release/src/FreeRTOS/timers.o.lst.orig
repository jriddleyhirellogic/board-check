 448:../src/FreeRTOS/timers.c ****     BaseType_t xTimerGenericCommandFromTask( TimerHandle_t xTimer,
 449:../src/FreeRTOS/timers.c ****                                              const BaseType_t xCommandID,
 450:../src/FreeRTOS/timers.c ****                                              const TickType_t xOptionalValue,
 451:../src/FreeRTOS/timers.c ****                                              BaseType_t * const pxHigherPriorityTaskWoken,
 452:../src/FreeRTOS/timers.c ****                                              const TickType_t xTicksToWait )
 453:../src/FreeRTOS/timers.c ****     {
 454:../src/FreeRTOS/timers.c ****         BaseType_t xReturn = pdFAIL;
 455:../src/FreeRTOS/timers.c ****         DaemonTaskMessage_t xMessage;
 456:../src/FreeRTOS/timers.c **** 
 457:../src/FreeRTOS/timers.c ****         ( void ) pxHigherPriorityTaskWoken;
 458:../src/FreeRTOS/timers.c **** 
 459:../src/FreeRTOS/timers.c ****         traceENTER_xTimerGenericCommandFromTask( xTimer, xCommandID, xOptionalValue, pxHigherPriori
 460:../src/FreeRTOS/timers.c **** 
 461:../src/FreeRTOS/timers.c ****         /* Send a message to the timer service task to perform a particular action
 462:../src/FreeRTOS/timers.c ****          * on a particular timer definition. */
 463:../src/FreeRTOS/timers.c ****         if( ( xTimerQueue != NULL ) && ( xTimer != NULL ) )
 464:../src/FreeRTOS/timers.c ****         {
 465:../src/FreeRTOS/timers.c ****             /* Send a command to the timer service task to start the xTimer timer. */
 466:../src/FreeRTOS/timers.c ****             xMessage.xMessageID = xCommandID;
 467:../src/FreeRTOS/timers.c ****             xMessage.u.xTimerParameters.xMessageValue = xOptionalValue;
 468:../src/FreeRTOS/timers.c ****             xMessage.u.xTimerParameters.pxTimer = xTimer;
 469:../src/FreeRTOS/timers.c **** 
 470:../src/FreeRTOS/timers.c ****             configASSERT( xCommandID < tmrFIRST_FROM_ISR_COMMAND );
 471:../src/FreeRTOS/timers.c **** 
 472:../src/FreeRTOS/timers.c ****             if( xCommandID < tmrFIRST_FROM_ISR_COMMAND )
 473:../src/FreeRTOS/timers.c ****             {
 474:../src/FreeRTOS/timers.c ****                 if( xTaskGetSchedulerState() == taskSCHEDULER_RUNNING )
 475:../src/FreeRTOS/timers.c ****                 {
 476:../src/FreeRTOS/timers.c ****                     xReturn = xQueueSendToBack( xTimerQueue, &xMessage, xTicksToWait );
 477:../src/FreeRTOS/timers.c ****                 }
 478:../src/FreeRTOS/timers.c ****                 else
 479:../src/FreeRTOS/timers.c ****                 {
 480:../src/FreeRTOS/timers.c ****                     xReturn = xQueueSendToBack( xTimerQueue, &xMessage, tmrNO_DELAY );
 481:../src/FreeRTOS/timers.c ****                 }
 482:../src/FreeRTOS/timers.c ****             }
 483:../src/FreeRTOS/timers.c **** 
 484:../src/FreeRTOS/timers.c ****             traceTIMER_COMMAND_SEND( xTimer, xCommandID, xOptionalValue, xReturn );
 485:../src/FreeRTOS/timers.c ****         }
 486:../src/FreeRTOS/timers.c ****         else
 487:../src/FreeRTOS/timers.c ****         {
 488:../src/FreeRTOS/timers.c ****             mtCOVERAGE_TEST_MARKER();
 489:../src/FreeRTOS/timers.c ****         }
 490:../src/FreeRTOS/timers.c **** 
 491:../src/FreeRTOS/timers.c ****         traceRETURN_xTimerGenericCommandFromTask( xReturn );
 492:../src/FreeRTOS/timers.c **** 
 493:../src/FreeRTOS/timers.c ****         return xReturn;
 494:../src/FreeRTOS/timers.c ****     }
