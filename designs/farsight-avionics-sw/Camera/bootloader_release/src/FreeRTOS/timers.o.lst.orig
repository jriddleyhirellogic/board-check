 242:../src/FreeRTOS/timers.c **** 
 243:../src/FreeRTOS/timers.c ****         /* This function is called when the scheduler is started if
 244:../src/FreeRTOS/timers.c ****          * configUSE_TIMERS is set to 1.  Check that the infrastructure used by the
 245:../src/FreeRTOS/timers.c ****          * timer service task has been created/initialised.  If timers have already
 246:../src/FreeRTOS/timers.c ****          * been created then the initialisation will already have been performed. */
 247:../src/FreeRTOS/timers.c ****         prvCheckForValidListAndQueue();
 248:../src/FreeRTOS/timers.c **** 
 249:../src/FreeRTOS/timers.c ****         if( xTimerQueue != NULL )
 250:../src/FreeRTOS/timers.c ****         {
 251:../src/FreeRTOS/timers.c ****             #if ( ( configNUMBER_OF_CORES > 1 ) && ( configUSE_CORE_AFFINITY == 1 ) )
 252:../src/FreeRTOS/timers.c ****             {
 253:../src/FreeRTOS/timers.c ****                 #if ( configSUPPORT_STATIC_ALLOCATION == 1 )
 254:../src/FreeRTOS/timers.c ****                 {
 255:../src/FreeRTOS/timers.c ****                     StaticTask_t * pxTimerTaskTCBBuffer = NULL;
 256:../src/FreeRTOS/timers.c ****                     StackType_t * pxTimerTaskStackBuffer = NULL;
 257:../src/FreeRTOS/timers.c ****                     configSTACK_DEPTH_TYPE uxTimerTaskStackSize;
 258:../src/FreeRTOS/timers.c **** 
 259:../src/FreeRTOS/timers.c ****                     vApplicationGetTimerTaskMemory( &pxTimerTaskTCBBuffer, &pxTimerTaskStackBuffer,
 260:../src/FreeRTOS/timers.c ****                     xTimerTaskHandle = xTaskCreateStaticAffinitySet( &prvTimerTask,
 261:../src/FreeRTOS/timers.c ****                                                                      configTIMER_SERVICE_TASK_NAME,
 262:../src/FreeRTOS/timers.c ****                                                                      uxTimerTaskStackSize,
 263:../src/FreeRTOS/timers.c ****                                                                      NULL,
 264:../src/FreeRTOS/timers.c ****                                                                      ( ( UBaseType_t ) configTIMER_
 265:../src/FreeRTOS/timers.c ****                                                                      pxTimerTaskStackBuffer,
 266:../src/FreeRTOS/timers.c ****                                                                      pxTimerTaskTCBBuffer,
 267:../src/FreeRTOS/timers.c ****                                                                      configTIMER_SERVICE_TASK_CORE_
 268:../src/FreeRTOS/timers.c **** 
 269:../src/FreeRTOS/timers.c ****                     if( xTimerTaskHandle != NULL )
 270:../src/FreeRTOS/timers.c ****                     {
 271:../src/FreeRTOS/timers.c ****                         xReturn = pdPASS;
 272:../src/FreeRTOS/timers.c ****                     }
 273:../src/FreeRTOS/timers.c ****                 }
 274:../src/FreeRTOS/timers.c ****                 #else /* if ( configSUPPORT_STATIC_ALLOCATION == 1 ) */
 275:../src/FreeRTOS/timers.c ****                 {
 276:../src/FreeRTOS/timers.c ****                     xReturn = xTaskCreateAffinitySet( &prvTimerTask,
 277:../src/FreeRTOS/timers.c ****                                                       configTIMER_SERVICE_TASK_NAME,
 278:../src/FreeRTOS/timers.c ****                                                       configTIMER_TASK_STACK_DEPTH,
 279:../src/FreeRTOS/timers.c ****                                                       NULL,
 280:../src/FreeRTOS/timers.c ****                                                       ( ( UBaseType_t ) configTIMER_TASK_PRIORITY )
 281:../src/FreeRTOS/timers.c ****                                                       configTIMER_SERVICE_TASK_CORE_AFFINITY,
 282:../src/FreeRTOS/timers.c ****                                                       &xTimerTaskHandle );
 283:../src/FreeRTOS/timers.c ****                 }
 284:../src/FreeRTOS/timers.c ****                 #endif /* configSUPPORT_STATIC_ALLOCATION */
 285:../src/FreeRTOS/timers.c ****             }
