1099:../src/FreeRTOS/timers.c ****         {
1100:../src/FreeRTOS/timers.c ****             xNextExpireTime = listGET_ITEM_VALUE_OF_HEAD_ENTRY( pxCurrentTimerList );
1101:../src/FreeRTOS/timers.c **** 
1102:../src/FreeRTOS/timers.c ****             /* Process the expired timer.  For auto-reload timers, be careful to
1103:../src/FreeRTOS/timers.c ****              * process only expirations that occur on the current list.  Further
1104:../src/FreeRTOS/timers.c ****              * expirations must wait until after the lists are switched. */
1105:../src/FreeRTOS/timers.c ****             prvProcessExpiredTimer( xNextExpireTime, tmrMAX_TIME_BEFORE_OVERFLOW );
1106:../src/FreeRTOS/timers.c ****         }
1107:../src/FreeRTOS/timers.c **** 
1108:../src/FreeRTOS/timers.c ****         pxTemp = pxCurrentTimerList;
1109:../src/FreeRTOS/timers.c ****         pxCurrentTimerList = pxOverflowTimerList;
1110:../src/FreeRTOS/timers.c ****         pxOverflowTimerList = pxTemp;
1111:../src/FreeRTOS/timers.c ****     }
