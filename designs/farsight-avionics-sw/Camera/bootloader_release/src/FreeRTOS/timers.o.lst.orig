 100:../src/FreeRTOS/timers.c **** /* The definition of messages that can be sent and received on the timer queue.
 101:../src/FreeRTOS/timers.c ****  * Two types of message can be queued - messages that manipulate a software timer,
 102:../src/FreeRTOS/timers.c ****  * and messages that request the execution of a non-timer related callback.  The
 103:../src/FreeRTOS/timers.c ****  * two message types are defined in two separate structures, xTimerParametersType
 104:../src/FreeRTOS/timers.c ****  * and xCallbackParametersType respectively. */
 105:../src/FreeRTOS/timers.c ****     typedef struct tmrTimerParameters
 106:../src/FreeRTOS/timers.c ****     {
 107:../src/FreeRTOS/timers.c ****         TickType_t xMessageValue; /**< An optional value used by a subset of commands, for example,
 108:../src/FreeRTOS/timers.c ****         Timer_t * pxTimer;        /**< The timer to which the command will be applied. */
 109:../src/FreeRTOS/timers.c ****     } TimerParameter_t;
 110:../src/FreeRTOS/timers.c **** 
 111:../src/FreeRTOS/timers.c **** 
 112:../src/FreeRTOS/timers.c ****     typedef struct tmrCallbackParameters
 113:../src/FreeRTOS/timers.c ****     {
 114:../src/FreeRTOS/timers.c ****         portTIMER_CALLBACK_ATTRIBUTE
 115:../src/FreeRTOS/timers.c ****         PendedFunction_t pxCallbackFunction; /* << The callback function to execute. */
 116:../src/FreeRTOS/timers.c ****         void * pvParameter1;                 /* << The value that will be used as the callback func
 117:../src/FreeRTOS/timers.c ****         uint32_t ulParameter2;               /* << The value that will be used as the callback func
 118:../src/FreeRTOS/timers.c ****     } CallbackParameters_t;
 119:../src/FreeRTOS/timers.c **** 
 120:../src/FreeRTOS/timers.c **** /* The structure that contains the two message types, along with an identifier
 121:../src/FreeRTOS/timers.c ****  * that is used to determine which message type is valid. */
 122:../src/FreeRTOS/timers.c ****     typedef struct tmrTimerQueueMessage
 123:../src/FreeRTOS/timers.c ****     {
 124:../src/FreeRTOS/timers.c ****         BaseType_t xMessageID; /**< The command being sent to the timer service task. */
 125:../src/FreeRTOS/timers.c ****         union
 126:../src/FreeRTOS/timers.c ****         {
 127:../src/FreeRTOS/timers.c ****             TimerParameter_t xTimerParameters;
 128:../src/FreeRTOS/timers.c **** 
 129:../src/FreeRTOS/timers.c ****             /* Don't include xCallbackParameters if it is not going to be used as
 130:../src/FreeRTOS/timers.c ****              * it makes the structure (and therefore the timer queue) larger. */
 131:../src/FreeRTOS/timers.c ****             #if ( INCLUDE_xTimerPendFunctionCall == 1 )
 132:../src/FreeRTOS/timers.c ****                 CallbackParameters_t xCallbackParameters;
 133:../src/FreeRTOS/timers.c ****             #endif /* INCLUDE_xTimerPendFunctionCall */
 134:../src/FreeRTOS/timers.c ****         } u;
 135:../src/FreeRTOS/timers.c ****     } DaemonTaskMessage_t;
 136:../src/FreeRTOS/timers.c **** 
 137:../src/FreeRTOS/timers.c **** /* The list in which active timers are stored.  Timers are referenced in expire
 138:../src/FreeRTOS/timers.c ****  * time order, with the nearest expiry time at the front of the list.  Only the
 139:../src/FreeRTOS/timers.c ****  * timer service task is allowed to access these lists.
 140:../src/FreeRTOS/timers.c ****  * xActiveTimerList1 and xActiveTimerList2 could be at function scope but that
 141:../src/FreeRTOS/timers.c ****  * breaks some kernel aware debuggers, and debuggers that reply on removing the
 142:../src/FreeRTOS/timers.c ****  * static qualifier. */
 143:../src/FreeRTOS/timers.c ****     PRIVILEGED_DATA static List_t xActiveTimerList1;
 144:../src/FreeRTOS/timers.c ****     PRIVILEGED_DATA static List_t xActiveTimerList2;
 145:../src/FreeRTOS/timers.c ****     PRIVILEGED_DATA static List_t * pxCurrentTimerList;
 146:../src/FreeRTOS/timers.c ****     PRIVILEGED_DATA static List_t * pxOverflowTimerList;
 147:../src/FreeRTOS/timers.c **** 
 148:../src/FreeRTOS/timers.c **** /* A queue that is used to send commands to the timer service task. */
 149:../src/FreeRTOS/timers.c ****     PRIVILEGED_DATA static QueueHandle_t xTimerQueue = NULL;
 150:../src/FreeRTOS/timers.c ****     PRIVILEGED_DATA static TaskHandle_t xTimerTaskHandle = NULL;
