 582:../src/FreeRTOS/timers.c ****             {
 583:../src/FreeRTOS/timers.c ****                 pxTimer->ucStatus &= ( ( uint8_t ) ~tmrSTATUS_IS_AUTORELOAD );
 584:../src/FreeRTOS/timers.c ****             }
