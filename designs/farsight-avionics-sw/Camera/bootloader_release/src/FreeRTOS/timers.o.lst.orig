 743:../src/FreeRTOS/timers.c **** 
 744:../src/FreeRTOS/timers.c ****     static portTASK_FUNCTION( prvTimerTask, pvParameters )
 745:../src/FreeRTOS/timers.c ****     {
 746:../src/FreeRTOS/timers.c ****         TickType_t xNextExpireTime;
 747:../src/FreeRTOS/timers.c ****         BaseType_t xListWasEmpty;
 748:../src/FreeRTOS/timers.c **** 
 749:../src/FreeRTOS/timers.c ****         /* Just to avoid compiler warnings. */
 750:../src/FreeRTOS/timers.c ****         ( void ) pvParameters;
 751:../src/FreeRTOS/timers.c **** 
 752:../src/FreeRTOS/timers.c ****         #if ( configUSE_DAEMON_TASK_STARTUP_HOOK == 1 )
 753:../src/FreeRTOS/timers.c ****         {
 754:../src/FreeRTOS/timers.c ****             /* Allow the application writer to execute some code in the context of
 755:../src/FreeRTOS/timers.c ****              * this task at the point the task starts executing.  This is useful if the
 756:../src/FreeRTOS/timers.c ****              * application includes initialisation code that would benefit from
 757:../src/FreeRTOS/timers.c ****              * executing after the scheduler has been started. */
 758:../src/FreeRTOS/timers.c ****             vApplicationDaemonTaskStartupHook();
 759:../src/FreeRTOS/timers.c ****         }
 760:../src/FreeRTOS/timers.c ****         #endif /* configUSE_DAEMON_TASK_STARTUP_HOOK */
 761:../src/FreeRTOS/timers.c **** 
 762:../src/FreeRTOS/timers.c ****         for( ; configCONTROL_INFINITE_LOOP(); )
 763:../src/FreeRTOS/timers.c ****         {
 764:../src/FreeRTOS/timers.c ****             /* Query the timers list to see if it contains any timers, and if so,
 765:../src/FreeRTOS/timers.c ****              * obtain the time at which the next timer will expire. */
 766:../src/FreeRTOS/timers.c ****             xNextExpireTime = prvGetNextExpireTime( &xListWasEmpty );
 767:../src/FreeRTOS/timers.c **** 
 768:../src/FreeRTOS/timers.c ****             /* If a timer has expired, process it.  Otherwise, block this task
 769:../src/FreeRTOS/timers.c ****              * until either a timer does expire, or a command is received. */
 770:../src/FreeRTOS/timers.c ****             prvProcessTimerOrBlockTask( xNextExpireTime, xListWasEmpty );
 771:../src/FreeRTOS/timers.c **** 
 772:../src/FreeRTOS/timers.c ****             /* Empty the command queue. */
 773:../src/FreeRTOS/timers.c ****             prvProcessReceivedCommands();
 774:../src/FreeRTOS/timers.c ****         }
 775:../src/FreeRTOS/timers.c ****     }
 776:../src/FreeRTOS/timers.c **** /*-----------------------------------------------------------*/
 777:../src/FreeRTOS/timers.c **** 
 778:../src/FreeRTOS/timers.c ****     static void prvProcessTimerOrBlockTask( const TickType_t xNextExpireTime,
 779:../src/FreeRTOS/timers.c ****                                             BaseType_t xListWasEmpty )
 780:../src/FreeRTOS/timers.c ****     {
 781:../src/FreeRTOS/timers.c ****         TickType_t xTimeNow;
 782:../src/FreeRTOS/timers.c ****         BaseType_t xTimerListsWereSwitched;
 783:../src/FreeRTOS/timers.c **** 
 784:../src/FreeRTOS/timers.c ****         vTaskSuspendAll();
 785:../src/FreeRTOS/timers.c ****         {
 786:../src/FreeRTOS/timers.c ****             /* Obtain the time now to make an assessment as to whether the timer
 787:../src/FreeRTOS/timers.c ****              * has expired or not.  If obtaining the time causes the lists to switch
 788:../src/FreeRTOS/timers.c ****              * then don't process this timer as any timers that remained in the list
 789:../src/FreeRTOS/timers.c ****              * when the lists were switched will have been processed within the
 790:../src/FreeRTOS/timers.c ****              * prvSampleTimeNow() function. */
 791:../src/FreeRTOS/timers.c ****             xTimeNow = prvSampleTimeNow( &xTimerListsWereSwitched );
 792:../src/FreeRTOS/timers.c **** 
 793:../src/FreeRTOS/timers.c ****             if( xTimerListsWereSwitched == pdFALSE )
 794:../src/FreeRTOS/timers.c ****             {
 795:../src/FreeRTOS/timers.c ****                 /* The tick count has not overflowed, has the timer expired? */
 796:../src/FreeRTOS/timers.c ****                 if( ( xListWasEmpty == pdFALSE ) && ( xNextExpireTime <= xTimeNow ) )
 797:../src/FreeRTOS/timers.c ****                 {
 798:../src/FreeRTOS/timers.c ****                     ( void ) xTaskResumeAll();
 799:../src/FreeRTOS/timers.c ****                     prvProcessExpiredTimer( xNextExpireTime, xTimeNow );
 800:../src/FreeRTOS/timers.c ****                 }
 801:../src/FreeRTOS/timers.c ****                 else
 802:../src/FreeRTOS/timers.c ****                 {
 803:../src/FreeRTOS/timers.c ****                     /* The tick count has not overflowed, and the next expire
 804:../src/FreeRTOS/timers.c ****                      * time has not been reached yet.  This task should therefore
 805:../src/FreeRTOS/timers.c ****                      * block to wait for the next expire time or a command to be
 806:../src/FreeRTOS/timers.c ****                      * received - whichever comes first.  The following line cannot
 807:../src/FreeRTOS/timers.c ****                      * be reached unless xNextExpireTime > xTimeNow, except in the
 808:../src/FreeRTOS/timers.c ****                      * case when the current timer list is empty. */
 809:../src/FreeRTOS/timers.c ****                     if( xListWasEmpty != pdFALSE )
 810:../src/FreeRTOS/timers.c ****                     {
 811:../src/FreeRTOS/timers.c ****                         /* The current timer list is empty - is the overflow list
 812:../src/FreeRTOS/timers.c ****                          * also empty? */
 813:../src/FreeRTOS/timers.c ****                         xListWasEmpty = listLIST_IS_EMPTY( pxOverflowTimerList );
 814:../src/FreeRTOS/timers.c ****                     }
 815:../src/FreeRTOS/timers.c **** 
 816:../src/FreeRTOS/timers.c ****                     vQueueWaitForMessageRestricted( xTimerQueue, ( xNextExpireTime - xTimeNow ), xL
 817:../src/FreeRTOS/timers.c **** 
 818:../src/FreeRTOS/timers.c ****                     if( xTaskResumeAll() == pdFALSE )
 819:../src/FreeRTOS/timers.c ****                     {
 820:../src/FreeRTOS/timers.c ****                         /* Yield to wait for either a command to arrive, or the
 821:../src/FreeRTOS/timers.c ****                          * block time to expire.  If a command arrived between the
 822:../src/FreeRTOS/timers.c ****                          * critical section being exited and this yield then the yield
 823:../src/FreeRTOS/timers.c ****                          * will not cause the task to block. */
 824:../src/FreeRTOS/timers.c ****                         taskYIELD_WITHIN_API(); //IRB ecall instruction results in synchronous exce
 825:../src/FreeRTOS/timers.c ****                     }
 826:../src/FreeRTOS/timers.c ****                     else
 827:../src/FreeRTOS/timers.c ****                     {
 828:../src/FreeRTOS/timers.c ****                         mtCOVERAGE_TEST_MARKER();
 829:../src/FreeRTOS/timers.c ****                     }
 830:../src/FreeRTOS/timers.c ****                 }
 831:../src/FreeRTOS/timers.c ****             }
 832:../src/FreeRTOS/timers.c ****             else
 833:../src/FreeRTOS/timers.c ****             {
 834:../src/FreeRTOS/timers.c ****                 ( void ) xTaskResumeAll();
 835:../src/FreeRTOS/timers.c ****             }
 836:../src/FreeRTOS/timers.c ****         }
 837:../src/FreeRTOS/timers.c ****     }
 838:../src/FreeRTOS/timers.c **** /*-----------------------------------------------------------*/
 839:../src/FreeRTOS/timers.c **** 
 840:../src/FreeRTOS/timers.c ****     static TickType_t prvGetNextExpireTime( BaseType_t * const pxListWasEmpty )
 841:../src/FreeRTOS/timers.c ****     {
 842:../src/FreeRTOS/timers.c ****         TickType_t xNextExpireTime;
 843:../src/FreeRTOS/timers.c **** 
 844:../src/FreeRTOS/timers.c ****         /* Timers are listed in expiry time order, with the head of the list
 845:../src/FreeRTOS/timers.c ****          * referencing the task that will expire first.  Obtain the time at which
 846:../src/FreeRTOS/timers.c ****          * the timer with the nearest expiry time will expire.  If there are no
 847:../src/FreeRTOS/timers.c ****          * active timers then just set the next expire time to 0.  That will cause
 848:../src/FreeRTOS/timers.c ****          * this task to unblock when the tick count overflows, at which point the
 849:../src/FreeRTOS/timers.c ****          * timer lists will be switched and the next expiry time can be
 850:../src/FreeRTOS/timers.c ****          * re-assessed.  */
 851:../src/FreeRTOS/timers.c ****         *pxListWasEmpty = listLIST_IS_EMPTY( pxCurrentTimerList );
 852:../src/FreeRTOS/timers.c **** 
 853:../src/FreeRTOS/timers.c ****         if( *pxListWasEmpty == pdFALSE )
 854:../src/FreeRTOS/timers.c ****         {
 855:../src/FreeRTOS/timers.c ****             xNextExpireTime = listGET_ITEM_VALUE_OF_HEAD_ENTRY( pxCurrentTimerList );
 856:../src/FreeRTOS/timers.c ****         }
 857:../src/FreeRTOS/timers.c ****         else
 858:../src/FreeRTOS/timers.c ****         {
 859:../src/FreeRTOS/timers.c ****             /* Ensure the task unblocks when the tick count rolls over. */
 860:../src/FreeRTOS/timers.c ****             xNextExpireTime = ( TickType_t ) 0U;
 861:../src/FreeRTOS/timers.c ****         }
 862:../src/FreeRTOS/timers.c **** 
 863:../src/FreeRTOS/timers.c ****         return xNextExpireTime;
 864:../src/FreeRTOS/timers.c ****     }
 865:../src/FreeRTOS/timers.c **** /*-----------------------------------------------------------*/
 866:../src/FreeRTOS/timers.c **** 
 867:../src/FreeRTOS/timers.c ****     static TickType_t prvSampleTimeNow( BaseType_t * const pxTimerListsWereSwitched )
 868:../src/FreeRTOS/timers.c ****     {
 869:../src/FreeRTOS/timers.c ****         TickType_t xTimeNow;
 870:../src/FreeRTOS/timers.c ****         PRIVILEGED_DATA static TickType_t xLastTime = ( TickType_t ) 0U;
 871:../src/FreeRTOS/timers.c **** 
 872:../src/FreeRTOS/timers.c ****         xTimeNow = xTaskGetTickCount();
 873:../src/FreeRTOS/timers.c **** 
 874:../src/FreeRTOS/timers.c ****         if( xTimeNow < xLastTime )
 875:../src/FreeRTOS/timers.c ****         {
 876:../src/FreeRTOS/timers.c ****             prvSwitchTimerLists();
 877:../src/FreeRTOS/timers.c ****             *pxTimerListsWereSwitched = pdTRUE;
 878:../src/FreeRTOS/timers.c ****         }
 879:../src/FreeRTOS/timers.c ****         else
 880:../src/FreeRTOS/timers.c ****         {
 881:../src/FreeRTOS/timers.c ****             *pxTimerListsWereSwitched = pdFALSE;
 882:../src/FreeRTOS/timers.c ****         }
 883:../src/FreeRTOS/timers.c **** 
 884:../src/FreeRTOS/timers.c ****         xLastTime = xTimeNow;
 885:../src/FreeRTOS/timers.c **** 
 886:../src/FreeRTOS/timers.c ****         return xTimeNow;
 887:../src/FreeRTOS/timers.c ****     }
 888:../src/FreeRTOS/timers.c **** /*-----------------------------------------------------------*/
 889:../src/FreeRTOS/timers.c **** 
 890:../src/FreeRTOS/timers.c ****     static BaseType_t prvInsertTimerInActiveList( Timer_t * const pxTimer,
 891:../src/FreeRTOS/timers.c ****                                                   const TickType_t xNextExpiryTime,
 892:../src/FreeRTOS/timers.c ****                                                   const TickType_t xTimeNow,
 893:../src/FreeRTOS/timers.c ****                                                   const TickType_t xCommandTime )
 894:../src/FreeRTOS/timers.c ****     {
 895:../src/FreeRTOS/timers.c ****         BaseType_t xProcessTimerNow = pdFALSE;
 896:../src/FreeRTOS/timers.c **** 
 897:../src/FreeRTOS/timers.c ****         listSET_LIST_ITEM_VALUE( &( pxTimer->xTimerListItem ), xNextExpiryTime );
 898:../src/FreeRTOS/timers.c ****         listSET_LIST_ITEM_OWNER( &( pxTimer->xTimerListItem ), pxTimer );
 899:../src/FreeRTOS/timers.c **** 
 900:../src/FreeRTOS/timers.c ****         if( xNextExpiryTime <= xTimeNow )
 901:../src/FreeRTOS/timers.c ****         {
 902:../src/FreeRTOS/timers.c ****             /* Has the expiry time elapsed between the command to start/reset a
 903:../src/FreeRTOS/timers.c ****              * timer was issued, and the time the command was processed? */
 904:../src/FreeRTOS/timers.c ****             if( ( ( TickType_t ) ( xTimeNow - xCommandTime ) ) >= pxTimer->xTimerPeriodInTicks )
 905:../src/FreeRTOS/timers.c ****             {
 906:../src/FreeRTOS/timers.c ****                 /* The time between a command being issued and the command being
 907:../src/FreeRTOS/timers.c ****                  * processed actually exceeds the timers period.  */
 908:../src/FreeRTOS/timers.c ****                 xProcessTimerNow = pdTRUE;
 909:../src/FreeRTOS/timers.c ****             }
 910:../src/FreeRTOS/timers.c ****             else
 911:../src/FreeRTOS/timers.c ****             {
 912:../src/FreeRTOS/timers.c ****                 vListInsert( pxOverflowTimerList, &( pxTimer->xTimerListItem ) );
 913:../src/FreeRTOS/timers.c ****             }
 914:../src/FreeRTOS/timers.c ****         }
 915:../src/FreeRTOS/timers.c ****         else
 916:../src/FreeRTOS/timers.c ****         {
 917:../src/FreeRTOS/timers.c ****             if( ( xTimeNow < xCommandTime ) && ( xNextExpiryTime >= xCommandTime ) )
 918:../src/FreeRTOS/timers.c ****             {
 919:../src/FreeRTOS/timers.c ****                 /* If, since the command was issued, the tick count has overflowed
 920:../src/FreeRTOS/timers.c ****                  * but the expiry time has not, then the timer must have already passed
 921:../src/FreeRTOS/timers.c ****                  * its expiry time and should be processed immediately. */
 922:../src/FreeRTOS/timers.c ****                 xProcessTimerNow = pdTRUE;
 923:../src/FreeRTOS/timers.c ****             }
 924:../src/FreeRTOS/timers.c ****             else
 925:../src/FreeRTOS/timers.c ****             {
