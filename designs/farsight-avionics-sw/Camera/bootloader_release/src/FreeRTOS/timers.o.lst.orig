 694:../src/FreeRTOS/timers.c **** 
 695:../src/FreeRTOS/timers.c ****     static void prvReloadTimer( Timer_t * const pxTimer,
 696:../src/FreeRTOS/timers.c ****                                 TickType_t xExpiredTime,
 697:../src/FreeRTOS/timers.c ****                                 const TickType_t xTimeNow )
 698:../src/FreeRTOS/timers.c ****     {
 699:../src/FreeRTOS/timers.c ****         /* Insert the timer into the appropriate list for the next expiry time.
 700:../src/FreeRTOS/timers.c ****          * If the next expiry time has already passed, advance the expiry time,
 701:../src/FreeRTOS/timers.c ****          * call the callback function, and try again. */
 702:../src/FreeRTOS/timers.c ****         while( prvInsertTimerInActiveList( pxTimer, ( xExpiredTime + pxTimer->xTimerPeriodInTicks )
 703:../src/FreeRTOS/timers.c ****         {
 704:../src/FreeRTOS/timers.c ****             /* Advance the expiry time. */
 705:../src/FreeRTOS/timers.c ****             xExpiredTime += pxTimer->xTimerPeriodInTicks;
 706:../src/FreeRTOS/timers.c **** 
 707:../src/FreeRTOS/timers.c ****             /* Call the timer callback. */
 708:../src/FreeRTOS/timers.c ****             traceTIMER_EXPIRED( pxTimer );
 709:../src/FreeRTOS/timers.c ****             pxTimer->pxCallbackFunction( ( TimerHandle_t ) pxTimer );
 710:../src/FreeRTOS/timers.c ****         }
 711:../src/FreeRTOS/timers.c ****     }
