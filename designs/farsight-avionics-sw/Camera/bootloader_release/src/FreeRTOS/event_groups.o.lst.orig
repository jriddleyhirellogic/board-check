 270:../src/FreeRTOS/event_groups.c ****                 taskENTER_CRITICAL();
 271:../src/FreeRTOS/event_groups.c ****                 {
 272:../src/FreeRTOS/event_groups.c ****                     uxReturn = pxEventBits->uxEventBits;
 273:../src/FreeRTOS/event_groups.c **** 
 274:../src/FreeRTOS/event_groups.c ****                     /* Although the task got here because it timed out before the
 275:../src/FreeRTOS/event_groups.c ****                      * bits it was waiting for were set, it is possible that since it
 276:../src/FreeRTOS/event_groups.c ****                      * unblocked another task has set the bits.  If this is the case
 277:../src/FreeRTOS/event_groups.c ****                      * then it needs to clear the bits before exiting. */
 278:../src/FreeRTOS/event_groups.c ****                     if( ( uxReturn & uxBitsToWaitFor ) == uxBitsToWaitFor )
 279:../src/FreeRTOS/event_groups.c ****                     {
 280:../src/FreeRTOS/event_groups.c ****                         pxEventBits->uxEventBits &= ~uxBitsToWaitFor;
 281:../src/FreeRTOS/event_groups.c ****                     }
 282:../src/FreeRTOS/event_groups.c ****                     else
 283:../src/FreeRTOS/event_groups.c ****                     {
 284:../src/FreeRTOS/event_groups.c ****                         mtCOVERAGE_TEST_MARKER();
 285:../src/FreeRTOS/event_groups.c ****                     }
 286:../src/FreeRTOS/event_groups.c ****                 }
 287:../src/FreeRTOS/event_groups.c ****                 taskEXIT_CRITICAL();
 288:../src/FreeRTOS/event_groups.c **** 
 289:../src/FreeRTOS/event_groups.c ****                 xTimeoutOccurred = pdTRUE;
 290:../src/FreeRTOS/event_groups.c ****             }
 291:../src/FreeRTOS/event_groups.c ****             else
 292:../src/FreeRTOS/event_groups.c ****             {
 293:../src/FreeRTOS/event_groups.c ****                 /* The task unblocked because the bits were set. */
 294:../src/FreeRTOS/event_groups.c ****             }
 295:../src/FreeRTOS/event_groups.c **** 
 296:../src/FreeRTOS/event_groups.c ****             /* Control bits might be set as the task had blocked should not be
 297:../src/FreeRTOS/event_groups.c ****              * returned. */
 298:../src/FreeRTOS/event_groups.c ****             uxReturn &= ~eventEVENT_BITS_CONTROL_BYTES;
 299:../src/FreeRTOS/event_groups.c ****         }
 300:../src/FreeRTOS/event_groups.c **** 
 301:../src/FreeRTOS/event_groups.c ****         traceEVENT_GROUP_SYNC_END( xEventGroup, uxBitsToSet, uxBitsToWaitFor, xTimeoutOccurred );
 302:../src/FreeRTOS/event_groups.c **** 
 303:../src/FreeRTOS/event_groups.c ****         /* Prevent compiler warnings when trace macros are not used. */
 304:../src/FreeRTOS/event_groups.c ****         ( void ) xTimeoutOccurred;
 305:../src/FreeRTOS/event_groups.c **** 
 306:../src/FreeRTOS/event_groups.c ****         traceRETURN_xEventGroupSync( uxReturn );
 307:../src/FreeRTOS/event_groups.c **** 
 308:../src/FreeRTOS/event_groups.c ****         return uxReturn;
 309:../src/FreeRTOS/event_groups.c ****     }
