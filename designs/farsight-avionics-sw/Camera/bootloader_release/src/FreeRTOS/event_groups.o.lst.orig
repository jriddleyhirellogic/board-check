  70:../src/FreeRTOS/event_groups.c **** /*
  71:../src/FreeRTOS/event_groups.c ****  * Test the bits set in uxCurrentEventBits to see if the wait condition is met.
  72:../src/FreeRTOS/event_groups.c ****  * The wait condition is defined by xWaitForAllBits.  If xWaitForAllBits is
  73:../src/FreeRTOS/event_groups.c ****  * pdTRUE then the wait condition is met if all the bits set in uxBitsToWaitFor
  74:../src/FreeRTOS/event_groups.c ****  * are also set in uxCurrentEventBits.  If xWaitForAllBits is pdFALSE then the
  75:../src/FreeRTOS/event_groups.c ****  * wait condition is met if any of the bits set in uxBitsToWait for are also set
  76:../src/FreeRTOS/event_groups.c ****  * in uxCurrentEventBits.
  77:../src/FreeRTOS/event_groups.c ****  */
  78:../src/FreeRTOS/event_groups.c ****     static BaseType_t prvTestWaitCondition( const EventBits_t uxCurrentEventBits,
  79:../src/FreeRTOS/event_groups.c ****                                             const EventBits_t uxBitsToWaitFor,
  80:../src/FreeRTOS/event_groups.c ****                                             const BaseType_t xWaitForAllBits ) PRIVILEGED_FUNCTION;
