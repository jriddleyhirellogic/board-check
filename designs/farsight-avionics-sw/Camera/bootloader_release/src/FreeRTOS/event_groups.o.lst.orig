 198:../src/FreeRTOS/event_groups.c ****         configASSERT( uxBitsToWaitFor != 0 );
 199:../src/FreeRTOS/event_groups.c ****         #if ( ( INCLUDE_xTaskGetSchedulerState == 1 ) || ( configUSE_TIMERS == 1 ) )
 200:../src/FreeRTOS/event_groups.c ****         {
 201:../src/FreeRTOS/event_groups.c ****             configASSERT( !( ( xTaskGetSchedulerState() == taskSCHEDULER_SUSPENDED ) && ( xTicksToW
 202:../src/FreeRTOS/event_groups.c ****         }
 203:../src/FreeRTOS/event_groups.c ****         #endif
 204:../src/FreeRTOS/event_groups.c **** 
 205:../src/FreeRTOS/event_groups.c ****         vTaskSuspendAll();
 206:../src/FreeRTOS/event_groups.c ****         {
 207:../src/FreeRTOS/event_groups.c ****             uxOriginalBitValue = pxEventBits->uxEventBits;
 208:../src/FreeRTOS/event_groups.c **** 
 209:../src/FreeRTOS/event_groups.c ****             ( void ) xEventGroupSetBits( xEventGroup, uxBitsToSet );
 210:../src/FreeRTOS/event_groups.c **** 
 211:../src/FreeRTOS/event_groups.c ****             if( ( ( uxOriginalBitValue | uxBitsToSet ) & uxBitsToWaitFor ) == uxBitsToWaitFor )
 212:../src/FreeRTOS/event_groups.c ****             {
 213:../src/FreeRTOS/event_groups.c ****                 /* All the rendezvous bits are now set - no need to block. */
 214:../src/FreeRTOS/event_groups.c ****                 uxReturn = ( uxOriginalBitValue | uxBitsToSet );
