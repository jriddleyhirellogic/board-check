 260:../src/FreeRTOS/event_groups.c **** 
 261:../src/FreeRTOS/event_groups.c ****             /* The task blocked to wait for its required bits to be set - at this
 262:../src/FreeRTOS/event_groups.c ****              * point either the required bits were set or the block time expired.  If
 263:../src/FreeRTOS/event_groups.c ****              * the required bits were set they will have been stored in the task's
 264:../src/FreeRTOS/event_groups.c ****              * event list item, and they should now be retrieved then cleared. */
 265:../src/FreeRTOS/event_groups.c ****             uxReturn = uxTaskResetEventItemValue();
 266:../src/FreeRTOS/event_groups.c **** 
 267:../src/FreeRTOS/event_groups.c ****             if( ( uxReturn & eventUNBLOCKED_DUE_TO_BIT_SET ) == ( EventBits_t ) 0 )
 268:../src/FreeRTOS/event_groups.c ****             {
