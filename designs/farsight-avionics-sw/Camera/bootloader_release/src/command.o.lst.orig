  89:../src/command.c ****     v_Set_Error_Code( NO_ERROR, p_Response_Buffer );  // start assuming no error
  90:../src/command.c ****     Get_Camera_State( &u8_Current_Camera_State );
  91:../src/command.c **** 
  92:../src/command.c ****     switch( p_Header->u8_Opcode )
  93:../src/command.c ****     {
  94:../src/command.c ****     case GET_VERSION_SYS_CMD:
  95:../src/command.c ****         u32_Arg = SYS_VERSION;
  96:../src/command.c ****         v_Add_Response_Data( &u32_Arg, sizeof(&u32_Arg), p_Response_Buffer );
  97:../src/command.c ****         break;
  98:../src/command.c **** 
  99:../src/command.c ****     case SET_MODE_SYS_CMD:    // Forces changes to camera mode
 100:../src/command.c ****         // ICD only allows certain mode changes
 101:../src/command.c ****         u32_Arg = *p_u8_Data;
 102:../src/command.c ****           // Can check if commanded mode change is legal
 103:../src/command.c ****         switch(u32_Arg)    // Requested state
 104:../src/command.c ****         {
 105:../src/command.c ****         case CAMERA_LP_STATE:                          // can transition from any state
 106:../src/command.c ****             b_Mode_Switch_Legal = (u8_Current_Camera_State & ALL_CAMERA_STATES);
 107:../src/command.c ****           break;
 108:../src/command.c **** 
 109:../src/command.c ****         case CAMERA_IDLE_STATE:
 110:../src/command.c ****             b_Mode_Switch_Legal = (u8_Current_Camera_State & (CAMERA_LP_STATE    |
 111:../src/command.c ****                                                               CAMERA_IDLE_STATE  |
 112:../src/command.c ****                                                               CAMERA_ARMED_STATE));
 113:../src/command.c ****             break;
 114:../src/command.c ****         case CAMERA_ARMED_STATE:
 115:../src/command.c ****             b_Mode_Switch_Legal = (u8_Current_Camera_State & (CAMERA_IDLE_STATE));
 116:../src/command.c ****             break;
 117:../src/command.c ****         case CAMERA_BUSY_STATE:    // fallthrough intentional, can't be directly requested
 118:../src/command.c ****         case CAMERA_FAULT_STATE:
 119:../src/command.c ****           break;
 120:../src/command.c ****         default:
 121:../src/command.c ****             break;
 122:../src/command.c ****         }
 123:../src/command.c ****         if(b_Mode_Switch_Legal != 0 )
 124:../src/command.c ****         {
 125:../src/command.c **** 
 126:../src/command.c ****             event.mode_set.sig = CAMERA_MODE_SET;
 127:../src/command.c ****             event.mode_set.u8_Mode = u32_Arg;
 128:../src/command.c ****             v_Post_Camera_Event( &event );
 129:../src/command.c ****         }
 130:../src/command.c ****         else
 131:../src/command.c ****         {
 132:../src/command.c ****             v_Set_Error_Code( ERR_CMD_INVALID_MODE, p_Response_Buffer );
 133:../src/command.c ****         }
 134:../src/command.c ****         break;
 135:../src/command.c **** 
 136:../src/command.c ****     case RESET_SYS_CMD:
 137:../src/command.c ****         // System reset
 138:../src/command.c ****         event.no_data.sig = RESET_RECEIVED;
 139:../src/command.c ****         v_Post_System_Event( &event );
 140:../src/command.c **** 
 141:../src/command.c ****         // Camera reset
 142:../src/command.c ****         event.no_data.sig = RESET_RECEIVED;
 143:../src/command.c ****         v_Post_Camera_Event( &event );
 144:../src/command.c ****         break;
 145:../src/command.c **** 
 146:../src/command.c ****     case REG_READ_SYS_CMD:
 147:../src/command.c ****         u8_Reg_ID = *p_u8_Data;
 148:../src/command.c ****         u8_Register_Error_Code = Read_Register( u8_Reg_ID, &u32_Test_Val );
 149:../src/command.c ****         v_Set_Error_Code( u8_Register_Error_Code, p_Response_Buffer );
 150:../src/command.c ****         v_Add_Response_Data( &u32_Test_Val, sizeof(&u32_Test_Val), p_Response_Buffer );
