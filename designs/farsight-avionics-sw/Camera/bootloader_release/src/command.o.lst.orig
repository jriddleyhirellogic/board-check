 172:../src/command.c ****         Sys_Time_t current_time;
 173:../src/command.c ****         v_Get_PPS_Time( &current_time );
 174:../src/command.c ****         v_Add_Response_Data( &current_time.u32_Time_Sec, sizeof(uint32_t), p_Response_Buffer );
 175:../src/command.c ****         v_Add_Response_Data( &current_time.u32_Time_msec, sizeof(uint32_t), p_Response_Buffer );
 176:../src/command.c ****     }
