  50:../src/command.c **** /**
  51:../src/command.c ****  * @fn uint8_t Execute_Command(Serial_Msg_Header_t*, uint8_t*, uint8_t*, uint8_t*)
  52:../src/command.c ****  * @brief Executes a TMTC command
  53:../src/command.c ****  * This executes the command and constructs a response packet to be sent through the serial port.
  54:../src/command.c ****  * The opcode is extracted from the header information and is used to signal a task through the mes
  55:../src/command.c ****  * The response packet header defaults to that of the request packet. Errors in the response packet
  56:../src/command.c ****  * indicate the correctness of the request, as some take a long time to execute.
  57:../src/command.c ****  * @param p_Header Pointer to header structure. This contains the opcode, error code and sequence n
  58:../src/command.c ****  * @param p_u8_Data  Pointer to the data portion of the received TMTC request packet
  59:../src/command.c ****  * @param p_Response_Buffer Pointer to buffer where response packet is constructed.
  60:../src/command.c ****  * @param p_u8_Response_Length Pointer to length of response packet
  61:../src/command.c ****  * @return
  62:../src/command.c ****  */
  63:../src/command.c **** uint8_t Execute_Command( Serial_Msg_Header_t *p_Header,
  64:../src/command.c ****                          uint8_t *p_u8_Data,
  65:../src/command.c ****                          uint8_t *p_Response_Buffer,
  66:../src/command.c ****                          uint8_t *p_u8_Response_Length )
  67:../src/command.c **** {
  68:../src/command.c ****     uint8_t u8_Arg;
  69:../src/command.c ****     uint32_t u32_Arg;
  70:../src/command.c ****     uint32_t u32_Arg2;
  71:../src/command.c ****     uint32_t u32_Capture_Time_Sec;
  72:../src/command.c ****     uint32_t u32_Capture_Time_nsec;
  73:../src/command.c ****     uint32_t u32_Address;
  74:../src/command.c ****     uint32_t u32_Test_Val;
  75:../src/command.c ****     uint8_t u8_Ret_Val = OK;
  76:../src/command.c ****     uint8_t u8_Register_Error_Code = NO_ERROR;
  77:../src/command.c ****     uint8_t u8_Error_Code = NO_ERROR;
  78:../src/command.c ****     LVDT_Sample_t LVDT_Sample;
  79:../src/command.c ****     int32_t i32_Projection,
  80:../src/command.c ****             i32_Displacement;
  81:../src/command.c ****     Event_t event;
  82:../src/command.c ****     Status_t Status;
  83:../src/command.c ****     uint8_t u8_Reg_ID;
  84:../src/command.c ****     uint8_t b_Mode_Switch_Legal = 0;
