 154:../src/command.c ****         u8_Reg_ID = *p_u8_Data;
 155:../src/command.c ****         memcpy(&u32_Arg, p_u8_Data+1, sizeof(u32_Arg)); // Argument may be incorrectly aligned
 156:../src/command.c ****         u8_Register_Error_Code = Write_Register( u8_Reg_ID, u32_Arg );
 157:../src/command.c ****         v_Set_Error_Code( u8_Register_Error_Code, p_Response_Buffer );
 158:../src/command.c ****         break;
 159:../src/command.c **** 
 160:../src/command.c ****     case SET_TIME_SYS_CMD:
 161:../src/command.c ****        {
 162:../src/command.c ****             Sys_Time_t utc_time;
 163:../src/command.c ****             memcpy(&utc_time.u32_Time_Sec, p_u8_Data, sizeof(uint32_t));
 164:../src/command.c ****             memcpy(&utc_time.u32_Time_msec, p_u8_Data+4, sizeof(uint32_t));
 165:../src/command.c ****             v_PPS_Load_Seconds(&utc_time);
 166:../src/command.c ****             v_PPS_Start();
 167:../src/command.c ****        }
 168:../src/command.c ****        break;
 169:../src/command.c **** 
 170:../src/command.c ****     case GET_SYSTEM_TIME:
