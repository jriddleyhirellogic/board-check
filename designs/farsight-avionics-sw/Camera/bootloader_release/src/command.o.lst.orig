 357:../src/command.c ****     // Flash erases are done by system thread since they are relatively slow operations
 358:../src/command.c ****     case FLASH_ERASE_SECTOR:
 359:../src/command.c ****         memcpy( &u32_Address, p_u8_Data, sizeof(uint32_t ));
 360:../src/command.c ****         if( u32_Address & 0xFFF )   // Sector must be multiple of 4K
 361:../src/command.c ****         {
 362:../src/command.c ****             v_Set_Error_Code(ERR_REG_INVALID_ADDR, p_Response_Buffer );
 363:../src/command.c ****         }
 364:../src/command.c ****         else
 365:../src/command.c ****         {
 366:../src/command.c ****             event.no_data.sig = DO_FLASH_SECTOR_ERASE;
 367:../src/command.c ****             event.flash_data.p_Data = (uint8_t *)0;
 368:../src/command.c ****             v_Post_System_Event( &event );
 369:../src/command.c ****         }
 370:../src/command.c ****         break;
 371:../src/command.c **** 
 372:../src/command.c ****     case FLASH_ERASE_BLOCK:
 373:../src/command.c ****         memcpy( &u32_Address, p_u8_Data, sizeof(uint32_t ));
 374:../src/command.c ****         if( u32_Address & 0x1FFF ) // block must be on 64K boundary
 375:../src/command.c ****         {
 376:../src/command.c ****             v_Set_Error_Code(ERR_REG_INVALID_ADDR, p_Response_Buffer );
 377:../src/command.c ****             break;
 378:../src/command.c ****         }
 379:../src/command.c ****         event.no_data.sig = DO_FLASH_BLOCK_ERASE;
 380:../src/command.c ****         event.flash_data.u32_Address = u32_Address;
 381:../src/command.c ****         event.flash_data.p_Data = (uint8_t *)0;
 382:../src/command.c ****         v_Post_System_Event( &event );
 383:../src/command.c ****         break;
 384:../src/command.c **** 
 385:../src/command.c ****     case WRITE_FLASH_PAGE:
 386:../src/command.c ****         memcpy( &u32_Address, p_u8_Data, sizeof(uint32_t ));
 387:../src/command.c ****         if( u32_Address & 0x7F )
 388:../src/command.c ****         {
 389:../src/command.c ****             v_Set_Error_Code(ERR_REG_INVALID_ADDR, p_Response_Buffer );
 390:../src/command.c ****             break;
 391:../src/command.c ****         }
 392:../src/command.c ****         u8_Flash_Page_Program( u32_Address, p_u8_Data + 4, 128 );
 393:../src/command.c ****         break;
 394:../src/command.c **** 
 395:../src/command.c ****     case READ_FLASH:
 396:../src/command.c ****         memcpy( &u32_Address, p_u8_Data, sizeof(uint32_t ));
 397:../src/command.c ****         u8_Flash_Read(u32_Address, 128, p_Response_Buffer + u8_Response_Length );
 398:../src/command.c ****         u8_Response_Length += 128;
 399:../src/command.c ****         break;
 400:../src/command.c **** 
 401:../src/command.c ****     case RESET_FLASH :    // Resets the counters and status regs in the flash
 402:../src/command.c ****         v_Flash_Reset();
 403:../src/command.c ****         break;
 404:../src/command.c **** 
 405:../src/command.c ****     case GET_CAMERA_TEMP:
 406:../src/command.c ****         Get_Camera_State( &u8_Current_Camera_State );
 407:../src/command.c ****         if( u8_Current_Camera_State == CAMERA_LP_STATE )
 408:../src/command.c ****         {
 409:../src/command.c ****             uint32_t  u32_Camera_Temp = 0xFF;
 410:../src/command.c ****             v_Add_Response_Data( &u32_Camera_Temp, sizeof( u32_Camera_Temp ), p_Response_Buffer );
 411:../src/command.c ****         }
 412:../src/command.c ****         else
 413:../src/command.c ****         {
 414:../src/command.c ****             uint32_t  u32_Camera_Temp = (uint32_t)read_cam_temp();
 415:../src/command.c ****             v_Add_Response_Data( &u32_Camera_Temp, sizeof( u32_Camera_Temp ), p_Response_Buffer );
 416:../src/command.c ****         }
 417:../src/command.c ****         break;
 418:../src/command.c **** 
 419:../src/command.c ****     case GET_FPGA_TEMP:
 420:../src/command.c ****     {
 421:../src/command.c ****         uint32_t u32_Fpga_Temp = read_fpga_temp();
 422:../src/command.c ****         v_Add_Response_Data( &u32_Fpga_Temp, sizeof( u32_Fpga_Temp ), p_Response_Buffer );
 423:../src/command.c ****     }
 424:../src/command.c ****     break;
 425:../src/command.c **** 
 426:../src/command.c ****     case GET_CAMERA_STATE:
 427:../src/command.c ****     {
 428:../src/command.c ****         uint32_t u32_Response;
 429:../src/command.c ****         u32_Response = (uint32_t)u8_Current_Camera_State;
 430:../src/command.c ****         v_Add_Response_Data( &u32_Response, sizeof( u32_Response ), p_Response_Buffer );
 431:../src/command.c ****     }
 432:../src/command.c ****     break;
 433:../src/command.c **** 
 434:../src/command.c ****     case GET_PPS_ERRORS:
 435:../src/command.c ****     {
 436:../src/command.c ****         uint32_t u32_Freq_Error = u32_Get_PPS_Freq_Error();
 437:../src/command.c ****         uint32_t u32_Phase_Error = u32_Get_PPS_Phase_Error();
 438:../src/command.c ****         v_Add_Response_Data( &u32_Freq_Error, sizeof(uint32_t), p_Response_Buffer );
 439:../src/command.c ****         v_Add_Response_Data( &u32_Phase_Error, sizeof(uint32_t), p_Response_Buffer );
 440:../src/command.c ****     }
 441:../src/command.c ****     break;
 442:../src/command.c **** 
 443:../src/command.c ****     case GET_ALL_TLM:
 444:../src/command.c ****         v_Get_Copy_TLM_Data( p_Response_Buffer + u8_Response_Length );
 445:../src/command.c ****         u8_Response_Length += 96;
 446:../src/command.c ****         break;
 447:../src/command.c **** 
 448:../src/command.c **** 
 449:../src/command.c ****     case SET_VREF_FUNCTION:
 450:../src/command.c ****     case SET_CONTROL_OUTPUTS_FUNCTION:
 451:../src/command.c ****     default: // well formed but not recognized
 452:../src/command.c ****         v_Set_Error_Code( ERR_CMD_INVALID_OPCODE, p_Response_Buffer );
 453:../src/command.c ****         break;
 454:../src/command.c ****     }
 455:../src/command.c **** 
 456:../src/command.c ****     v_Finalize_Msg( p_Response_Buffer, p_u8_Response_Length );
 457:../src/command.c ****     return u8_Ret_Val;
