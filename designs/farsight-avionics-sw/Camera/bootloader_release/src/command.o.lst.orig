 463:../src/command.c **** /**
 464:../src/command.c ****  * @fn void v_Init_Response(Serial_Msg_Header_t*, uint8_t*)
 465:../src/command.c ****  * @brief Initializes the response to a TMTC packet
 466:../src/command.c ****  * The sync code is prepended and the header information is copied from the request as a default. F
 467:../src/command.c ****  * the response length in the header is initialized - this may increase as data is added.
 468:../src/command.c ****  *
 469:../src/command.c ****  * @param p_Header Pointer to header information
 470:../src/command.c ****  * @param p_Response_Buffer Pointer to data buffer to be used for the response.
 471:../src/command.c ****  */
 472:../src/command.c **** static void v_Init_Response( Serial_Msg_Header_t *p_Header, uint8_t *p_Response_Buffer )
 473:../src/command.c **** {
 474:../src/command.c ****     u8_Response_Length = 0;
 475:../src/command.c ****     // Sync field
 476:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = SYNC1_CODE;
 477:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = SYNC2_CODE;
 478:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = SYNC3_CODE;
 479:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = SYNC4_CODE;
 480:../src/command.c **** 
 481:../src/command.c ****     // Header
 482:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = p_Header->u8_Opcode;
 483:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = p_Header->u8_Error_Code;
 484:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = p_Header->u8_Sequence;
 485:../src/command.c ****     p_Response_Buffer[u8_Response_Length++] = 0;              // Data length before anything is add
 486:../src/command.c **** 
 487:../src/command.c ****     memset( p_Response_Buffer + u8_Response_Length, 0, RESERVED_SIZE );  // Rserved field
 488:../src/command.c ****     u8_Response_Length += RESERVED_SIZE;
 489:../src/command.c **** 
 490:../src/command.c ****     // Note that data portion has quad alignment, response buffer is align(4)
 491:../src/command.c **** }
 492:../src/command.c **** 
 493:../src/command.c **** // These functions are for overriding the defaults set by v_Init_Response()
 494:../src/command.c **** // based on the received packet. They must be called before v_Finalize_Msg()
