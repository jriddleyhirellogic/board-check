 145:../src/flash.c **** uint8_t u8_Flash_Page_Program( uint32_t u32_Page_Address, void *buffer, uint16_t u16_Count ) // Use
 146:../src/flash.c **** {
 147:../src/flash.c ****     uint8_t command_buf[256] __attribute__ ((aligned (4))) = {0}; // @todo check necessary buffer s
 148:../src/flash.c **** 
 149:../src/flash.c ****      uint8_t flag_status_reg;
 150:../src/flash.c **** 
 151:../src/flash.c ****     /*execute Write enable command again for writing the data*/
 152:../src/flash.c ****     command_buf[0] = FLASH_WREN;
 153:../src/flash.c ****     SPI_transfer_block( &flash_spi, command_buf, 1, buffer, 0 );
 154:../src/flash.c **** 
 155:../src/flash.c ****     v_Wait_For_Write_Enable();
 156:../src/flash.c ****     v_Wait_For_Not_Busy();
 157:../src/flash.c **** 
 158:../src/flash.c ****     /*This command works for all modes. No Dummy cycles*/
 159:../src/flash.c ****     /*now program the sector. This will set the desired bits to 0.*/
 160:../src/flash.c **** 
 161:../src/flash.c ****     command_buf[0] = FLASH_PP;
 162:../src/flash.c ****     command_buf[1] = (u32_Page_Address >> 16) & 0xFFu;
 163:../src/flash.c ****     command_buf[2] = (u32_Page_Address >> 8) & 0xFFu;
 164:../src/flash.c ****     command_buf[3] = u32_Page_Address & 0xFFu;
 165:../src/flash.c **** 
 166:../src/flash.c ****     // Copy transmit data into same buffer as command
 167:../src/flash.c ****     memcpy( command_buf + 4, buffer, u16_Count);
 168:../src/flash.c **** 
 169:../src/flash.c ****     SPI_transfer_block( &flash_spi, command_buf, u16_Count+4, (void *)0, 0 );
 170:../src/flash.c **** 
 171:../src/flash.c ****     v_Wait_For_Not_Busy();
 172:../src/flash.c **** 
 173:../src/flash.c ****     return flag_status_reg;
 174:../src/flash.c **** }
