  10:../src/hal/hal_stepper.c **** 
  11:../src/hal/hal_stepper.c **** /** Stepper calculations:
  12:../src/hal/hal_stepper.c ****  *
  13:../src/hal/hal_stepper.c ****  * lead screw displacement [microns/step pulse] = lead screw pitch/(fraction of input rev/pulse * m
  14:../src/hal/hal_stepper.c ****  *                                              =  500.0 [microns] / ( 20 * MS * 256)
  15:../src/hal/hal_stepper.c ****  *                                              = 97.65625e-3/MS where MS = microstep ratio
  16:../src/hal/hal_stepper.c ****  *
  17:../src/hal/hal_stepper.c ****  *  step pulse base frequency = f_clk/counter overflow
  18:../src/hal/hal_stepper.c ****  *                            = 50.0e6 / 190735
  19:../src/hal/hal_stepper.c ****  *                            = 262.1438 [steps/sec]
  20:../src/hal/hal_stepper.c ****  *
  21:../src/hal/hal_stepper.c ****  *  pulse frequency = counter increment * base frequency
  22:../src/hal/hal_stepper.c ****  *
  23:../src/hal/hal_stepper.c ****  * For f_clk = 50 MHz, the base rates of travel [microns/sec], to be multiplied by counter incremen
  24:../src/hal/hal_stepper.c ****  *
  25:../src/hal/hal_stepper.c ****  * MS = 1  => 2.56e1  [microns/sec]
  26:../src/hal/hal_stepper.c ****  * MS = 2  => 1.28e1  [microns/sec]
  27:../src/hal/hal_stepper.c ****  * MS = 4  => 6.4e0   [microns/sec]
  28:../src/hal/hal_stepper.c ****  * MS = 8  => 3.2e0   [microns/sec]
  29:../src/hal/hal_stepper.c ****  * MS = 16 => 1.6e0   [microns/sec]
  30:../src/hal/hal_stepper.c ****  * MS = 32 => 8.0e-1  [microns/sec]
  31:../src/hal/hal_stepper.c ****  * MS = 128 => 2.0e-1 [microns/sec]
  32:../src/hal/hal_stepper.c ****  * MS = 256 => 1.0e-1 [microns/sec]
  33:../src/hal/hal_stepper.c ****  *
  34:../src/hal/hal_stepper.c ****  *
  35:../src/hal/hal_stepper.c ****  */
  36:../src/hal/hal_stepper.c **** static Stepper_Instance_t *p_instance;
