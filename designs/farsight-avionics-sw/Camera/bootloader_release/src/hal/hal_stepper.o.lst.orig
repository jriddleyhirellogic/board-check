  90:../src/hal/hal_stepper.c **** 
  91:../src/hal/hal_stepper.c ****     switch( e_Mode )
  92:../src/hal/hal_stepper.c ****     {                                        // M0      M1
  93:../src/hal/hal_stepper.c ****     case FULL_STEP_FULL_CURRENT:             // 0       0
