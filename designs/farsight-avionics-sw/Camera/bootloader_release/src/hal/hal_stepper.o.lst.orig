  99:../src/hal/hal_stepper.c **** 
 100:../src/hal/hal_stepper.c ****     case STEP_2:                             // HiZ     0
 101:../src/hal/hal_stepper.c ****         // M0 value becomes don't care
 102:../src/hal/hal_stepper.c ****         u8_HiZ_Set = M0_MASK;
