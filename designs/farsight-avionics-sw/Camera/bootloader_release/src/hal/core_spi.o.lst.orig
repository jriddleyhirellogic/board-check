 267:../src/hal/core_spi.c **** 
 268:../src/hal/core_spi.c ****     if( NULL_INSTANCE != this_spi )
 269:../src/hal/core_spi.c ****     {
 270:../src/hal/core_spi.c ****         /* This function is only intended to be used with an SPI master. */
 271:../src/hal/core_spi.c ****         if( DISABLE != HAL_get_8bit_reg_field(this_spi->base_addr, CTRL1_MASTER ) )
 272:../src/hal/core_spi.c ****         {
