  75:../src/hal/core_spi.c ****     {
  76:../src/hal/core_spi.c ****         /*
  77:../src/hal/core_spi.c ****          * Initialize all transmit / receive buffers and handlers
  78:../src/hal/core_spi.c ****          *
  79:../src/hal/core_spi.c ****          * Relies on the fact that byte filling with 0x00 will equate
  80:../src/hal/core_spi.c ****          * to 0 for any non byte sized items too.
  81:../src/hal/core_spi.c ****          */
  82:../src/hal/core_spi.c **** 
  83:../src/hal/core_spi.c ****         /* First fill struct with 0s */
  84:../src/hal/core_spi.c ****         memset( this_spi, 0, sizeof(spi_instance_t) );
  85:../src/hal/core_spi.c **** 
  86:../src/hal/core_spi.c ****         /* Configure CoreSPI instance attributes */
  87:../src/hal/core_spi.c ****         this_spi->base_addr = (addr_t)base_addr;
  88:../src/hal/core_spi.c **** 
  89:../src/hal/core_spi.c ****         /* Store FIFO depth or fall back to minimum if out of range */
  90:../src/hal/core_spi.c ****         if( ( SPI_MAX_FIFO_DEPTH  >= fifo_depth ) && ( SPI_MIN_FIFO_DEPTH  <= fifo_depth ) )
  91:../src/hal/core_spi.c ****         {
  92:../src/hal/core_spi.c ****             this_spi->fifo_depth = fifo_depth;
  93:../src/hal/core_spi.c ****         }
  94:../src/hal/core_spi.c ****         else
  95:../src/hal/core_spi.c ****         {
  96:../src/hal/core_spi.c ****             this_spi->fifo_depth = SPI_MIN_FIFO_DEPTH;
  97:../src/hal/core_spi.c ****         }
  98:../src/hal/core_spi.c ****         /* Make sure the CoreSPI is disabled while we configure it */
  99:../src/hal/core_spi.c ****         HAL_set_8bit_reg_field( this_spi->base_addr, CTRL1_ENABLE, DISABLE );
 100:../src/hal/core_spi.c **** 
 101:../src/hal/core_spi.c ****         /* Ensure all slaves are deselected */
 102:../src/hal/core_spi.c ****         HAL_set_8bit_reg( this_spi->base_addr, SSEL, 0u );
 103:../src/hal/core_spi.c **** 
 104:../src/hal/core_spi.c ****         /* Flush the receive and transmit FIFOs*/
 105:../src/hal/core_spi.c ****         HAL_set_8bit_reg( this_spi->base_addr, CMD, CMD_TXFIFORST_MASK | CMD_RXFIFORST_MASK );
 106:../src/hal/core_spi.c **** 
 107:../src/hal/core_spi.c ****         /* Clear all interrupts */
 108:../src/hal/core_spi.c ****         HAL_set_8bit_reg( this_spi->base_addr, INTCLR, SPI_ALL_INTS );
 109:../src/hal/core_spi.c **** 
 110:../src/hal/core_spi.c ****         /* Ensure RXAVAIL, TXRFM, SSEND and CMDINT are disabled */
 111:../src/hal/core_spi.c ****         HAL_set_8bit_reg( this_spi->base_addr, CTRL2, 0u );
 112:../src/hal/core_spi.c ****         /*
 113:../src/hal/core_spi.c ****          * Enable the CoreSPI in the reset default of master mode
 114:../src/hal/core_spi.c ****          * with TXUNDERRUN, RXOVFLOW and TXDONE interrupts disabled.
 115:../src/hal/core_spi.c ****          * The driver does not currently use interrupts in master mode.
 116:../src/hal/core_spi.c ****          */
 117:../src/hal/core_spi.c ****         HAL_set_8bit_reg( this_spi->base_addr, CTRL1,  ENABLE | CTRL1_MASTER_MASK );
 118:../src/hal/core_spi.c ****     }
