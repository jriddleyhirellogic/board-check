 125:../src/hal/serial_comm.c **** /**
 126:../src/hal/serial_comm.c ****  * @fn void v_UART16550_Handler(void)
 127:../src/hal/serial_comm.c ****  * @brief Interrupt handler for the 16550 type uart.
 128:../src/hal/serial_comm.c ****  * This handles both receive and transmit interrupts. A timer with a timeout of
 129:../src/hal/serial_comm.c ****  * 3 characters is reloaded every time a character is received. Each receive character
 130:../src/hal/serial_comm.c ****  * updates a state machine which parses the packet, extracting the header and data and
 131:../src/hal/serial_comm.c ****  * updating a crc check. When the time expires, the serial_comm thread is notified.
 132:../src/hal/serial_comm.c ****  * Note that ill formed messages and garbage data do not result in the notification.
 133:../src/hal/serial_comm.c ****  */
 134:../src/hal/serial_comm.c **** void v_UART16550_Handler(void)
 135:../src/hal/serial_comm.c **** {
 136:../src/hal/serial_comm.c ****     uint8_t u8_Line_Status = u8_Get_Line_Status( p_serial_comm_instance );
 137:../src/hal/serial_comm.c ****     uint8_t b_Rx_Data_Present = (u8_Line_Status & LINE_STATUS_DR) != 0;
 138:../src/hal/serial_comm.c ****     uint8_t b_Tx_Holding_Reg_Empty = (u8_Line_Status & LINE_STATUS_THRE) != 0;
 139:../src/hal/serial_comm.c ****     uint8_t u8_IRQ_Cause = u8_Get_Interrupt_Cause( p_serial_comm_instance );
 140:../src/hal/serial_comm.c **** 
 141:../src/hal/serial_comm.c **** 
 142:../src/hal/serial_comm.c ****     if( (u8_IRQ_Cause & IRQ_ID_RX_DATA_AVAIL ) != 0 && b_Rx_Data_Present )
 143:../src/hal/serial_comm.c ****     {
 144:../src/hal/serial_comm.c ****         uint8_t u8_Data = u8_Get_UART_Rx_Data( p_serial_comm_instance );
 145:../src/hal/serial_comm.c ****         v_Update_Serial_SM(u8_Data);
 146:../src/hal/serial_comm.c **** 
 147:../src/hal/serial_comm.c ****         // The reload value corresponds to 3 character times at 115200 bits/sec
 148:../src/hal/serial_comm.c ****         Reload_Comm_Timer( 13020 );
 149:../src/hal/serial_comm.c ****         ++u8_Rx_Count;
 150:../src/hal/serial_comm.c ****     }
 151:../src/hal/serial_comm.c **** 
 152:../src/hal/serial_comm.c ****     // Transmit
 153:../src/hal/serial_comm.c ****     if( (u8_IRQ_Cause & IRQ_TX_HOLD_REG_EMPTY ) != 0 )
 154:../src/hal/serial_comm.c ****     {
 155:../src/hal/serial_comm.c ****         if( u8_Tx_Count_Remaining != 0 )
 156:../src/hal/serial_comm.c ****         {
 157:../src/hal/serial_comm.c ****             v_Write_UART_Tx_Data( p_serial_comm_instance, *p_Tx_Ptr++ );
 158:../src/hal/serial_comm.c ****             --u8_Tx_Count_Remaining;
 159:../src/hal/serial_comm.c ****         }
 160:../src/hal/serial_comm.c ****         else
 161:../src/hal/serial_comm.c ****         {
 162:../src/hal/serial_comm.c ****             v_Disable_UART_IRQ( p_serial_comm_instance, UART_ETBEI );
 163:../src/hal/serial_comm.c ****         }
 164:../src/hal/serial_comm.c ****     }
 165:../src/hal/serial_comm.c **** 
 166:../src/hal/serial_comm.c **** }
