  38:../src/hal/serial_comm.c **** /**
  39:../src/hal/serial_comm.c ****  * @fn void v_Serial_Comm_Task(void*)
  40:../src/hal/serial_comm.c ****  * @brief Thread to manage serial communcations
  41:../src/hal/serial_comm.c ****  * Serial messages are parse and crc-checked in the serial interrupt. When a well formed
  42:../src/hal/serial_comm.c ****  * message arrives, an event is sent to the queue in the this thread. Where (optionally) a
  43:../src/hal/serial_comm.c ****  * command is executed and a response sent.
  44:../src/hal/serial_comm.c ****  *
  45:../src/hal/serial_comm.c ****  * @param pvParameters Optional param that can be passed into task when it is launched.
  46:../src/hal/serial_comm.c ****  */
  47:../src/hal/serial_comm.c **** void v_Serial_Comm_Task(void *pvParameters)
  48:../src/hal/serial_comm.c **** {
  49:../src/hal/serial_comm.c ****     Serial_Comm_Queue = xQueueCreate( SERIAL_COMM_QUEUE_LENGTH,
  50:../src/hal/serial_comm.c ****                                   sizeof(Event_t) );
  51:../src/hal/serial_comm.c **** 
  52:../src/hal/serial_comm.c ****     Reset_Serial_SM();
  53:../src/hal/serial_comm.c **** 
  54:../src/hal/serial_comm.c ****     xEventGroupSetBits( initialized,  SERIAL_COMM_INITIALIZED );
  55:../src/hal/serial_comm.c ****     xEventGroupWaitBits( initialized, ALL_INITIALIZED, pdFALSE, pdTRUE, portMAX_DELAY );
  56:../src/hal/serial_comm.c **** 
  57:../src/hal/serial_comm.c ****     v_Enable_Serial_Comm();
  58:../src/hal/serial_comm.c **** 
  59:../src/hal/serial_comm.c ****     while(1)
  60:../src/hal/serial_comm.c ****     {
  61:../src/hal/serial_comm.c ****         BaseType_t b_Data_Present;
  62:../src/hal/serial_comm.c ****         Event_t Rcvd_Event;
  63:../src/hal/serial_comm.c ****          b_Data_Present = xQueueReceive(
  64:../src/hal/serial_comm.c ****                                         Serial_Comm_Queue,
  65:../src/hal/serial_comm.c ****                                         &Rcvd_Event,
  66:../src/hal/serial_comm.c ****                                         portMAX_DELAY );
  67:../src/hal/serial_comm.c **** 
  68:../src/hal/serial_comm.c ****          if( b_Data_Present ) // Event received
  69:../src/hal/serial_comm.c ****          {
  70:../src/hal/serial_comm.c ****              uint8_t u8_Response_Length = 0;
  71:../src/hal/serial_comm.c ****              uint8_t u8_Retval;
  72:../src/hal/serial_comm.c **** 
  73:../src/hal/serial_comm.c ****              // Parse the received packet
  74:../src/hal/serial_comm.c ****              u8_Retval = Execute_Command( &Rcvd_Event.serial_msg.header,
  75:../src/hal/serial_comm.c ****                                           Rcvd_Event.serial_msg.Data,
  76:../src/hal/serial_comm.c ****                                           u8_Response,
  77:../src/hal/serial_comm.c ****                                           &u8_Response_Length );
  78:../src/hal/serial_comm.c **** 
  79:../src/hal/serial_comm.c ****              if( !u8_Retval )
  80:../src/hal/serial_comm.c ****                  v_Send_Serial_Comm( u8_Response, u8_Response_Length );
  81:../src/hal/serial_comm.c **** 
  82:../src/hal/serial_comm.c ****              ++u8_Msgs_Received;
  83:../src/hal/serial_comm.c ****          }
  84:../src/hal/serial_comm.c ****          else // timeout or something wrong
  85:../src/hal/serial_comm.c ****          {
  86:../src/hal/serial_comm.c **** 
  87:../src/hal/serial_comm.c ****          }
  88:../src/hal/serial_comm.c **** #ifdef  MEM_CHECK
  89:../src/hal/serial_comm.c ****         UBaseType_t uxHighWaterMark = uxTaskGetStackHighWaterMark(NULL); // Stack high water mark -
  90:../src/hal/serial_comm.c **** #endif
  91:../src/hal/serial_comm.c **** 
  92:../src/hal/serial_comm.c ****     }
  93:../src/hal/serial_comm.c **** }
