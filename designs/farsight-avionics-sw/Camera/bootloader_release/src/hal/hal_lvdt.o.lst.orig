  27:../src/hal/hal_lvdt.c **** /**
  28:../src/hal/hal_lvdt.c ****  * @fn void v_Init_LVDT(void)
  29:../src/hal/hal_lvdt.c ****  * @brief  Initializes lvdt (position) sensor hardware.
  30:../src/hal/hal_lvdt.c ****  * This initializes the hardware used to read the LVDT sensor: the voltage on both the primary
  31:../src/hal/hal_lvdt.c ****  * and secondary coils are complex valued (I and Q), plus a GPIO register used to set the gain to
  32:../src/hal/hal_lvdt.c ****  * either 1 or 8.
  33:../src/hal/hal_lvdt.c ****  * Two calibration tables are initialized. One is for use when the LVDT gain setting is 1, the othe
  34:../src/hal/hal_lvdt.c ****  * for when it is 8.
  35:../src/hal/hal_lvdt.c ****  *
  36:../src/hal/hal_lvdt.c ****  */
