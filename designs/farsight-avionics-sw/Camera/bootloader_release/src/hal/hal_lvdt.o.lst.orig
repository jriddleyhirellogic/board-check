 121:../src/hal/hal_lvdt.c **** /**
 122:../src/hal/hal_lvdt.c ****  * @fn int32_t i32_Get_Projection(LVDT_Sample_t*)
 123:../src/hal/hal_lvdt.c ****  * @brief Calculates the projection of the secondary response onto the primary excitation
 124:../src/hal/hal_lvdt.c ****  * If the primary and secondary complex valued voltages are represented as vectors, this is
 125:../src/hal/hal_lvdt.c ****  * the projection of the secondary onto the primary, normalized by the amplitude of the primary.
 126:../src/hal/hal_lvdt.c ****  * This can be seen as a complex valued loss between the primary and secondary. Mathematically, thi
 127:../src/hal/hal_lvdt.c ****  * is:
 128:../src/hal/hal_lvdt.c ****  * Projection = (S dot P)/ norm(P)^2
 129:../src/hal/hal_lvdt.c ****  * where P = primary (I,Q) pair
 130:../src/hal/hal_lvdt.c ****  *       S = secondary (I,Q) pair
 131:../src/hal/hal_lvdt.c ****  *       dot - vector dot product
 132:../src/hal/hal_lvdt.c ****  *       norm - vector norm (length)
 133:../src/hal/hal_lvdt.c ****  *
 134:../src/hal/hal_lvdt.c ****  * @param p_LVDT_Sample The (I,Q) values for both the primary and the secondary coils of the LVDT
 135:../src/hal/hal_lvdt.c ****  * @return  The normalized projection of the secondary response onto the primary excitation
 136:../src/hal/hal_lvdt.c ****  */
 137:../src/hal/hal_lvdt.c **** int32_t i32_Get_Projection( LVDT_Sample_t *p_LVDT_Sample )
 138:../src/hal/hal_lvdt.c **** {
 225              		.loc 1 138 1 is_stmt 1
 226              		.cfi_startproc
 227              	.LVL13:
 139:../src/hal/hal_lvdt.c ****     // This calculates the projection of the secondary response onto the primary viewing them as 2D
 140:../src/hal/hal_lvdt.c ****     // formed by (I,Q)
 141:../src/hal/hal_lvdt.c ****     // The projection is scaled to increase precision.
 142:../src/hal/hal_lvdt.c **** 
