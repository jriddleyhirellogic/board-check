  56:../src/hal/hal_pwm.c **** /*
  57:../src/hal/hal_pwm.c ****  * The relationship between the data duty cycle and the current setpoint is:
  58:../src/hal/hal_pwm.c ****  * I_FS = (V_Ref / K_V) * DC (%)
  59:../src/hal/hal_pwm.c ****  *
  60:../src/hal/hal_pwm.c ****  *      => DC(%) = (I_FS(mA) * 1.32) / 3200 (mV)
  61:../src/hal/hal_pwm.c ****  */
  62:../src/hal/hal_pwm.c **** 
  63:../src/hal/hal_pwm.c **** /**
  64:../src/hal/hal_pwm.c ****  * @fn void PWM_Set_Voltage_mV(PWM_Instance_t*, uint16_t)
  65:../src/hal/hal_pwm.c ****  * @brief Converts a desired voltage into an equivalent duty cycle.
  66:../src/hal/hal_pwm.c ****  * This is assuming VRef = 3200 mV.
  67:../src/hal/hal_pwm.c ****  * @param instance PWM instance in use.
  68:../src/hal/hal_pwm.c ****  * @param u16_V_Set_mV Desired output voltage.
  69:../src/hal/hal_pwm.c ****  */
  70:../src/hal/hal_pwm.c **** void PWM_Set_Voltage_mV( PWM_Instance_t *instance, uint16_t u16_V_Set_mV )
