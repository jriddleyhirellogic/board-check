  74:../src/hal/hal_pwm.c ****     /** PWM Count = (set_v_mv / vref_mv) * max_count
  75:../src/hal/hal_pwm.c ****                   = (max_count / vref_mv) * set_v_mv
  76:../src/hal/hal_pwm.c ****                */
  77:../src/hal/hal_pwm.c ****     u32_Temp = COUNT_PER_MV * (uint32_t)u16_V_Set_mV;
