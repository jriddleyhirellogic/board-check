  52:../src/crc32.c **** /**
  53:../src/crc32.c ****  * @fn uint32_t crc(const uint8_t[], uint16_t, uint32_t)
  54:../src/crc32.c ****  * @brief Updates the CRC-32 calculation using lookup table
  55:../src/crc32.c ****  * This updates the crc calculation using the polynomial 0x04C11DB7 with
  56:../src/crc32.c ****  * no initial or final complement and no reversals. The initial value is passed in
  57:../src/crc32.c ****  * to allow this function to be called iteratively.
  58:../src/crc32.c ****  * @param u8_Msg  Message bytes.
  59:../src/crc32.c ****  * @param u16_Len Number of message bytes
  60:../src/crc32.c ****  * @param u32_Rem Initial value of crc remainder
  61:../src/crc32.c ****  * @return
  62:../src/crc32.c ****  */
  63:../src/crc32.c **** #ifndef CRC_SLOW
  64:../src/crc32.c **** uint32_t crc(uint8_t const u8_Msg[], uint16_t u16_Len, uint32_t  u32_Rem)
  65:../src/crc32.c **** {
  66:../src/crc32.c ****     uint8_t   u8_Data;
  67:../src/crc32.c ****     uint16_t  u16_n;
  68:../src/crc32.c **** 
  69:../src/crc32.c ****     for (u16_n = 0; u16_n < u16_Len; ++u16_n)
  70:../src/crc32.c ****     {
  71:../src/crc32.c ****         u8_Data = u8_Msg[u16_n] ^ (u32_Rem >> 24);
  72:../src/crc32.c ****         u32_Rem = crc32_table[u8_Data] ^ (u32_Rem << 8);
  73:../src/crc32.c ****     }
  74:../src/crc32.c ****     return u32_Rem;
  75:../src/crc32.c **** }
  76:../src/crc32.c **** #else // This is the bit serial, slower version of the crc. May be sufficient.
  77:../src/crc32.c **** uint32_t crc(uint8_t const u8_Msg[], uint32_t u32_Len, uint32_t u32_Rem)
  78:../src/crc32.c **** {
