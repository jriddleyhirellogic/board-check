  41:../src/focus.c **** {
  42:../src/focus.c ****     uint8_t u8_Timer_ID;
  43:../src/focus.c ****     TickType_t Control_Update_Period = pdMS_TO_TICKS(10);  // For periodic tasks
  44:../src/focus.c **** 
  45:../src/focus.c ****     // Queue for events directed at control thread
  46:../src/focus.c ****     Control_Queue = xQueueCreate( CONTROL_QUEUE_LENGTH , sizeof(Event_t) );
  47:../src/focus.c **** 
  48:../src/focus.c ****     // Control timer
  49:../src/focus.c ****      Focus_Timer = xTimerCreate(
  50:../src/focus.c ****                                   "Focus_Timer",
  51:../src/focus.c ****                                    100,                        // Default period (mS)
  52:../src/focus.c ****                                    pdFALSE,                    // One shot, no auto-reload
  53:../src/focus.c ****                                    &u8_Timer_ID,
  54:../src/focus.c ****                                    Focus_Timer_Expiration  );
  55:../src/focus.c **** 
  56:../src/focus.c ****      Focus_Fault_Timer = xTimerCreate(
  57:../src/focus.c ****                                   "Control_Fault",
  58:../src/focus.c ****                                    100,                        // Default period (mS)
  59:../src/focus.c ****                                    pdFALSE,                    // One shot, no auto-reload
  60:../src/focus.c ****                                    &u8_Timer_ID,
  61:../src/focus.c ****                                    Focus_Fault_Timer_Expiration  );
  62:../src/focus.c **** 
  63:../src/focus.c **** 
  64:../src/focus.c ****     // Initialization complete
  65:../src/focus.c ****     xEventGroupSetBits( initialized,  CONTROL_INITIALIZED );
  66:../src/focus.c **** 
  67:../src/focus.c ****     // Wait for all tasks to be initialized
  68:../src/focus.c ****     xEventGroupWaitBits( initialized, ALL_INITIALIZED, pdFALSE, pdTRUE, portMAX_DELAY );
  69:../src/focus.c **** 
  70:../src/focus.c ****     v_Stop_Focus_Timer();
  71:../src/focus.c **** 
  72:../src/focus.c ****     v_Init_Focus_State_Machine( &focus_context, Initial_State );
  73:../src/focus.c **** 
  74:../src/focus.c ****     while(1)
  75:../src/focus.c ****     {
  76:../src/focus.c ****         BaseType_t b_Event_Received;
  77:../src/focus.c ****         Event_t Rcvd_Event;
  78:../src/focus.c **** 
  79:../src/focus.c ****         b_Event_Received = xQueueReceive( Control_Queue,
  80:../src/focus.c ****                                           &Rcvd_Event,
  81:../src/focus.c ****                                           portMAX_DELAY );
  82:../src/focus.c **** 
  83:../src/focus.c ****          if( b_Event_Received) // Event received
  84:../src/focus.c ****          {
  85:../src/focus.c ****              v_Update_Focus_State( &focus_context, &Rcvd_Event );
  86:../src/focus.c ****          }
  87:../src/focus.c ****          else                  // Timeout for period updates
  88:../src/focus.c ****          {
  89:../src/focus.c ****              ++u32_Timeout_Counter;
  90:../src/focus.c ****          }
  91:../src/focus.c **** 
  92:../src/focus.c **** #ifdef MEM_CHECK
  93:../src/focus.c ****          // Measure remaining stack space
  94:../src/focus.c ****          UBaseType_t uxHighWaterMark = uxTaskGetStackHighWaterMark(NULL);
  95:../src/focus.c **** #endif
  96:../src/focus.c **** 
  97:../src/focus.c ****     }
  98:../src/focus.c **** }
