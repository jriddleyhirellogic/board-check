 150:../src/misc.c **** /*
 151:../src/misc.c ****  * Strong override of the weak FreeRTOS default in portASM.S (which just spins).
 152:../src/misc.c ****  * It runs from freertos_risc_v_trap_handler AFTER the full interrupt context has
 153:../src/misc.c ****  * been saved to the TCB and sp switched to xISRStackTop, so it is safe to call
 154:../src/misc.c ****  * the FreeRTOS ...FromISR() APIs here. The MSYS external vectors EI3/EI4/EI5 in
 155:../src/misc.c ****  * miv_rv32_entry.S are routed here and dispatched by mcause. Running these on the
 156:../src/misc.c ****  * dedicated ISR stack (instead of the interrupted task's stack via the old
 157:../src/misc.c ****  * irq_save_regs path) is required to avoid stack corruption / firmware crash.
 158:../src/misc.c ****  */
 159:../src/misc.c **** extern void v_Camera_Trigger_IRQ_Handler(void);
 160:../src/misc.c **** extern void v_UDP_Transfer_Handler(void);
 161:../src/misc.c **** extern void v_PPS_IRQ_Handler(void);
 162:../src/misc.c **** 
